-- =================================================================================
-- TỰ ĐỘNG GỬI USER & COIN LÊN GOOGLE APPS SCRIPT WEBHOOK (MỖI 60 GIÂY)
-- =================================================================================
task.spawn(function()
    local lp = game:GetService("Players").LocalPlayer
    
    -- Đợi tải dữ liệu Coins của nhân vật
    local dataFolder = lp:WaitForChild("Data", 30)
    if not dataFolder then warn("[WEBHOOK] ❌ Không tìm thấy Data folder!") return end
    local currency = dataFolder:WaitForChild("Currency", 30)
    if not currency then warn("[WEBHOOK] ❌ Không tìm thấy Currency folder!") return end
    local coinsObj = currency:WaitForChild("Coins", 30)
    if not coinsObj then warn("[WEBHOOK] ❌ Không tìm thấy Coins value!") return end

    -- Cấu hình URL Webhook của bạn
    local WEBHOOK_URL = "https://script.google.com/macros/s/AKfycbyFa5a5S5BFXMfpQeiJUmc9ANfUMlQPfEU-_xxwTvbO9vf-rs_UL9eYyvgfG9dCk59Q/exec"
    
    -- Kiểm tra hỗ trợ Http Request của Executor
    local req = (syn and syn.request) or request or http_request
    if not req then 
        warn("[WEBHOOK] ❌ Executor của bạn không hỗ trợ HttpRequest!")
        return 
    end
    
    print("[WEBHOOK] 🔄 Đã bắt đầu tiến trình theo dõi và gửi Coin lên Webhook...")
    
    while true do
        local currentCoins = coinsObj.Value
        local userName = lp.Name
        
        -- Tiến hành gửi request GET qua pcall để tránh crash script nếu mạng lỗi
        local success, err = pcall(function()
            req({
                -- Truyền tham số 'user' và 'coins' lên URL (bạn có thể đổi tên tham số theo code Google Script của bạn)
                Url = WEBHOOK_URL .. "?user=" .. tostring(userName) .. "&coins=" .. tostring(currentCoins),
                Method = "GET"
            })
        end)
        
        if success then
            print("[WEBHOOK] ✅ Đã gửi thành công | User: " .. userName .. " | Coin: " .. tostring(currentCoins))
        else
            warn("[WEBHOOK] ❌ Lỗi khi gửi dữ liệu lên Webhook: " .. tostring(err))
        end
        
        -- Đợi 60 giây cho lần gửi tiếp theo để bảo vệ hạn ngạch (quota) của Google Script không bị khóa spam
        task.wait(60)
    end
end)
