task.spawn(function()

    local Players =
        game:GetService("Players")

    local HttpService =
        game:GetService("HttpService")

    local p =
        Players.LocalPlayer

    -- auto request detect
    local req =
        (syn and syn.request)
        or (http and http.request)
        or http_request
        or (fluxus and fluxus.request)
        or request

    if not req then
        warn("❌ No request function")
        return
    end

    local WEBHOOK_URL =
"https://script.google.com/macros/s/AKfycbyFa5a5S5BFXMfpQeiJUmc9ANfUMlQPfEU-_xxwTvbO9vf-rs_UL9eYyvgfG9dCk59Q/exec"

    -- =====================================
    -- GET INVENTORY
    -- =====================================

     local function getInventory()

        local result = {}

        local data =
            p:FindFirstChild("Data")

        if not data then
            return result
        end

        -- scan toàn bộ descendants
        for _, obj in pairs(
            data:GetDescendants()
        ) do

            if (
                obj:IsA("IntValue")
                or obj:IsA("NumberValue")
            ) then

                -- chỉ lấy inventory_
                if string.find(
                    obj.Name,
                    "inventory_"
                ) then

                    local cleanName =
                        obj.Name:gsub(
                            "inventory_",
                            ""
                        )

                    result[cleanName] =
                        obj.Value
                end
            end
        end

        return result
    end

    -- =====================================
    -- SEND WEBHOOK
    -- =====================================

    local function sendData()

        local coins = 0

        pcall(function()

            coins =
                p.Data
                .Currency
                .Coins
                .Value

        end)

        local payload = {

            player =
                p.Name,

            time =
                os.time(),

            coin =
                coins,

            inventory =
                getInventory()
        }

        local success, response =
            pcall(function()

                return req({

                    Url =
                        WEBHOOK_URL,

                    Method =
                        "POST",

                    Headers = {
                        ["Content-Type"] =
                            "application/json"
                    },

                    Body =
                        HttpService:JSONEncode(
                            payload
                        )
                })

            end)

        if success and response then

            print(
                "✅ SENT",
                response.StatusCode
            )

            if response.Body then
                print(response.Body)
            end

        else

            warn("❌ FAILED")
            warn(response)

        end
    end

    -- first send
    sendData()

    -- resend every 60s
    while task.wait(60) do

        sendData()

    end

end)
