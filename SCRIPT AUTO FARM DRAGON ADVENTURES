-- [[ SCRIPT AUTO FARM DRAGON ADVENTURES - PHIÊN BẢN THAO TÁC THUẦN MOBILE / KHÔNG BÀN PHÍM ]] --
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Camera = workspace.Camera

-- Cài đặt cấu hình
local CLICK_INTERVAL = 0.35
local FLY_SPEED = 2.0 
local WAIT_AFTER_LOOT = 0.4
local CYCLE_TIME = 4

-- Trạng thái hệ thống
local isEnabled = false
local isFarming = false
local currentTween = nil
local currentPointIndex = 1
local lastTeleportTime = 0
local bodyVelocity = nil

-- Các thành phần UI hiển thị
local mainButton = nil
local statusLogLabel = nil

-- Tọa độ điểm cày (Khu vực Shinrin)
local TELEPORT_POINTS = {
    CFrame.new(2137, 340, -1600),
    CFrame.new(-400, 717, -4138),
    CFrame.new(-1549, 513, -915),
}

local SHOP_PORTAL_SHINRIN = CFrame.new(-372, 465, -414)
local SHOP_PORTAL_ORIGINS = CFrame.new(-136, 134, -98)
local SHOP_POSITION = CFrame.new(-24, 142, 228)
local FORBIDDEN_ZONE = Vector3.new(-737, 840, -5310)

local FRUITS = {"Edamame", "Kaji Fruit", "Mist Sudachi"}

-- ==================== HÀM IN TRẠNG THÁI RA MÀN HÌNH ====================
local function setStatus(text, isError)
    if statusLogLabel then
        statusLogLabel.Text = " Trạng thái: " .. text
        if isError then
            statusLogLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        else
            statusLogLabel.TextColor3 = Color3.fromRGB(200, 255, 200)
        end
    end
end

-- ==================== TÌM KIẾM NHÂN VẬT AN TOÀN ====================
local function getHRP()
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        return character.HumanoidRootPart
    end
    for _, model in ipairs(workspace:GetChildren()) do
        if model:IsA("Model") and model:FindFirstChild("HumanoidRootPart") then
            if model.Name == LocalPlayer.Name or model:FindFirstChild("AnimationController") then
                return model.HumanoidRootPart
            end
        end
    end
    return nil
end

-- ==================== ĐIỀU KHIỂN BAY (PHYSICS) ====================
local function enableFlight()
    local hrp = getHRP()
    if not hrp then return end
    if not bodyVelocity or bodyVelocity.Parent ~= hrp then
        if bodyVelocity then bodyVelocity:Destroy() end
        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        bodyVelocity.Parent = hrp
    end
end

local function disableFlight()
    if bodyVelocity then bodyVelocity:Destroy(); bodyVelocity = nil end
end

local function moveTo(pos, speed)
    local hrp = getHRP()
    if not hrp then return end
    enableFlight()
    if currentTween then currentTween:Cancel() end
    currentTween = TweenService:Create(hrp, TweenInfo.new(speed or FLY_SPEED, Enum.EasingStyle.QuadOut), {CFrame = pos})
    currentTween:Play()
    currentTween.Completed:Wait()
    currentTween = nil
end

-- ==================== QUẢN LÝ DỮ LIỆU CÂY CỐI ====================
local function getTrees()
    local nodesFolder = workspace:FindFirstChild("Interactions") and workspace.Interactions:FindFirstChild("Nodes") and workspace.Interactions.Nodes:FindFirstChild("Food")
    if not nodesFolder then return {} end
    
    local trees = {}
    for _, obj in ipairs(nodesFolder:GetChildren()) do
        if obj.Name == "LargeFoodNode" then
            local dead = obj:FindFirstChild("Dead", true)
            if not (dead and dead:IsA("BoolValue") and dead.Value) then
                table.insert(trees, obj)
            end
        end
    end
    return trees
end

local function isDead(tree)
    if not tree or not tree.Parent then return true end
    local dead = tree:FindFirstChild("Dead", true)
    return dead and dead:IsA("BoolValue") and dead.Value
end

-- ==================== TẤN CÔNG THÔNG MINH ====================
local function attack(treePos)
    pcall(function()
        local sp, onScreen = Camera:WorldToScreenPoint(treePos)
        if onScreen then
            VirtualInputManager:SendMouseButtonEvent(sp.X, sp.Y, 0, true, game, 1)
            task.wait(0.02)
            VirtualInputManager:SendMouseButtonEvent(sp.X, sp.Y, 0, false, game, 1)
        else
            local hrp = getHRP()
            if hrp then Camera.CFrame = CFrame.new(Camera.CFrame.Position, treePos) end
        end
    end)
    task.wait(CLICK_INTERVAL)
end

-- ==================== VÒNG LẶP FARM CÂY ====================
local function farmTree(tree)
    if not isEnabled or isDead(tree) then return end
    
    local treePos = tree:GetPivot()
    local standPosition = treePos * CFrame.new(0, 8, -12) 
    moveTo(standPosition, 1.2)
    
    setStatus("Đang thu hoạch cây ăn quả...")
    local startTime = tick()
    while isEnabled and not isDead(tree) and (tick() - startTime < CYCLE_TIME) do
        attack(treePos.Position)
    end
    
    if isDead(tree) then
        setStatus("Cây đã hết quả, nhặt vật phẩm...")
        task.wait(WAIT_AFTER_LOOT)
    end
end

-- ==================== DỊCH CHUYỂN GIỮA CÁC ĐIỂM ====================
local function teleportToNext()
    if tick() - lastTeleportTime < 2.5 then return end
    local point = TELEPORT_POINTS[currentPointIndex]
    
    if point and (point.Position - FORBIDDEN_ZONE).Magnitude > 150 then
        setStatus("Hết cây, đang bay sang khu vực mới...")
        moveTo(point, 1.8)
        lastTeleportTime = tick()
        
        currentPointIndex = currentPointIndex + 1
        if currentPointIndex > #TELEPORT_POINTS then currentPointIndex = 1 end
    end
end

-- ==================== ĐIỀU KHIỂN GIAO DIỆN (UI CLICKER) ====================
local function clickButton(text, exact)
    local found = false
    pcall(function()
        for _, gui in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
            if gui:IsA("TextButton") and gui.Visible then
                local match = exact and (gui.Text == text) or gui.Text:lower():find(text:lower())
                if match then
                    local x = gui.AbsolutePosition.X + gui.AbsoluteSize.X / 2
                    local y = gui.AbsolutePosition.Y + gui.AbsoluteSize.Y / 2
                    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
                    task.wait(0.02)
                    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
                    found = true
                    break
                end
            end
        end
    end)
    return found
end

-- ==================== HỆ THỐNG TỰ ĐỘNG BÁN ĐỒ ====================
local function goToShop()
    setStatus("Túi đầy! Đang bay tới cổng dịch chuyển...")
    moveTo(SHOP_PORTAL_SHINRIN * CFrame.new(0, 4, -6), 2)
    task.wait(0.5)
    
    setStatus("Đang bấm chuyển sang map Origins...")
    for i = 1, 5 do
        if clickButton("Origins", true) then 
            task.wait(3) 
            break 
        end
        task.wait(0.5)
    end
    
    setStatus("Đang bay tới Cửa hàng Origins...")
    moveTo(SHOP_POSITION * CFrame.new(0, 6, -6), 2)
    task.wait(0.5)
    
    setStatus("Đang mở Cửa hàng và bán trái cây...")
    for i = 1, 5 do
        if clickButton("Store") or clickButton("Shop") then
            task.wait(0.5)
            clickButton("Food", true)
            task.wait(0.3)
            
            for _, fruit in ipairs(FRUITS) do
                if clickButton(fruit, true) then
                    task.wait(0.2)
                    clickButton("Sell")
                    task.wait(0.2)
                end
            end
            setStatus("Đã bán xong! Đang quay lại...")
            break
        end
        task.wait(0.5)
    end
    
    task.wait(0.5)
    moveTo(SHOP_PORTAL_ORIGINS * CFrame.new(0, 4, -6), 2)
    task.wait(0.5)
    setStatus("Đang bấm quay về map cũ (Shinrin)...")
    for i = 1, 5 do
        if clickButton("Shinrin", true) then
            task.wait(3)
            break
        end
        task.wait(0.5)
    end
end

-- ==================== CHƯƠNG TRÌNH CHÍNH ====================
local function startFarm()
    if isFarming then return end
    isFarming = true
    
    local loopCounter = 0
    while isEnabled do
        if not getHRP() then 
            setStatus("Lỗi: Không tìm thấy nhân vật/rồng!", true)
            task.wait(1)
            continue 
        end
        
        local trees = getTrees()
        if #trees == 0 then
            setStatus("Đang tìm kiếm cây ăn quả...")
            task.wait(1)
            if isEnabled and #getTrees() == 0 then 
                teleportToNext() 
            end
        else
            setStatus("Tìm thấy " .. #trees .. " cây. Bắt đầu farm...")
            for _, tree in ipairs(trees) do
                if not isEnabled then break end
                farmTree(tree)
                
                loopCounter = loopCounter + 1
                if loopCounter >= 8 then
                    loopCounter = 0
                    goToShop()
                end
            end
        end
        task.wait(0.5)
    end
    
    disableFlight()
    isFarming = false
end

-- ==================== LOGIC BẬT TẮT CHUNG ====================
local function toggleFarm()
    isEnabled = not isEnabled
    if isEnabled then
        if not getHRP() then
            setStatus("Không tìm thấy Rồng hoặc Nhân vật để bật farm!", true)
            isEnabled = false
            if mainButton then mainButton.BackgroundColor3 = Color3.fromRGB(235, 60, 60) mainButton.Text = "START FARM" end
            return
        end
        if mainButton then
            mainButton.BackgroundColor3 = Color3.fromRGB(60, 220, 110)
            mainButton.Text = "STOP FARM"
        end
        task.spawn(startFarm)
    else
        if currentTween then currentTween:Cancel(); currentTween = nil end
        disableFlight()
        if mainButton then
            mainButton.BackgroundColor3 = Color3.fromRGB(235, 60, 60)
            mainButton.Text = "START FARM"
        end
        setStatus("Đã tắt hệ thống Auto Farm.")
    end
end

-- ==================== KHỞI TẠO UI THAO TÁC TRÊN MÀN HÌNH ====================
local function createMobileUI()
    local oldGui = LocalPlayer.PlayerGui:FindFirstChild("MobileFarmGui")
    if oldGui then oldGui:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "MobileFarmGui"
    gui.ResetOnSpawn = false
    gui.Parent = LocalPlayer.PlayerGui

    -- Khung nền chứa bảng điều khiển
    local mainFrame = Instance.new("Frame")
    mainFrame.Size = UDim2.new(0, 220, 0, 95)
    mainFrame.Position = UDim2.new(0.05, 0, 0.15, 0) -- Nằm bên góc trái màn hình để không vướng nút điều khiển của game
    mainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    mainFrame.BackgroundTransparency = 0.2
    mainFrame.BorderSizePixel = 0
    mainFrame.Parent = gui

    local cornerFrame = Instance.new("UICorner")
    cornerFrame.CornerRadius = UDim.new(0, 10)
    cornerFrame.Parent = mainFrame

    -- Viền bảng điều khiển
    local strokeFrame = Instance.new("UIStroke")
    strokeFrame.Color = Color3.fromRGB(255, 255, 255)
    strokeFrame.Thickness = 1
    strokeFrame.Transparency = 0.6
    strokeFrame.Parent = mainFrame

    -- Nút Bật/Tắt (Touch để thao tác)
    mainButton = Instance.new("TextButton")
    mainButton.Size = UDim2.new(1, -20, 0, 40)
    mainButton.Position = UDim2.new(0, 10, 0, 10)
    mainButton.BackgroundColor3 = Color3.fromRGB(235, 60, 60)
    mainButton.Text = "START FARM"
    mainButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    mainButton.Font = Enum.Font.GothamBold
    mainButton.TextSize = 15
    mainButton.Parent = mainFrame

    local cornerBtn = Instance.new("UICorner")
    cornerBtn.CornerRadius = UDim.new(0, 8)
    cornerBtn.Parent = mainButton

    -- Dòng văn bản in trạng thái (Thay thế lệnh print)
    statusLogLabel = Instance.new("TextLabel")
    statusLogLabel.Size = UDim2.new(1, -20, 0, 30)
    statusLogLabel.Position = UDim2.new(0, 10, 0, 55)
    statusLogLabel.BackgroundTransparency = 1
    statusLogLabel.Text = " Trạng thái: Sẵn sàng cày!"
    statusLogLabel.TextColor3 = Color3.fromRGB(200, 255, 200)
    statusLogLabel.Font = Enum.Font.GothamMedium
    statusLogLabel.TextSize = 11
    statusLogLabel.TextXAlignment = Enum.TextXAlignment.Left
    statusLogLabel.TextWrapped = true
    statusLogLabel.Parent = mainFrame

    -- Tính năng Kéo thả bảng menu (Dùng ngón tay vuốt để di chuyển bảng nếu vướng)
    local dragging, dragInput, dragStart, startPos
    mainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
        end
    end)
    mainFrame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Sự kiện chạm tay (Click) vào nút trên Mobile
    mainButton.MouseButton1Click:Connect(function()
        toggleFarm()
    end)
end

-- Chạy giao diện điều khiển màn hình
createMobileUI()
