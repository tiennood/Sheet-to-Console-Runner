            if elapsed > currentTimeout - 60 then TLabel.TextColor3 = Color3.fromRGB(255, 100, 100) end
            if elapsed >= currentTimeout then
                TLabel.Text = "🚨 REJOINING..."
                robustRejoin()
                task.wait(10)
                startTime = tick()
            end
            task.wait(1)
        end
    end)
end

