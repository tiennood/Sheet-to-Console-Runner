local function teleportTo(targetCFrame)
    local rootPart = getDragonRoot()
    if rootPart then rootPart.CFrame = targetCFrame end
end

local function flyTo(targetVector, missionStatus)
    local rootPart = getDragonRoot()
    if not rootPart then return false end

    local startPos = rootPart.Position
    local distance = (startPos - targetVector).Magnitude
    local timeToFly = distance / FLY_SPEED
    local startTime = tick()

    while tick() - startTime < timeToFly do
        if not SCRIPT_RUNNING then return true end
        if missionStatus and missionStatus.Value == true then return true end
        local alpha = (tick() - startTime) / timeToFly
        local currentPos = startPos:Lerp(targetVector, alpha)
        rootPart.Velocity = Vector3.new(0, 0, 0)
        rootPart.CFrame = CFrame.lookAt(currentPos, targetVector)
        RunService.Heartbeat:Wait()
    end
    rootPart.Velocity = Vector3.new(0, 0, 0)
    rootPart.CFrame = CFrame.lookAt(targetVector, targetVector + (targetVector - startPos).Unit)
    return false
end

local function teleportDrops()
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    for _, loc in ipairs({Workspace.Camera, Workspace}) do
        for _, item in pairs(loc:GetChildren()) do
            if item:IsA("Model") and (string.find(item.Name, "ResourcesModel") or string.find(item.Name, "FoodModel")) then
                local primary = item.PrimaryPart or item:FindFirstChildOfClass("BasePart")
                if primary then pcall(function() item:SetPrimaryPartCFrame(hrp.CFrame) end) end
            end
        end
    end
end

local function getMobHealth(mob, target)
    local healthValue = mob:FindFirstChild("Health") or target:FindFirstChild("Health")
    if not healthValue then
        for _, desc in ipairs(mob:GetDescendants()) do
            if desc.Name == "Health" and desc:IsA("NumberValue") then return desc end
        end
    end
    return healthValue
end

