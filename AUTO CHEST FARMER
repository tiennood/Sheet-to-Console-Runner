local DODGER_FILE = "Active_Alts_Server_v2.json"

local ALTS_LIMIT_CONFIG = {
    DEFAULT = 3,
    [125804922932357] = 2,
}

local function getMapLimit(placeId)
    if ALTS_LIMIT_CONFIG[placeId] then return ALTS_LIMIT_CONFIG[placeId] end
    return ALTS_LIMIT_CONFIG.DEFAULT
end

local function readAltsData()
    if isfile(DODGER_FILE) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(DODGER_FILE))
        end)
        if success and type(result) == "table" then return result end
    end
    return {}
end

local function writeAltsData(data)
    pcall(function()
        writefile(DODGER_FILE, HttpService:JSONEncode(data))
    end)
end

local function hopToEmptyServer()
    print("[ALTS DODGER] Đang tìm Server mới để né đồng bọn...")
    if not httpRequest then return warn("[ALTS DODGER] Lỗi: Executor không hỗ trợ httpRequest!") end
    
    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local success, response = pcall(function() return httpRequest({Url = url, Method = "GET"}) end)
    
    if success and response.Body then
        local data = HttpService:JSONDecode(response.Body)
        if data and data.data then
            local activeData = readAltsData()
            local occupiedJobIds = {}
            for _, dataAlt in pairs(activeData) do 
                local jid = type(dataAlt) == "table" and dataAlt.JobId or dataAlt
                occupiedJobIds[jid] = (occupiedJobIds[jid] or 0) + 1
            end
            
            local maxAllowed = getMapLimit(game.PlaceId)
            local validServers = {}
            for _, svr in ipairs(data.data) do
                local currentOccupants = occupiedJobIds[svr.id] or 0
                if svr.id ~= game.JobId and svr.playing and svr.playing < svr.maxPlayers and currentOccupants < maxAllowed then
                    table.insert(validServers, svr.id)
                end
            end
            
            if #validServers > 0 then
                local rng = Random.new(tick() * 10000 + string.byte(LP.Name, 1, 1))
                local randomJobId = validServers[rng:NextInteger(1, #validServers)]
                print("[ALTS DODGER] Đã tìm thấy bãi an toàn, đang nhảy sang Server ngẫu nhiên...")
                
                activeData[LP.Name] = {JobId = randomJobId, Time = os.time()}
                writeAltsData(activeData)
                
                TeleportService:TeleportToPlaceInstance(game.PlaceId, randomJobId, LP)
                task.wait(999)
            end
        end
    end
    
    print("[ALTS DODGER] Không tìm thấy server qua API, dùng lệnh Tele mặc định...")
    TeleportService:Teleport(game.PlaceId, LP)
    task.wait(999)
end

local function runAltsDodger()
    local LOBBY_ID = 3475397644
    if game.PlaceId == LOBBY_ID or game.PlaceId == TRADE_CONFIG.UNDERCITY_ID then return end

    local myName = LP.Name
    local currentJobId = game.JobId
    local activeData = readAltsData()
    local maxAllowed = getMapLimit(game.PlaceId)
    
    local claimedCount = 0
    local mostRecentTime = 0
    for altName, dataAlt in pairs(activeData) do
        local jid = type(dataAlt) == "table" and dataAlt.JobId or dataAlt
        local t = type(dataAlt) == "table" and dataAlt.Time or 0
        if altName ~= myName and jid == currentJobId then
            claimedCount = claimedCount + 1
            if t > mostRecentTime then mostRecentTime = t end
        end
    end
    
    local physicalCount = 0
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Name ~= myName and activeData[player.Name] ~= nil then
            local p_jid = type(activeData[player.Name]) == "table" and activeData[player.Name].JobId or activeData[player.Name]
            if p_jid == currentJobId then physicalCount = physicalCount + 1 end
        end
    end
    
    local totalOccupants = math.max(claimedCount, physicalCount) + 1
    
    local isBypassed = false
    local SHINRIN_ID = 125804922932357
    if claimedCount > 0 and game.PlaceId ~= SHINRIN_ID then
        local timeDiff = os.time() - mostRecentTime
        if timeDiff >= 60 then isBypassed = true end
    end
    
    if not isBypassed and totalOccupants > maxAllowed then
        print(string.format("[ALTS DODGER] Bãi này đã có %d đồng bọn (Ngưỡng cho phép: %d). Đang rút lui!", totalOccupants - 1, maxAllowed))
        hopToEmptyServer()
    else
        activeData[myName] = {JobId = currentJobId, Time = os.time()}
        writeAltsData(activeData)
        if isBypassed then
            print(string.format("[ALTS DODGER] Đã vượt giới hạn sức chứa do ALT trước vào cách đây > 60s! Chấp nhận farm chung bãi: %s", currentJobId))
        else
            print(string.format("[ALTS DODGER] Bãi farm an toàn (%d/%d slot của nhà mình). Đã ký nhận chủ quyền Server: %s", totalOccupants, maxAllowed, currentJobId))
        end
    end
end

runAltsDodger()

