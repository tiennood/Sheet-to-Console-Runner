        local SELLER_WAIT_CHECKS = 24
        local attempt = 1
        while true do
            local freshInfo = sellerInfo
            if attempt > 1 then
                freshInfo = fetchSellerInfo()
                if not freshInfo or not freshInfo.success or freshInfo.jobId == "" then break end
                sellerJobId = freshInfo.jobId
                sellerName = freshInfo.sellerName or sellerName
            end
            pcall(function() TeleportService:TeleportToPlaceInstance(TRADE_CONFIG.UNDERCITY_ID, sellerJobId, LP) end)
            task.wait(15)
            if isInUndercity() then
                for i = 1, SELLER_WAIT_CHECKS do
                    if isSellerInServer(sellerName) then runScript3(sellerName) return end
                    task.wait(5)
                end
                break
            else
                task.wait(15)
            end
            attempt = attempt + 1
        end
        pcall(function() RS:WaitForChild("Remotes"):WaitForChild("WorldTeleportRemote"):InvokeServer(125804922932357) end)
        task.wait(15)
    end
