    local sellerInfo = fetchSellerInfo()
    if sellerInfo and sellerInfo.success and sellerInfo.jobId ~= "" then
        local sellerName = sellerInfo.sellerName or ""
        local sellerJobId = sellerInfo.jobId
        if isInUndercity() and isSellerInServer(sellerName) then
            runScript3(sellerName)
