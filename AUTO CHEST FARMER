local function autoMob(mapName)
    if isQuestDone(mapName, "KillMobs") then return end
    local spawnPoints = MapSpawnPoints[PlaceId] or {}
    local currentSpawnIndex = 1
    local killMobQuest = nil
    pcall(function() killMobQuest = LP.Data.WorldMissions[mapName].Missions.KillMobs end)
    local firstMobFoundTime = tick()
    local firstMobFound = false

    while SCRIPT_RUNNING do
        if killMobQuest and killMobQuest.Value == true then break end
        if not firstMobFound and (tick() - firstMobFoundTime > 15) then return "REJOIN" end

        pcall(function()
            if killMobQuest and killMobQuest.Value == true then return end
            local char = LP.Character
            local dragonNum = nil
            if char and char:FindFirstChild("Dragons") then
                for _, d in pairs(char.Dragons:GetChildren()) do
                    if tonumber(d.Name) then dragonNum = d.Name; break end
                end
            end
            local mobFolder = Workspace:FindFirstChild("MobFolder")
            if not char or not dragonNum or not mobFolder then task.wait(1); return end

            local currentPos = #spawnPoints > 0 and spawnPoints[currentSpawnIndex] or (char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.Position or Vector3.new(0,0,0))
            if #spawnPoints > 0 then teleportTo(CFrame.new(currentPos)); task.wait(0.5) end

            local mobFound = false
            for _, mob in ipairs(mobFolder:GetChildren()) do
                if killMobQuest and killMobQuest.Value == true then break end
                local target = mob:FindFirstChild(mob.Name)
                if target and target:IsA("BasePart") and (target.Position - currentPos).Magnitude <= MOB_SCAN_RADIUS then
                    local health = mob:FindFirstChild("Health") or target:FindFirstChild("Health")
                    if health and health.Value > 0 then
                        mobFound = true
                        firstMobFound = true
                        local attackStartTime = tick()
                        local lastHealthValue = health.Value
                        local stuckCount = 0
                        while health and health.Value > 0 and SCRIPT_RUNNING and (not killMobQuest or killMobQuest.Value == false) do
                            teleportTo(CFrame.new(target.Position + SAFE_OFFSET_MOB))
                            local dragon = char:FindFirstChild("Dragons") and char.Dragons:FindFirstChild(dragonNum)
                            if dragon then
                                local remote = dragon:FindFirstChild("Remotes") and dragon.Remotes:FindFirstChild("PlaySoundRemote")
                                if remote then remote:FireServer("Breath", "Mobs", target) end
                            end
                            task.wait(0.3)
                            health = mob:FindFirstChild("Health") or target:FindFirstChild("Health")
                            if tick() - attackStartTime > 10 then
                                if health and health.Value >= lastHealthValue then stuckCount = stuckCount + 1
                                else stuckCount = 0; if health then lastHealthValue = health.Value end end
                                attackStartTime = tick()
                                if stuckCount >= 3 then return "REJOIN" end
                            end
                        end
                    end
                end
            end
            if not mobFound and (not killMobQuest or killMobQuest.Value == false) and #spawnPoints > 0 then
                currentSpawnIndex = (currentSpawnIndex % #spawnPoints) + 1
            end
            task.wait(0.5)
        end)
        task.wait(0.2)
    end
end

local function autoFood(mapName)
    if isQuestDone(mapName, "Harvest") then return end
    local harvestQuest = nil
    pcall(function() harvestQuest = LP.Data.WorldMissions[mapName].Missions.Harvest end)

    while SCRIPT_RUNNING do
        if harvestQuest and harvestQuest.Value == true then break end
        pcall(function()
            if harvestQuest and harvestQuest.Value == true then return end
            local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local interactions = Workspace:FindFirstChild("Interactions")
            local nodesFolder = interactions and interactions:FindFirstChild("Nodes")
            local resourcesFolder = nodesFolder and nodesFolder:FindFirstChild("Resources")
            local searchArea = resourcesFolder and resourcesFolder:GetChildren() or {}

            local nearestNode, minDistance = nil, FOOD_SEARCH_RANGE
            for _, obj in ipairs(searchArea) do
                if (string.find(obj.Name, "FoodNode") or string.find(obj.Name, "ResourceNode")) and obj:FindFirstChild("BillboardPart") then
                    local health = obj.BillboardPart:FindFirstChild("Health")
                    if health and health.Value > 0 then
                        local dist = (hrp.Position - obj.BillboardPart.Position).Magnitude
                        if dist < minDistance then minDistance = dist; nearestNode = obj.BillboardPart end
                    end
                end
            end

            if not nearestNode then
                local foodFolder = nodesFolder and nodesFolder:FindFirstChild("Food")
                local foodSearch = foodFolder and foodFolder:GetChildren() or {}
                for _, obj in ipairs(foodSearch) do
                    if string.find(obj.Name, "FoodNode") and obj:FindFirstChild("BillboardPart") then
                        local health = obj.BillboardPart:FindFirstChild("Health")
                        if health and health.Value > 0 then
                            local dist = (hrp.Position - obj.BillboardPart.Position).Magnitude
                            if dist < minDistance then minDistance = dist; nearestNode = obj.BillboardPart end
                        end
                    end
                end
            end

            if nearestNode then
                local farmer = getFarmer()
                if farmer and farmer:FindFirstChild("HumanoidRootPart") then
                    farmer.HumanoidRootPart.CFrame = CFrame.new(nearestNode.Position.X, nearestNode.Position.Y + FARM_HEIGHT_FOOD, nearestNode.Position.Z)
                end
                local attackStartTime = tick()
                local lastHealthValue = nearestNode.Health.Value
                local stuckCount = 0
                while nearestNode.Parent and nearestNode:FindFirstChild("Health") and nearestNode.Health.Value > 0 do
                    if (harvestQuest and harvestQuest.Value == true) or not SCRIPT_RUNNING then break end
                    if farmer and farmer:FindFirstChild("Remotes") then
                        farmer.Remotes.PlaySoundRemote:FireServer("Breath", "Destructibles", nearestNode)
                        farmer.Remotes.PlaySoundRemote:FireServer("Bite", "Destructibles", nearestNode)
                    end
                    task.wait(0.15)
                    if tick() - attackStartTime > 10 then
                        if nearestNode:FindFirstChild("Health") and nearestNode.Health.Value >= lastHealthValue then stuckCount = stuckCount + 1
                        else stuckCount = 0; if nearestNode:FindFirstChild("Health") then lastHealthValue = nearestNode.Health.Value end end
                        attackStartTime = tick()
                        if stuckCount >= 3 then return "REJOIN" end
                    end
                end
            else
                task.wait(1)
            end
        end)
        task.wait(0.2)
    end
end

