local function getFarmer()
    local char = LP.Character
    if not char then return nil end
    local dragons = char:FindFirstChild("Dragons")
    if dragons then
        for _, d in pairs(dragons:GetChildren()) do
            if tonumber(d.Name) and d:FindFirstChild("HumanoidRootPart") then return d end
        end
    end
    return char
end

local function getDragonRoot()
    local f = getFarmer()
    return f and f:FindFirstChild("HumanoidRootPart")
end

local function teleportTo(targetCFrame)
    local root = getDragonRoot()
    if root then root.CFrame = targetCFrame end
end

local function teleportToWorld(targetPlaceId)
    pcall(function()
        RS:WaitForChild("Remotes"):WaitForChild("WorldTeleportRemote"):InvokeServer(targetPlaceId)
    end)
end

local function getCurrentMapName()
