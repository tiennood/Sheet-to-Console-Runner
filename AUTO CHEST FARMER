local DODGER_FILE = "Active_Alts_Server_v2.json"
local ALTS_LIMIT_CONFIG = {
    DEFAULT = 3,
    [125804922932357] = 2,
}
local function getMapLimit(id) return ALTS_LIMIT_CONFIG[id] or ALTS_LIMIT_CONFIG.DEFAULT end
local function readAltsData()
    if isfile(DODGER_FILE) then
        local s, r = pcall(function() return HttpService:JSONDecode(readfile(DODGER_FILE)) end)
        if s and type(r)=="table" then return r end
    end
    return {}
end
local function writeAltsData(d) pcall(function() writefile(DODGER_FILE, HttpService:JSONEncode(d)) end) end
local function hopToEmptyServer()
    print("[ALTS DODGER] Đang tìm Server mới...")
    if not httpRequest then return warn("[ALTS DODGER] Lỗi: Executor không hỗ trợ httpRequest!") end
    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local s, r = pcall(function() return httpRequest({Url=url, Method="GET"}) end)
    if s and r.Body then
        local data = HttpService:JSONDecode(r.Body)
        if data and data.data then
            local activeData = readAltsData()
            local occupiedJobIds = {}
            for _, d in pairs(activeData) do local j = type(d)=="table" and d.JobId or d; occupiedJobIds[j] = (occupiedJobIds[j] or 0) + 1 end
            local maxAllowed = getMapLimit(game.PlaceId)
            local validServers = {}
            for _, svr in ipairs(data.data) do
                local occ = occupiedJobIds[svr.id] or 0
                if svr.id ~= game.JobId and svr.playing and svr.playing < svr.maxPlayers and occ < maxAllowed then
                    table.insert(validServers, svr.id)
                end
            end
            if #validServers > 0 then
                local rng = Random.new(tick()*10000 + string.byte(LP.Name,1,1))
                local randomJobId = validServers[rng:NextInteger(1, #validServers)]
                print("[ALTS DODGER] Đã tìm thấy bãi an toàn...")
                activeData[LP.Name] = {JobId=randomJobId, Time=os.time()}
                writeAltsData(activeData)
                TeleportService:TeleportToPlaceInstance(game.PlaceId, randomJobId, LP)
                task.wait(999)
            end
        end
    end
    print("[ALTS DODGER] Không tìm thấy server qua API, dùng Tele mặc định...")
    TeleportService:Teleport(game.PlaceId, LP)
    task.wait(999)
end
local function runAltsDodger()
    local LOBBY_ID = 3475397644
    if game.PlaceId == LOBBY_ID or game.PlaceId == TRADE_CONFIG.UNDERCITY_ID then return end
    local myName = LP.Name
    local currentJobId = game.JobId
    local activeData = readAltsData()
    local maxAllowed = getMapLimit(game.PlaceId)
    local claimedCount, mostRecentTime = 0, 0
    for altName, dataAlt in pairs(activeData) do
        local j = type(dataAlt)=="table" and dataAlt.JobId or dataAlt
        local t = type(dataAlt)=="table" and dataAlt.Time or 0
        if altName ~= myName and j == currentJobId then
            claimedCount = claimedCount + 1
            if t > mostRecentTime then mostRecentTime = t end
        end
    end
    local physicalCount = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name ~= myName and activeData[p.Name] ~= nil then
            local p_j = type(activeData[p.Name])=="table" and activeData[p.Name].JobId or activeData[p.Name]
            if p_j == currentJobId then physicalCount = physicalCount + 1 end
        end
    end
    local totalOccupants = math.max(claimedCount, physicalCount) + 1
    local isBypassed = false
    local SHINRIN_ID = 125804922932357
    if claimedCount > 0 and game.PlaceId ~= SHINRIN_ID then
        if os.time() - mostRecentTime >= 60 then isBypassed = true end
    end
    if not isBypassed and totalOccupants > maxAllowed then
        print(string.format("[ALTS DODGER] Bãi này đã có %d đồng bọn (Ngưỡng: %d). Rút lui!", totalOccupants-1, maxAllowed))
        hopToEmptyServer()
    else
        activeData[myName] = {JobId=currentJobId, Time=os.time()}
        writeAltsData(activeData)
        if isBypassed then
            print(string.format("[ALTS DODGER] Đã vượt giới hạn do ALT trước vào > 60s! Farm chung bãi: %s", currentJobId))
        else
            print(string.format("[ALTS DODGER] Bãi farm an toàn (%d/%d). Đã ký nhận chủ quyền Server: %s", totalOccupants, maxAllowed, currentJobId))
        end
    end
end
runAltsDodger()

