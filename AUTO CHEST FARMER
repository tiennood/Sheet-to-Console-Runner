    MLabel.Size, MLabel.Text = UDim2.new(1, 0, 0, 25), "📍 Map: Init..."
    MLabel.TextColor3, MLabel.Font, MLabel.TextSize = Color3.fromRGB(255, 255, 255), Enum.Font.GothamBold, 13
    MLabel.BackgroundTransparency = 1
    local TLabel = Instance.new("TextLabel", Main)
    TLabel.Size, TLabel.Position, TLabel.Text = UDim2.new(1, 0, 0, 25), UDim2.new(0, 0, 0, 25), "⏳ Time: 0s / ??s"
    TLabel.TextColor3, TLabel.Font, TLabel.TextSize = Color3.fromRGB(200, 200, 200), Enum.Font.Gotham, 11
    TLabel.BackgroundTransparency = 1

    local lastMap = getMapName()
    local startTime = tick()
    task.spawn(function()
        while true do
            local currentMap = getMapName()
            local elapsed = tick() - startTime
            local currentTimeout = STICKY_TIMEOUT
            if currentMap == "Shinrin" then currentTimeout = SHINRIN_TIMEOUT
            elseif currentMap == "Lobby" then currentTimeout = LOBBY_TIMEOUT
            elseif currentMap == "Undercity" then currentTimeout = UNDERCITY_TIMEOUT end
            MLabel.Text = "📍 Map: " .. currentMap
            TLabel.Text = string.format("⏳ Time: %02d:%02d / %02d:00", math.floor(elapsed/60), math.floor(elapsed%60), math.floor(currentTimeout/60))
