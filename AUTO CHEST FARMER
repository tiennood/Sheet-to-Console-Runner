local function chestFarmingMode(mapName)
    local BlacklistedChests = {}
    local farmer = getFarmer()
    local hrp = farmer and farmer:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local CurrentCoordinates = ChestCoordinates[PlaceId] or {}

    -- Bay qua từng tọa độ để quét rương
    for _, targetPos in ipairs(CurrentCoordinates) do
        if not SCRIPT_RUNNING then break end
        hrp.CFrame = CFrame.new(targetPos)
        task.wait(0.5)

        local nodesFolder = Workspace:FindFirstChild("Interactions") and Workspace.Interactions:FindFirstChild("Nodes") and Workspace.Interactions.Nodes:FindFirstChild("Treasure")
        if nodesFolder then
            for _, node in pairs(nodesFolder:GetChildren()) do
                if not BlacklistedChests[node] and node:FindFirstChild("TouchInterest") == nil then
                    local pos = node:IsA("Model") and node:GetModelCFrame().Position or node.Position
                    if (hrp.Position - pos).Magnitude < 100 then
                        local targetCFrame = node:IsA("Model") and node:GetModelCFrame() or node.CFrame
                        hrp.CFrame = targetCFrame * CFrame.new(0, FARM_HEIGHT_CHEST, 0)

                        local popRemote = RS:WaitForChild("Remotes"):WaitForChild("PoppedDiscoverIndicatorRemote")
                        local chestFolder = LP.Data.TreasureChests:FindFirstChild(mapName)
                        if chestFolder then
                            local chestData = chestFolder:FindFirstChild(node.Name)
                            if chestData then pcall(function() popRemote:FireServer("TreasureChest", chestData) end) end
                        end

                        local OpenChestRemote = LP:FindFirstChild("Remotes") and LP.Remotes:FindFirstChild("OpenChestRemote")
                        local startAtk = tick()
                        while node.Parent and (tick() - startAtk < 3) do
                            hrp.CFrame = targetCFrame * CFrame.new(0, FARM_HEIGHT_CHEST, 0)
                            if OpenChestRemote then pcall(function() for i = 1, 5 do OpenChestRemote:InvokeServer(i, false) end end) end
                            if farmer:FindFirstChild("Remotes") and farmer.Remotes:FindFirstChild("PlaySoundRemote") then
                                pcall(function() farmer.Remotes.PlaySoundRemote:FireServer("Bite", "Destructibles", node) end)
                            end
                            task.wait(0.1)
                        end
                        BlacklistedChests[node] = true
                    end
                end
            end
        end
    end

    -- Tìm map thấp hơn tiếp theo
    local nextMapPlaceId = nil
    local foundCurrent = false
    for _, mapInfo in ipairs(MapOrder) do
        if mapInfo.name == "Shinrin" or mapInfo.name == "Lobby" then continue end
        if foundCurrent then
            nextMapPlaceId = mapInfo.placeId
            break
        end
        if mapInfo.placeId == PlaceId then foundCurrent = true end
    end

    -- Nếu map hiện tại là Grassland (map thấp nhất), vòng lại Prehistoric
    if not nextMapPlaceId then nextMapPlaceId = 4869039553 end 

    teleportToWorld(nextMapPlaceId)
    task.wait(999)
end

