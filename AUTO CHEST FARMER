local function runScript3(sellerName)
    ---///--- BẮT ĐẦU PASTE 3 (BUYER LOOP) TỪ ĐÂY ---///---
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local Remotes = ReplicatedStorage:WaitForChild("Remotes")
    local function buyFromSeller(seller, slotIndex)
        pcall(function() Remotes:WaitForChild("PurchasePlayerMarketRemote"):FireServer({ Index = tostring(slotIndex), Player = seller }) end)
    end
    local seller = Players:FindFirstChild(sellerName)
    if not seller then seller = Players:WaitForChild(sellerName, 120) end
    if not seller then
        pcall(function() ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("WorldTeleportRemote"):InvokeServer(125804922932357) end)
        task.wait(15) return
    end
    local running = true
    task.spawn(function() while running do if not Players:FindFirstChild(seller.Name) then running = false end task.wait(3) end end)
    task.spawn(function()
        while running do
            local currentCoins = getCoins()
            if currentCoins < TRADE_CONFIG.COIN_THRESHOLD then running = false break end
            for i = 1, 5 do task.spawn(function() buyFromSeller(seller, i) end) end
            task.wait()
        end
        task.wait(2)
        pcall(function() ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("WorldTeleportRemote"):InvokeServer(125804922932357) end)
    end)
    while running do task.wait(1) end
    task.wait(10)
    ---///--- KẾT THÚC PASTE 3 Ở ĐÂY ---///---
end

