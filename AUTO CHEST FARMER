local LoadGate = {}
local CONFIG = {
    CHECK_INTERVAL = 0.4,
    STABLE_REQUIRED = 2,
    MAX_DELTA = 60,
    GRACE_DELAY = 1,
    TIMEOUT = 35,
    USE_MAP_FOLDER = true,
    EARLY_RELEASE_RATIO = 0.8,
    AUTO_REJOIN_ON_TIMEOUT = false
}
local function engineReady()
    if not game:IsLoaded() then game.Loaded:Wait() end
end
local function playerReady()
    local Players = game:GetService("Players")
    local player = Players.LocalPlayer
    while not player.Character or not player.Character.Parent do player.CharacterAdded:Wait() end
    player.Character:WaitForChild("HumanoidRootPart", 10)
end
local function getTargetFolder()
    if CONFIG.USE_MAP_FOLDER then
        local map = workspace:FindFirstChild("Map")
        if map then return map end
    end
    return workspace
end
function LoadGate:WaitUntilStable()
    engineReady()
    playerReady()
    local startTime = tick()
    local stableTime = 0
    local targetFolder = getTargetFolder()
    local function getCount()
        return #targetFolder:GetDescendants()
    end
    local lastCount = getCount()
    local peakCount = lastCount
    while true do
        task.wait(CONFIG.CHECK_INTERVAL)
        local currentCount = getCount()
        local delta = math.abs(currentCount - lastCount)
        if currentCount > peakCount then peakCount = currentCount end
        if currentCount >= peakCount * CONFIG.EARLY_RELEASE_RATIO and delta <= CONFIG.MAX_DELTA then
            stableTime += CONFIG.CHECK_INTERVAL
        else
            stableTime = 0
        end
        if stableTime >= CONFIG.STABLE_REQUIRED then break end
        if tick() - startTime > CONFIG.TIMEOUT then
            if CONFIG.AUTO_REJOIN_ON_TIMEOUT then
                local TeleportService = game:GetService("TeleportService")
                TeleportService:Teleport(game.PlaceId)
            end
            break
        end
        lastCount = currentCount
    end
    task.wait(CONFIG.GRACE_DELAY)
end

