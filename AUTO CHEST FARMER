local function skipTutorial()
    local remote = RS:WaitForChild("Remotes"):WaitForChild("SetTutorialStageRemote")
    local stages = {"HatchingEggs", "GrowingDragon", "SkillsIntroduction", "NextWorld", "Complete"}
    for _, stage in ipairs(stages) do pcall(function() remote:InvokeServer(stage) end); task.wait(0.5) end
    task.wait(3)
end

local function teleportHighToLow(excludePlaceId)
    for i, mapInfo in ipairs(MapOrder) do
        if mapInfo.placeId ~= excludePlaceId then
            local shouldTry = (mapInfo.name == "Shinrin") or (not isMapFullyCompleted(mapInfo.name))
            if shouldTry then teleportToWorld(mapInfo.placeId); task.wait(1) end
        end
    end
end

