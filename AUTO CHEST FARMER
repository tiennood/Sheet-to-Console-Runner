local function isQuestDone(mapName, questName)
    local ok, val = pcall(function()
        return LP.Data.WorldMissions[mapName].Missions[questName].Value
    end)
    return ok and val == true
end

local function isMapFullyCompleted(mapName)
    local ok, count = pcall(function()
        return LP.Data.WorldMissions[mapName].TotalCompleted.Value
    end)
    if not ok then return false end
    if mapName == "Lobby" then return count >= 2
    elseif mapName == "Grassland" then return count >= 4
    else return count >= 6 end
end

local function allMapsCompleted()
    for _, mapInfo in ipairs(MapOrder) do
        local name = mapInfo.name
        if name ~= "Shinrin" and name ~= "Lobby" then
            if not isMapFullyCompleted(name) then return false end
        end
    end
    return true
end

