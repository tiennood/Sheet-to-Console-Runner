local function isMapFullyCompleted(mapName)
    local ok, count = pcall(function()
        return LP.Data.WorldMissions[mapName].TotalCompleted.Value
    end)
    if not ok then return false end
    if mapName == "Grassland" then return count >= 4
    else return count >= 6 end
end

local function allMapsCompleted()
    for _, mapName in ipairs(MapOrderForCheck) do
        if not isMapFullyCompleted(mapName) then
            return false
        end
    end
    return true
end

