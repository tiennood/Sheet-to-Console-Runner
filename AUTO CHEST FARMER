local function autoChestQuest(mapName)
    if isQuestDone(mapName, "TreasureChest") then return end
    local BlacklistedChests = {}
    local CurrentCoordinates = ChestCoordinates[PlaceId] or {}
    local CurrentCoordIndex = 1
    local chestQuest = nil
    pcall(function() chestQuest = LP.Data.WorldMissions[mapName].Missions.TreasureChest end)

    local function findActiveChest()
        local nodesFolder = Workspace:FindFirstChild("Interactions") and Workspace.Interactions:FindFirstChild("Nodes") and Workspace.Interactions.Nodes:FindFirstChild("Treasure")
        local hrp = getDragonRoot()
        if not nodesFolder or not hrp then return nil end
        local nearest, minDst = nil, 999999
        for _, node in pairs(nodesFolder:GetChildren()) do
            if not BlacklistedChests[node] and node:FindFirstChild("TouchInterest") == nil then
                local pos = node:IsA("Model") and node:GetModelCFrame().Position or node.Position
                local dist = (hrp.Position - pos).Magnitude
                if dist < minDst then minDst = dist; nearest = node end
            end
        end
        return nearest
    end

    local lastChestTime = tick()
    while SCRIPT_RUNNING do
        if chestQuest and chestQuest.Value == true then break end
        if tick() - lastChestTime > 30 then return "REJOIN" end

        pcall(function()
            if chestQuest and chestQuest.Value == true then return end
            local farmer = getFarmer()
            local hrp = farmer and farmer:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local activeChest = findActiveChest()
            if activeChest then
                lastChestTime = tick()
                local targetCFrame = activeChest:IsA("Model") and activeChest:GetModelCFrame() or activeChest.CFrame
                hrp.CFrame = targetCFrame * CFrame.new(0, FARM_HEIGHT_CHEST, 0)

                local popRemote = RS:WaitForChild("Remotes"):WaitForChild("PoppedDiscoverIndicatorRemote")
                local chestFolder = LP.Data.TreasureChests:FindFirstChild(mapName)
                if chestFolder then
                    local chestData = chestFolder:FindFirstChild(activeChest.Name)
                    if chestData then popRemote:FireServer("TreasureChest", chestData) end
                end

                local OpenChestRemote = LP:FindFirstChild("Remotes") and LP.Remotes:FindFirstChild("OpenChestRemote")
                local startAtk = tick()
                while activeChest.Parent and (tick() - startAtk < 1) do
                    hrp.CFrame = targetCFrame * CFrame.new(0, FARM_HEIGHT_CHEST, 0)
                    if OpenChestRemote then pcall(function() for i = 1, 5 do OpenChestRemote:InvokeServer(i, false) end end) end
                    if farmer:FindFirstChild("Remotes") and farmer.Remotes:FindFirstChild("PlaySoundRemote") then
                        farmer.Remotes.PlaySoundRemote:FireServer("Bite", "Destructibles", activeChest)
                    end
                    task.wait(0.1)
                end
                if activeChest.Parent and (tick() - startAtk > 30) then return "REJOIN" end
                BlacklistedChests[activeChest] = true
            else
                if #CurrentCoordinates > 0 then
                    hrp.CFrame = CFrame.new(CurrentCoordinates[CurrentCoordIndex])
                    CurrentCoordIndex = (CurrentCoordIndex % #CurrentCoordinates) + 1
                    task.wait(1)
                else
                    task.wait(1)
                end
            end
        end)
        task.wait(0.2)
    end
end

local function autoBoss(mapName)
    if isQuestDone(mapName, "KillBoss") then return end
    local ATTACK_RANGE = 250
    local killBossQuest = nil
    pcall(function() killBossQuest = LP.Data.WorldMissions[mapName].Missions.KillBoss end)
    local Remotes = RS:WaitForChild("Remotes")
    local bossCreateStartTime = tick()

    while SCRIPT_RUNNING do
        if killBossQuest and killBossQuest.Value == true then break end
        inBossArea = false
        local success, err = pcall(function()
            if killBossQuest and killBossQuest.Value == true then return end
            inBossArea = true

            pcall(function() Remotes:WaitForChild("CreateBossQueueRemote"):InvokeServer("NoOne") end)
            task.wait(1.5)
            pcall(function() Remotes:WaitForChild("StartBossQueueRemote"):InvokeServer() end)
            task.wait(2)

            local waitStart = tick()
            local BossInstancesFolder, activeBossModels
            while tick() - waitStart < 15 do
                BossInstancesFolder = Workspace:FindFirstChild("Interactions") and Workspace.Interactions:FindFirstChild("Boss") and Workspace.Interactions.Boss:FindFirstChild("BossInstances")
                activeBossModels = Workspace:FindFirstChild("ActiveBossModels")
                if BossInstancesFolder and activeBossModels and #BossInstancesFolder:GetChildren() > 0 and #activeBossModels:GetChildren() > 0 then break end
                task.wait(1)
            end

            if not BossInstancesFolder or not activeBossModels or #BossInstancesFolder:GetChildren() == 0 or #activeBossModels:GetChildren() == 0 then
                if tick() - bossCreateStartTime > 30 then
                    pcall(function() Remotes:WaitForChild("LeaveBossInstanceRemote"):InvokeServer() end)
                    inBossArea = false; robustRejoin(); task.wait(10); return
                end
                pcall(function() Remotes:WaitForChild("LeaveBossInstanceRemote"):InvokeServer() end)
                inBossArea = false; return
            end

            local myBossData, physicalBoss
            local farmerHRP = getDragonRoot()
            if BossInstancesFolder and activeBossModels and farmerHRP then
                local minBossDist = math.huge
                local allBossDatas = BossInstancesFolder:GetChildren()
                for i, bModel in ipairs(activeBossModels:GetChildren()) do
                    local bHRP = bModel:FindFirstChild("HumanoidRootPart")
                    if bHRP then
                        local dist = (farmerHRP.Position - bHRP.Position).Magnitude
                        if dist < minBossDist then minBossDist = dist; physicalBoss = bModel; myBossData = allBossDatas[i] end
                    end
                end
            end

            if not myBossData or not physicalBoss then
                myBossData = BossInstancesFolder:GetChildren()[1]
                physicalBoss = activeBossModels:GetChildren()[1]
            end

            if not myBossData or not physicalBoss then return end
            local CantDamage = myBossData:FindFirstChild("CantDamage")
            local Dead = myBossData:FindFirstChild("Dead")
            local FightEnd = myBossData:FindFirstChild("FightEnd")
            local bossHRP = physicalBoss:FindFirstChild("HumanoidRootPart")

            if not CantDamage or not Dead or not bossHRP then return end
            local fightStartTime = tick()
            local bossHealth = myBossData:FindFirstChild("Health")
            local lastHP = bossHealth and bossHealth.Value or 0
            local lastHPCheckTime = tick()

            while SCRIPT_RUNNING and Dead.Value == false and (not killBossQuest or killBossQuest.Value == false) do
                local farmer = getFarmer()
                local hrp = farmer and farmer:FindFirstChild("HumanoidRootPart")
                if not hrp then task.wait(0.5) continue end
                local playSoundRemote = farmer:FindFirstChild("Remotes") and farmer.Remotes:FindFirstChild("PlaySoundRemote")
                if not playSoundRemote then task.wait(0.5) continue end

                if CantDamage.Value == true then
                    local mobTarget, minDst = nil, ATTACK_RANGE
                    local mobFolder = Workspace:FindFirstChild("MobFolder")
                    if mobFolder then
                        for _, mobModel in pairs(mobFolder:GetChildren()) do
                            local innerMobPart = mobModel:FindFirstChild(mobModel.Name)
                            if innerMobPart and innerMobPart:IsA("BasePart") then
                                local healthVal = mobModel:FindFirstChild("Health") or innerMobPart:FindFirstChild("Health")
                                if healthVal and healthVal.Value > 0 then
                                    local dist = (hrp.Position - innerMobPart.Position).Magnitude
                                    if dist < minDst then minDst = dist; mobTarget = innerMobPart end
                                end
                            end
                        end
                    end
                    if mobTarget then
                        if (hrp.Position - mobTarget.Position).Magnitude > 50 then hrp.CFrame = CFrame.new(mobTarget.Position + Vector3.new(0, 30, 0)) end
                        playSoundRemote:FireServer("Breath", "Mobs", mobTarget)
                    end
                else
                    if bossHRP and (hrp.Position - bossHRP.Position).Magnitude > 50 then hrp.CFrame = CFrame.new(bossHRP.Position + Vector3.new(0, 35, 0)) end
                    playSoundRemote:FireServer("Breath", "Bosses", bossHRP)
                end

                if bossHealth and (tick() - lastHPCheckTime > 40) then
                    if bossHealth.Value >= lastHP then robustRejoin(); task.wait(10); break
                    else lastHP = bossHealth.Value; lastHPCheckTime = tick() end
                end
                if tick() - fightStartTime > 60 then robustRejoin(); task.wait(10); break end
                task.wait(0.2)
            end

            if Dead.Value == true or (FightEnd and FightEnd.Value == true) or (killBossQuest and killBossQuest.Value == true) then
                task.wait(2)
                pcall(function()
                    Remotes:WaitForChild("GetBossLootRemote"):InvokeServer(math.random(1, 3))
                    task.wait(1); inBossArea = false
                    Remotes:WaitForChild("LeaveBossInstanceRemote"):InvokeServer(); task.wait(1)
                    Remotes:WaitForChild("GetTeleportRemote"):InvokeServer("ToBossReturn")
                end)
                task.wait(5)
            else
                pcall(function()
                    inBossArea = false
                    Remotes:WaitForChild("LeaveBossInstanceRemote"):InvokeServer(); task.wait(1)
                    Remotes:WaitForChild("GetTeleportRemote"):InvokeServer("ToBossReturn")
                end)
                task.wait(3)
                pcall(function() RS:WaitForChild("Remotes"):WaitForChild("WorldTeleportRemote"):InvokeServer(PlaceId, {}) end)
                task.wait(5)
            end
        end)
        if not success then inBossArea = false end
        task.wait(1)
    end
    inBossArea = false
end

local function runAllQuests(mapName)
    if autoEgg(mapName) == "REJOIN" then return "REJOIN" end
    if not SCRIPT_RUNNING then return end
    if autoChestQuest(mapName) == "REJOIN" then return "REJOIN" end
    if not SCRIPT_RUNNING then return end
    if autoMob(mapName) == "REJOIN" then return "REJOIN" end
    if not SCRIPT_RUNNING then return end
    if autoFood(mapName) == "REJOIN" then return "REJOIN" end
    if not SCRIPT_RUNNING then return end

    if mapName ~= "Grassland" then
        BOND_PAUSED = true
        autoBoss(mapName)
        BOND_PAUSED = false
        if not SCRIPT_RUNNING then return end
    end
end

