            while true do
                task.wait(CONFIG_LOAD.CHECK_INTERVAL)
                local currentCount = getCount()
                local delta = math.abs(currentCount - lastCount)
                if currentCount > peakCount then peakCount = currentCount end
                if currentCount >= peakCount * CONFIG_LOAD.EARLY_RELEASE_RATIO and delta <= CONFIG_LOAD.MAX_DELTA then
