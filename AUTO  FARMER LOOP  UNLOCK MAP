                else stableTime = 0 end
                if stableTime >= CONFIG_LOAD.STABLE_REQUIRED then break end
                if tick() - startTime > CONFIG_LOAD.TIMEOUT then
                    if CONFIG_LOAD.AUTO_REJOIN_ON_TIMEOUT then TeleportService:Teleport(game.PlaceId) end
