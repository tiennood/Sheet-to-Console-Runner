                        teleportToWorld(mapInfo.placeId)
                        task.wait(1)
                    end
                end
            end
        end

        -- ==========================================
        -- VÒNG LẶP CHÍNH: ĐỢI 30s, FARM 9 PHÚT RỒI CHUYỂN MAP
        -- ==========================================
        LoadGate:WaitUntilStable()
        task.spawn(function()
            while SCRIPT_RUNNING do
                -- Đợi 30s đồng bộ data khi vừa vào map
                print("[SYNC] Waiting 30s for data sync...")
                task.wait(30)

                if game.PlaceId == 125804922932357 then
                    -- Shinrin: farm lâu hơn (1 giờ) hoặc không giới hạn, nhưng ta vẫn cho 9p để nhất quán? Tốt nhất để Shinrin riêng
                    -- Ở đây ta cho Shinrin farm 9p rồi quay Grassland (vì đã unlock all)
                    local mapStart = tick()
                    while tick() - mapStart < 540 and SCRIPT_RUNNING do
                        -- Gọi runAllQuests (trong Shinrin không có quest, nhưng vẫn farm resources)
                        pcall(function()
                            local allUnlocked = isAllWorldsUnlocked()
                            if not allUnlocked then
                                -- không có egg ở Shinrin, bỏ qua
                            end
                            autoChest("Shinrin") -- nếu có chest
                            autoMob("Shinrin")   -- nếu có mob
                            autoFood("Shinrin")
                            -- không có boss
                        end)
                        task.wait(5)
                    end
                    teleportToWorld(3475419198) -- về Grassland
                    task.wait(15)
                else
                    local currentMapName = MapDataUnlock[game.PlaceId]
                    if not currentMapName then
                        teleportToWorld(3475397644)
                        task.wait(15)
                    else
                        local mapStart = tick()
                        while tick() - mapStart < 540 and SCRIPT_RUNNING do
                            local result = runAllQuests(currentMapName)
                            if result == "REJOIN" then
                                teleportToWorld(game.PlaceId)
                                task.wait(999999)
                            end
                            task.wait(5)
                        end
                        -- Hết 9 phút, chuyển sang map tiếp theo
                        teleportHighToLow(game.PlaceId)
                        task.wait(15)
                    end
                end
            end
        end)
    end

    -- =========================================
    -- ORCHESTRATOR: TRADE ƯU TIÊN, SAU ĐÓ CHẠY PASTE 2
    -- =========================================
    if hasEnoughCoins() then
        local sellerInfo = fetchSellerInfo()
        if sellerInfo and sellerInfo.success and sellerInfo.jobId ~= "" then
            local sellerName = sellerInfo.sellerName or ""
            local sellerJobId = sellerInfo.jobId
            if isInUndercity() and isSellerInServer(sellerName) then
                runScript3(sellerName)
                return
            end
            local SELLER_WAIT_CHECKS = 24
            local attempt = 1
            while true do
                local freshInfo = sellerInfo
                if attempt > 1 then
                    freshInfo = fetchSellerInfo()
                    if not freshInfo or not freshInfo.success or freshInfo.jobId == "" then break end
                    sellerJobId = freshInfo.jobId
                    sellerName = freshInfo.sellerName or sellerName
                end
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(TRADE_CONFIG.UNDERCITY_ID, sellerJobId, LP)
                end)
                task.wait(15)
                if isInUndercity() then
                    for i = 1, SELLER_WAIT_CHECKS do
                        if isSellerInServer(sellerName) then
                            runScript3(sellerName)
                            return
                        end
                        task.wait(5)
                    end
                    break
                else
                    task.wait(15)
                end
                attempt = attempt + 1
            end
            pcall(function()
                game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("WorldTeleportRemote"):InvokeServer(125804922932357)
            end)
            task.wait(15)
        end
    end
    runScript2()
end
