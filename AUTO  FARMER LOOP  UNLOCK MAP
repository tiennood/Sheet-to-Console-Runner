            pcall(function()
                Remotes:WaitForChild("PurchasePlayerMarketRemote"):FireServer({
                    Index = tostring(slotIndex),
                    Player = seller
                })
            end)
        end
        local seller = Players:FindFirstChild(sellerName)
        if not seller then seller = Players:WaitForChild(sellerName, 120) end
        if not seller then
            pcall(function() ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("WorldTeleportRemote"):InvokeServer(125804922932357) end)
            task.wait(15)
            return
        end
        local running = true
        task.spawn(function()
            while running do
                if not Players:FindFirstChild(seller.Name) then running = false end
                task.wait(3)
            end
        end)
        task.spawn(function()
            while running do
                local currentCoins = getCoins()
                if currentCoins < TRADE_CONFIG.COIN_THRESHOLD then running = false break end
                for i = 1, 5 do
