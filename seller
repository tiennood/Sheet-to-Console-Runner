-- =================================================================================
-- COINS MAX CHECK FLAG (100M = 100,000,000)
-- =================================================================================
local MAX_COINS = 100000000 -- 100M
_G.COINS_MAXED = false      -- Cờ toàn cục, true = đã max coins

task.spawn(function()
    local lp = game:GetService("Players").LocalPlayer
    local dataFolder = lp:WaitForChild("Data", 30)
    if not dataFolder then warn("[COINS] ❌ Không tìm thấy Data folder!") return end
    local currency = dataFolder:WaitForChild("Currency", 30)
    if not currency then warn("[COINS] ❌ Không tìm thấy Currency folder!") return end
    local coinsObj = currency:WaitForChild("Coins", 30)
    if not coinsObj then warn("[COINS] ❌ Không tìm thấy Coins value!") return end

    print("[COINS] ✅ Bắt đầu theo dõi số Coins (check mỗi 5s, max = " .. MAX_COINS .. ")")

    while true do
        local currentCoins = coinsObj.Value
        if type(currentCoins) == "number" and currentCoins >= MAX_COINS then
            if not _G.COINS_MAXED then
                _G.COINS_MAXED = true
                warn("[COINS] 🚨 ĐÃ MAX COINS (" .. currentCoins .. "/" .. MAX_COINS .. ")! DỪNG CLAIM + SELL + GỬI BLANK JOBID!")
            end
        else
            if _G.COINS_MAXED then
                _G.COINS_MAXED = false
                print("[COINS] ✅ Coins đã giảm xuống (" .. tostring(currentCoins) .. "), tiếp tục hoạt động bình thường.")
            end
        end
        task.wait(5)
    end
end)

-- AUTO GỬI JOBID LÊN GOOGLE SHEETS (LOOP 1 PHÚT / LẦN)
-- =================================================================================
task.spawn(function()
    -- THAY THẾ LINK SHEETS_URL CỦA BẠN VÀO ĐÂY (Link vừa Deploy xong)
    local SHEETS_URL = "https://script.google.com/macros/s/AKfycbxITEMXKMQwK5j15A7XIPUd4NDWUVfZSuQ64FOPIedZdr4COAaXLGmQ7WSj676ypMtL/exec"
    
    local req = (syn and syn.request) or request or http_request
    if not req then 
        warn("[SELLER] ❌ Executor không hỗ trợ HttpRequest!")
        return 
    end
    
    print("[SELLER] 🔄 Đã bắt đầu Loop gửi JobId (60 giây/lần để giữ kết nối)...")
    
    local hasSentClear = false

    while true do
        if _G.COINS_MAXED then
            -- Mới max coins hoặc gửi lỗi thì mới gửi lệnh clearJobId (Không spam liên tục nữa)
            if not hasSentClear then
                local success, err = pcall(function()
                    req({
                        Url = SHEETS_URL
                            .. "?action=clearJobId"
                            .. "&sellerName=" .. game:GetService("Players").LocalPlayer.Name,
                        Method = "GET"
                    })
                end)
                if success then
                    hasSentClear = true
                    warn("[SELLER] 🚨 MAX COINS → Đã gửi lệnh CLEAR JobId 1 LẦN DUY NHẤT để tiết kiệm request!")
                else
                    warn("[SELLER] ❌ Lỗi gửi clearJobId: " .. tostring(err))
                end
            end
        else
            -- Khi coins tụt xuống bình thường, reset cờ hasSentClear để sẵn sàng cho lần max tiếp theo
            hasSentClear = false
            
            -- Chưa max → Bắt buộc phải gửi JobId mỗi 60s làm Heartbeat (Giữ máy chủ không xóa data sau 5p)
            local success, err = pcall(function()
                req({
                    Url = SHEETS_URL
                        .. "?action=setJobId"
                        .. "&jobId=" .. game.JobId
                        .. "&sellerName=" .. game:GetService("Players").LocalPlayer.Name,
                    Method = "GET"
                })
            end)
            if success then
                print("[SELLER] ✅ JobId đã cập nhật lên Server: " .. game.JobId)
            else
                warn("[SELLER] ❌ Lỗi gửi JobId: " .. tostring(err))
            end
        end
        
        -- Luôn đợi 60s cho vòng lặp tiếp theo
        task.wait(60)
    end
end)


