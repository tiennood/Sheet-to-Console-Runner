-- LUỒNG 3: AUTO BUY 5 MÓN TỪ PLAYER ĐƯỢC CHỈ ĐỊNH (HỖ TRỢ NHIỀU NGƯỜI)
-- =================================================================================
task.spawn(function()
    local activePurchases = {} -- Theo dõi các player đang được mua hàng để tránh lặp task

    while true do
        if CONFIG.TARGET_BUYER_NAMES and #CONFIG.TARGET_BUYER_NAMES > 0 then
            for _, name in ipairs(CONFIG.TARGET_BUYER_NAMES) do
                if name ~= "" then
                    local targetPlayer = Players:FindFirstChild(name)
                    if targetPlayer and not activePurchases[name] then
                        activePurchases[name] = true
                        
                        task.spawn(function()
                            print("[SELLER] 🛒 Thấy player " .. name .. " trong server! Bắt đầu auto mua hàng market...")
                            local purchaseMarketRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("PurchasePlayerMarketRemote", 10)
                            
                            if purchaseMarketRemote then
                                while Players:FindFirstChild(name) do
                                    for i = 1, 5 do
                                        local success, err = pcall(function()
                                            if purchaseMarketRemote:IsA("RemoteFunction") then
                                                purchaseMarketRemote:InvokeServer({
                                                    Index = tostring(i),
                                                    Player = targetPlayer
                                                })
                                            else
                                                purchaseMarketRemote:FireServer({
                                                    Index = tostring(i),
                                                    Player = targetPlayer
                                                })
                                            end
                                        end)
                                        if not success and i == 1 then
                                            warn("[SELLER] ❌ Lỗi khi mua hàng từ " .. name .. ": " .. tostring(err))
                                        end
                                    end
                                    task.wait(0.5) -- Spam lệnh mua mỗi 0.5s để clear hàng nhanh nhất
                                end
                            end
                            
                            print("[SELLER] ❌ Player " .. name .. " đã rời server, ngừng auto buy.")
                            activePurchases[name] = nil
                        end)
                    end
                end
            end
        end
        task.wait(5) -- Kiểm tra danh sách mỗi 5s
    end
end)

-- Luồng 1 (Ban đầu): Tự động Buy Apple, Sell lên kệ & Claim Coins
