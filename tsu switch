    # Đọc cấu trúc các cột hiện tại của bảng cookies trên thiết bị người dùng
    c.execute("PRAGMA table_info(cookies)")
    columns_in_db = [row[1] for row in c.fetchall()]
    
    # Chỉ insert những cột thực sự tồn tại trong database SQLite của thiết bị
    insert_cols = []
    insert_vals = []
    for col in columns_in_db:
        insert_cols.append(col)
        if col in cookie_data:
            insert_vals.append(cookie_data[col])
        else:
            # Dự phòng cho các cột NOT NULL mới chưa biết bằng giá trị mặc định 0
            insert_vals.append(0)
            
