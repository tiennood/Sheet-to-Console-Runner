def run_command(cmd, use_su=True):
    prefix = "su -c " if use_su else ""
    full_cmd = f"{prefix}'{cmd}'"
    result = subprocess.run(full_cmd, shell=True, capture_output=True, text=True)
    return result.stdout.strip()

def switch_account(cookie_val):
    print("[*] Dang tat Roblox...")
    run_command("am force-stop com.roblox.client")
    time.sleep(1)

    print("[*] Dang xac dinh User ID cua Roblox...")
