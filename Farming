-- Grassland: 4 quest (Egg, Chest, Mob, Food) — KHÔNG có Boss
-- Jungle trở lên: 5 quest (Egg, Chest, Mob, Food, Boss)
-- THỨ TỰ MỚI: Egg → Chest → Mobs → Food → Boss
local function runAllQuests(mapName)
    local questCount = (mapName == "Grassland") and 4 or 5
 
    local status = autoEgg(mapName)
    if status == "REJOIN" then return "REJOIN" end
    if not SCRIPT_RUNNING then return end
 
    status = autoChest(mapName)
    if status == "REJOIN" then return "REJOIN" end
    if not SCRIPT_RUNNING then return end
 
    status = autoMob(mapName)
    if status == "REJOIN" then return "REJOIN" end
    if not SCRIPT_RUNNING then return end
 
    status = autoFood(mapName)
    if status == "REJOIN" then return "REJOIN" end
    if not SCRIPT_RUNNING then return end
 
    -- Boss cuối cùng (Grassland không có Boss)
    -- TẮT Auto Bond khi đánh Boss để giảm lag
    if mapName ~= "Grassland" then
        BOND_PAUSED = true
        autoBoss(mapName)
        BOND_PAUSED = false
        if not SCRIPT_RUNNING then return end
    end
 
end
 
