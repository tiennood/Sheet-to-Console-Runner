-- ---- AUTO MOB ----
local function autoMob(mapName)
    if isQuestDone(mapName, "KillMobs") then
        return
    end
 
    local spawnPoints = MapSpawnPoints[PlaceId] or {}
    local currentSpawnIndex = 1
 
    local killMobQuest = nil
    pcall(function()
        killMobQuest = LP.Data.WorldMissions[mapName].Missions.KillMobs
    end)
 
    -- [TIMEOUT 15s - MISSION ĐẦU TIÊN]
    -- Nếu trong 15s đầu không tìm thấy bất kỳ mob nào → map hết mob/bị lỗi → rejoin
    local firstMobFoundTime = tick()
    local firstMobFound = false
 
    while SCRIPT_RUNNING do
        if killMobQuest and killMobQuest.Value == true then break end
 
        -- [TIMEOUT CHECK] Chỉ áp dụng trước khi tìm thấy mob đầu tiên
        if not firstMobFound and (tick() - firstMobFoundTime > 15) then
            return "REJOIN"
        end
 
        pcall(function()
            if killMobQuest and killMobQuest.Value == true then return end
 
            local char = LP.Character
            local dragonNum = getDragonNumber()
            local mobFolder = workspace:FindFirstChild("MobFolder")
 
            if not char or not dragonNum or not mobFolder then
                task.wait(1)
                return
            end
 
            local mobFound = false
            local currentPos = nil
 
            if #spawnPoints > 0 then
                currentPos = spawnPoints[currentSpawnIndex]
                teleportTo(CFrame.new(currentPos))
                task.wait(0.5)
            else
                currentPos = char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.Position or Vector3.new(0,0,0)
            end
 
            for _, mob in ipairs(mobFolder:GetChildren()) do
                if killMobQuest and killMobQuest.Value == true then break end
 
                local target = mob:FindFirstChild(mob.Name)
                if target and target:IsA("BasePart") then
                    local distanceToSpawn = (target.Position - currentPos).Magnitude
 
                    if distanceToSpawn <= MOB_SCAN_RADIUS then
                        local health = getMobHealth(mob, target)
 
                        if health and health.Value > 0 then
                            mobFound = true
                            firstMobFound = true -- [TIMEOUT] Đã tìm thấy mob đầu tiên → tắt timeout
 
                            -- [LAG CHECK] Logic mới: Check máu mob mỗi 10s
                            -- Nếu 3 lần (30s) mà máu không giảm -> Map bị lỗi -> Return "REJOIN"
                            local attackStartTime = tick()
                            local lastHealthValue = health.Value
                            local stuckCount = 0
 
                            while health and health.Value > 0 and SCRIPT_RUNNING and (not killMobQuest or killMobQuest.Value == false) do
                                teleportTo(CFrame.new(target.Position + SAFE_OFFSET_MOB))
 
                                local dragon = char:FindFirstChild("Dragons") and char.Dragons:FindFirstChild(dragonNum)
                                if dragon then
                                    local remote = dragon:FindFirstChild("Remotes") and dragon.Remotes:FindFirstChild("PlaySoundRemote")
                                    if remote then
                                        remote:FireServer("Breath", "Mobs", target)
                                    end
                                end
 
                                task.wait(0.3)
                                health = getMobHealth(mob, target)
                                
                                -- Check Lag
                                if tick() - attackStartTime > 10 then
                                    if health and health.Value >= lastHealthValue then
                                        stuckCount = stuckCount + 1
                                    else
                                        stuckCount = 0
                                        if health then lastHealthValue = health.Value end
                                    end
                                    attackStartTime = tick() -- Reset timer
 
                                    if stuckCount >= 3 then
                                        return "REJOIN"
                                    end
                                end
                            end
                        end
                    end
                end
            end
 
            if not mobFound and (not killMobQuest or killMobQuest.Value == false) and #spawnPoints > 0 then
                currentSpawnIndex = currentSpawnIndex + 1
                if currentSpawnIndex > #spawnPoints then
                    currentSpawnIndex = 1
                end
                task.wait(0.5)
            else
                task.wait(0.5)
            end
        end)
 
        task.wait(0.2)
    end
 
end
 
-- ---- AUTO FOOD (Harvest) ----
local function autoFood(mapName)
    if isQuestDone(mapName, "Harvest") then
        return
    end
 
    local harvestQuest = nil
    pcall(function()
        harvestQuest = LP.Data.WorldMissions[mapName].Missions.Harvest
    end)
 
    while SCRIPT_RUNNING do
        if harvestQuest and harvestQuest.Value == true then break end
 
        pcall(function()
            if harvestQuest and harvestQuest.Value == true then return end
 
            local char = LP.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
 
            local interactions = Workspace:FindFirstChild("Interactions")
            local nodesFolder = interactions and interactions:FindFirstChild("Nodes")
            
            -- [TỐI ƯU] Trỏ thẳng vào thư mục Resources (Vì phá LargeResourceNode cũng tính điểm cho Harvest Quest)
            -- Dùng GetChildren() thay vì GetDescendants() để tránh loop lồng/crash lỗi.
            local resourcesFolder = nodesFolder and nodesFolder:FindFirstChild("Resources")
            local searchArea = resourcesFolder and resourcesFolder:GetChildren() or {}
 
            local nearestNode = nil
            local minDistance = FOOD_SEARCH_RANGE
 
            for _, obj in ipairs(searchArea) do
                if harvestQuest and harvestQuest.Value == true then break end

                if (string.find(obj.Name, "FoodNode") or string.find(obj.Name, "ResourceNode")) and obj:FindFirstChild("BillboardPart") then
                    local health = obj.BillboardPart:FindFirstChild("Health")
                    if health and health.Value > 0 then
                        local distance = (hrp.Position - obj.BillboardPart.Position).Magnitude
                        if distance < minDistance then
                            minDistance = distance
                            nearestNode = obj.BillboardPart
                        end
                    end
                end
            end

            -- NẾU XUNG QUANH KHÔNG CÓ RESOURCES THÌ TÌM TRONG THƯ MỤC FOOD
            if not nearestNode then
                local foodFolder = nodesFolder and nodesFolder:FindFirstChild("Food")
                local foodSearchArea = foodFolder and foodFolder:GetChildren() or {}
                for _, obj in ipairs(foodSearchArea) do
                    if harvestQuest and harvestQuest.Value == true then break end

                    if string.find(obj.Name, "FoodNode") and obj:FindFirstChild("BillboardPart") then
                        local health = obj.BillboardPart:FindFirstChild("Health")
                        if health and health.Value > 0 then
                            local distance = (hrp.Position - obj.BillboardPart.Position).Magnitude
                            if distance < minDistance then
                                minDistance = distance
                                nearestNode = obj.BillboardPart
                            end
                        end
                    end
                end
            end

            if nearestNode then
                local farmer = getFarmer()
                local dragon = nil
                local char2 = LP.Character
                if char2 then
                    local folder = char2:FindFirstChild("Dragons")
                    if folder then
                        for _, d in pairs(folder:GetChildren()) do
                            if tonumber(d.Name) then dragon = d; break end
                        end
                    end
                end
 
                if dragon and dragon:FindFirstChild("HumanoidRootPart") then
                    dragon.HumanoidRootPart.CFrame = CFrame.new(nearestNode.Position.X, nearestNode.Position.Y + FARM_HEIGHT_FOOD, nearestNode.Position.Z)
                end
 
                local startAttack = tick()
 
                local attackStartTime = tick()
                local lastHealthValue = nearestNode.Health.Value
                local stuckCount = 0
 
                while nearestNode.Parent and nearestNode:FindFirstChild("Health") and nearestNode.Health.Value > 0 do
                    if (harvestQuest and harvestQuest.Value == true) or not SCRIPT_RUNNING then break end
 
                    if dragon and dragon:FindFirstChild("Remotes") and dragon.Remotes:FindFirstChild("PlaySoundRemote") then
                        dragon.Remotes.PlaySoundRemote:FireServer("Breath", "Destructibles", nearestNode)
                        dragon.Remotes.PlaySoundRemote:FireServer("Bite", "Destructibles", nearestNode)
                    end
 
                    teleportDrops()
                    task.wait(0.15)
                    
                    -- Check Lag
                    if tick() - attackStartTime > 10 then
                        if nearestNode:FindFirstChild("Health") and nearestNode.Health.Value >= lastHealthValue then
                            stuckCount = stuckCount + 1
                        else
                            stuckCount = 0
                            if nearestNode:FindFirstChild("Health") then lastHealthValue = nearestNode.Health.Value end
                        end
                         attackStartTime = tick()
 
                        if stuckCount >= 3 then
                            return "REJOIN"
                        end
                    end
                end
            else
                task.wait(1)
            end
        end)
 
        task.wait(0.2)
    end
 
end
 
-- ---- AUTO EGG ----
local function autoEgg(mapName)
    if isQuestDone(mapName, "EggQuest") then
        return
    end
 
    local eggQuest = nil
    pcall(function()
        eggQuest = LP.Data.WorldMissions[mapName].Missions.EggQuest
    end)
 
    local lastEggTime = tick() -- [TIMEOUT] Theo dõi thời gian tìm trứng
 
    while SCRIPT_RUNNING do
        if eggQuest and eggQuest.Value == true then break end
 
        -- [TIMEOUT CHECK]
        if tick() - lastEggTime > 30 then
            return "REJOIN"
        end
 
        pcall(function()
            if eggQuest and eggQuest.Value == true then return end
 
            local farmer = getFarmer()
            local hrp = farmer and farmer:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
 
            local interactions = Workspace:FindFirstChild("Interactions")
            local activeNodes = interactions and interactions:FindFirstChild("Nodes")
                                and interactions.Nodes:FindFirstChild("Eggs")
                                and interactions.Nodes.Eggs:FindFirstChild("ActiveNodes")
 
            if not activeNodes then
                task.wait(1)
                return
            end
 
            local foundEgg = false
 
            for _, node in pairs(activeNodes:GetChildren()) do
                if eggQuest and eggQuest.Value == true then break end
 
                local eggModel = node:FindFirstChild("EggModel")
                local harvested = eggModel and eggModel:FindFirstChild("Harvested")
 
                if harvested and harvested.Value == false then
                    foundEgg = true
                    lastEggTime = tick() -- [TIMEOUT] Reset timer khi tìm thấy trứng
 
                    local targetCFrame = node:IsA("Model") and node:GetModelCFrame() or node.CFrame
                    hrp.CFrame = targetCFrame + EGG_OFFSET
 
                    task.wait(0.3)
                    harvested.Value = true
                    task.wait(2)
                end
            end
 
            if not foundEgg then
                task.wait(1)
            end
        end)
 
        task.wait(0.2)
    end
 
end
 
-- ---- AUTO CHEST ----
local function autoChest(mapName)
    if isQuestDone(mapName, "TreasureChest") then
        return
    end
 
    local BlacklistedChests = {}
    local CurrentCoordinates = ChestCoordinates[PlaceId] or {}
    local CurrentCoordIndex = 1
 
    local chestQuest = nil
    pcall(function()
        chestQuest = LP.Data.WorldMissions[mapName].Missions.TreasureChest
    end)
 
    local function findActiveChest()
        local nodesFolder = Workspace:FindFirstChild("Interactions") and Workspace.Interactions:FindFirstChild("Nodes") and Workspace.Interactions.Nodes:FindFirstChild("Treasure")
        if not nodesFolder then return nil end
 
        local farmer = getFarmer()
        local hrp = farmer and farmer:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
 
        local nearest, minDst = nil, 999999
        for _, node in pairs(nodesFolder:GetChildren()) do
            if not BlacklistedChests[node] and node:FindFirstChild("TouchInterest") == nil then
                local pos = node:IsA("Model") and node:GetModelCFrame().Position or node.Position
                local dist = (hrp.Position - pos).Magnitude
                if dist < minDst then
                    minDst = dist
                    nearest = node
                end
            end
        end
        return nearest
    end
 
    local lastChestTime = tick() -- [TIMEOUT] Theo dõi thời gian tìm chest
 
    while SCRIPT_RUNNING do
        if chestQuest and chestQuest.Value == true then break end
        
        -- [TIMEOUT CHECK]
        if tick() - lastChestTime > 30 then
            return "REJOIN"
        end
 
        pcall(function()
            if chestQuest and chestQuest.Value == true then return end
 
            local farmer = getFarmer()
            local hrp = farmer and farmer:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
 
            local activeChest = findActiveChest()
 
            if activeChest then
                lastChestTime = tick() -- [TIMEOUT] Reset timer khi tìm thấy chest
                local targetCFrame = activeChest:IsA("Model") and activeChest:GetModelCFrame() or activeChest.CFrame
                hrp.CFrame = targetCFrame * CFrame.new(0, FARM_HEIGHT_CHEST, 0)
 
                local popRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("PoppedDiscoverIndicatorRemote")
                local chestFolder = LP.Data.TreasureChests:FindFirstChild(mapName)
                if chestFolder then
                    local chestData = chestFolder:FindFirstChild(activeChest.Name)
                    if chestData then popRemote:FireServer("TreasureChest", chestData) end
                end
 
                local OpenChestRemote = LP:FindFirstChild("Remotes") and LP.Remotes:FindFirstChild("OpenChestRemote")
 
                local startAtk = tick()
                while activeChest.Parent and (tick() - startAtk < 1) do
                    if chestQuest and chestQuest.Value == true then break end
 
                    hrp.CFrame = targetCFrame * CFrame.new(0, FARM_HEIGHT_CHEST, 0)
 
                    if OpenChestRemote then
                        pcall(function() for i = 1, 5 do OpenChestRemote:InvokeServer(i, false) end end)
                    end
 
                    if farmer:FindFirstChild("Remotes") and farmer.Remotes:FindFirstChild("PlaySoundRemote") then
                        farmer.Remotes.PlaySoundRemote:FireServer("Bite", "Destructibles", activeChest)
                    end
 
                    task.wait(0.1)
                end
                
                -- Check Lag cho Chest (nếu thời gian đánh > 30s mà chest vẫn chưa mở/biến mất)
                if activeChest.Parent and (tick() - startAtk > 30) then
                     return "REJOIN"
                end
 
                if not BlacklistedChests[activeChest] then
                    BlacklistedChests[activeChest] = true
                end
 
            else
                if #CurrentCoordinates > 0 then
                    local targetPos = CurrentCoordinates[CurrentCoordIndex]
                    hrp.CFrame = CFrame.new(targetPos)
 
                    CurrentCoordIndex = CurrentCoordIndex + 1
                    if CurrentCoordIndex > #CurrentCoordinates then
                        CurrentCoordIndex = 1
                    end
 
                    task.wait(1)
                else
                    task.wait(1)
                end
            end
        end)
 
        task.wait(0.2)
    end
 
end
 
