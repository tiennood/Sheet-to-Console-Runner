-- 9B. AUTO BOSS V3 (REMOTE MECHANISM - ALL WORLDS)
-- BAO GỒM: REMOTE CREATE/START, BAY CAO 30/35, AUTO REJOIN KHI KẸT & SAU KHI XONG BOSS
-- ==========================================
local autoBoss
do
    local TeleportService = game:GetService("TeleportService")
 
    -- Hàm Rejoin game (dùng khi boss bị kẹt hoặc sau khi xong boss)
    local function forceRejoin()
        if #Players:GetPlayers() <= 1 then
            TeleportService:Teleport(PlaceId, LP)
        else
            TeleportService:TeleportToPlaceInstance(PlaceId, game.JobId, LP)
        end
    end
 
    -- ==========================================
    -- HÀM CHÍNH: autoBoss(mapName)
    -- ==========================================
    autoBoss = function(mapName)
        if isQuestDone(mapName, "KillBoss") then
            return
        end
 
        local ATTACK_RANGE = 250
 
        local killBossQuest = nil
        pcall(function()
            killBossQuest = LP.Data.WorldMissions[mapName].Missions.KillBoss
        end)
 
        local Remotes = ReplicatedStorage:WaitForChild("Remotes")
 
        -- LỚP BẢO VỆ: TIMEOUT 30s CHO GIAI ĐOẠN TẠO PHÒNG BOSS
        local bossCreateStartTime = tick()
 
        while SCRIPT_RUNNING do
            if killBossQuest and killBossQuest.Value == true then break end
            inBossArea = false
 
            local success, err = pcall(function()
                if killBossQuest and killBossQuest.Value == true then return end
 
                -- BẬT CỜ BOSS AREA → tắt fly/noclip/bond phụ
                inBossArea = true
 
                -- BƯỚC 1: Tạo phòng Boss bằng Remote (thay thế click GUI)
                pcall(function()
                    Remotes:WaitForChild("CreateBossQueueRemote"):InvokeServer("NoOne")
                end)
                task.wait(1.5)
 
                -- BƯỚC 2: Bắt đầu Boss Queue bằng Remote (thay thế click Start)
                pcall(function()
                    Remotes:WaitForChild("StartBossQueueRemote"):InvokeServer()
                end)
                task.wait(2)
 
                -- BƯỚC 3: Đợi Boss Instance xuất hiện
                local waitStart = tick()
                local BossInstancesFolder = nil
                local activeBossModels = nil
 
                while tick() - waitStart < 15 do
                    BossInstancesFolder = Workspace:FindFirstChild("Interactions")
                        and Workspace.Interactions:FindFirstChild("Boss")
                        and Workspace.Interactions.Boss:FindFirstChild("BossInstances")
                    activeBossModels = Workspace:FindFirstChild("ActiveBossModels")
 
                    if BossInstancesFolder and activeBossModels and #BossInstancesFolder:GetChildren() > 0 and #activeBossModels:GetChildren() > 0 then
                        break
                    end
                    task.wait(1)
                end
 
                if not BossInstancesFolder or not activeBossModels or #BossInstancesFolder:GetChildren() == 0 or #activeBossModels:GetChildren() == 0 then
                    -- Check timeout 30s tạo phòng
                    if tick() - bossCreateStartTime > 30 then
                        pcall(function() Remotes:WaitForChild("LeaveBossInstanceRemote"):InvokeServer() end)
                        inBossArea = false
                        forceRejoin()
                        task.wait(10)
                        return
                    end
                    pcall(function() Remotes:WaitForChild("LeaveBossInstanceRemote"):InvokeServer() end)
                    inBossArea = false
                    return
                end
 
 
                local myBossData = nil
                local physicalBoss = nil
                local farmerHRP = getFarmer() and getFarmer():FindFirstChild("HumanoidRootPart")
 
                -- Khóa đúng mục tiêu Boss của phòng mình
                if BossInstancesFolder and activeBossModels and farmerHRP then
                    local minBossDist = math.huge
                    local allBossDatas = BossInstancesFolder:GetChildren()
 
                    for i, bModel in ipairs(activeBossModels:GetChildren()) do
                        local bHRP = bModel:FindFirstChild("HumanoidRootPart")
                        if bHRP then
                            local dist = (farmerHRP.Position - bHRP.Position).Magnitude
                            if dist < minBossDist then
                                minBossDist = dist
                                physicalBoss = bModel
                                myBossData = allBossDatas[i]
                            end
                        end
                    end
                end
 
                if not myBossData or not physicalBoss then
                    myBossData = BossInstancesFolder:GetChildren()[1]
                    physicalBoss = activeBossModels:GetChildren()[1]
                end
 
                if not myBossData or not physicalBoss then return end
 
                local CantDamage = myBossData:FindFirstChild("CantDamage")
                local Dead = myBossData:FindFirstChild("Dead")
                local FightEnd = myBossData:FindFirstChild("FightEnd")
                local bossHRP = physicalBoss:FindFirstChild("HumanoidRootPart")
 
                if not CantDamage or not Dead or not bossHRP then return end
 
                local fightStartTime = tick()
                local bossHealth = myBossData:FindFirstChild("Health")
                local lastHP = bossHealth and bossHealth.Value or 0
                local lastHPCheckTime = tick()
 
                while SCRIPT_RUNNING and Dead.Value == false and (not killBossQuest or killBossQuest.Value == false) do
                    local farmer = getFarmer()
                    local hrp = farmer and farmer:FindFirstChild("HumanoidRootPart")
                    if not hrp then task.wait(0.5) continue end
 
                    local playSoundRemote = farmer:FindFirstChild("Remotes") and farmer.Remotes:FindFirstChild("PlaySoundRemote")
                    if not playSoundRemote then task.wait(0.5) continue end
 
                    -- Boss bật khiên → đánh mob
                    if CantDamage.Value == true then
                        local mobTarget = nil
                        local minDst = ATTACK_RANGE
                        local mobFolder = Workspace:FindFirstChild("MobFolder")
                        if mobFolder then
                            for _, mobModel in pairs(mobFolder:GetChildren()) do
                                local innerMobPart = mobModel:FindFirstChild(mobModel.Name)
                                if innerMobPart and innerMobPart:IsA("BasePart") then
                                    local healthVal = mobModel:FindFirstChild("Health") or innerMobPart:FindFirstChild("Health")
                                    if healthVal and healthVal.Value > 0 then
                                        local dist = (hrp.Position - innerMobPart.Position).Magnitude
                                        if dist < minDst then
                                            minDst = dist
                                            mobTarget = innerMobPart
                                        end
                                    end
                                end
                            end
                        end
                        if mobTarget then
                            if (hrp.Position - mobTarget.Position).Magnitude > 50 then
                                hrp.CFrame = CFrame.new(mobTarget.Position + Vector3.new(0, 30, 0))
                            end
                            playSoundRemote:FireServer("Breath", "Mobs", mobTarget)
                        end
 
                    -- Boss tắt khiên → đánh boss trực tiếp
                    else
                        if bossHRP then
                            if (hrp.Position - bossHRP.Position).Magnitude > 50 then
                                hrp.CFrame = CFrame.new(bossHRP.Position + Vector3.new(0, 35, 0))
                            end
                        end
                        playSoundRemote:FireServer("Breath", "Bosses", bossHRP)
                    end
 
                    -- LOGIC KIỂM TRA MÁU: REJOIN KHI KẸT (40s không giảm HP)
                    if bossHealth and (tick() - lastHPCheckTime > 40) then
                        local currentHP = bossHealth.Value
                        if currentHP >= lastHP then
                            forceRejoin()
                            task.wait(10)
                            break
                        else
                            lastHP = currentHP
                            lastHPCheckTime = tick()
                        end
                    end
                    -- LOGIC PHỤ: TIMEOUT 90s — Nếu quá 1p30s chưa xong boss → boss lỗi / HP check hỏng → Rejoin
                    if tick() - fightStartTime > 60 then
                        forceRejoin()
                        task.wait(10)
                        break
                    end
                    task.wait(0.2)
                end
 
                -- BƯỚC 9: Nhận Thưởng
                if Dead.Value == true or (FightEnd and FightEnd.Value == true) or (killBossQuest and killBossQuest.Value == true) then
                    task.wait(2)
                    local randomChest = math.random(1, 3)
                    pcall(function()
                        Remotes:WaitForChild("GetBossLootRemote"):InvokeServer(randomChest)
                        task.wait(1)
                        inBossArea = false
                        Remotes:WaitForChild("LeaveBossInstanceRemote"):InvokeServer()
                        task.wait(1)
                        Remotes:WaitForChild("GetTeleportRemote"):InvokeServer("ToBossReturn")
                    end)
                    task.wait(5)
                else
                    pcall(function()
                        inBossArea = false
                        Remotes:WaitForChild("LeaveBossInstanceRemote"):InvokeServer()
                        task.wait(1)
                        Remotes:WaitForChild("GetTeleportRemote"):InvokeServer("ToBossReturn")
                    end)
                    task.wait(3)
                    pcall(function()
                        RS:WaitForChild("Remotes"):WaitForChild("WorldTeleportRemote"):InvokeServer(PlaceId, {})
                    end)
                    task.wait(5)
                end
            end)
 
            if not success then
                inBossArea = false
            end
 
            task.wait(1)
        end
 
        inBossArea = false
    end
end
 
