-- Nếu tele thất bại (vẫn ở map cũ) → thử map tiếp theo thấp hơn
-- Bỏ qua excludePlaceId (map đang ở)
local function teleportHighToLow(excludePlaceId)
    for i, mapInfo in ipairs(MapOrder) do
