-- =========================================
-- GOOGLE SHEETS: FETCH SELLER JOBID
-- =========================================
local function fetchSellerInfo()

    local success, result = pcall(function()

        local response = request({
            Url = SHEETS_URL .. "?action=getJobId",
            Method = "GET"
        })

        if not response
        or not response.Body then
            return nil
        end

        local decoded =
            HttpService:JSONDecode(response.Body)

        if type(decoded) ~= "table"
        or #decoded == 0 then
            return nil
        end

        -- lọc seller online
        local onlineSellers = {}

        for _, seller in ipairs(decoded) do

            if seller.status == "online"
            and seller.jobId ~= "" then

                table.insert(
                    onlineSellers,
                    seller
                )
            end
        end

        if #onlineSellers == 0 then
            return nil
        end

        -- sort coins cao nhất
        table.sort(
            onlineSellers,
            function(a,b)

                return tonumber(a.coins or 0)
                    >
                    tonumber(b.coins or 0)
            end
        )

        local bestSeller =
            onlineSellers[1]

        print(
            "[BUYER] BEST SELLER:",
            bestSeller.seller,
            "COINS:",
            bestSeller.coins
        )

        return bestSeller

    end)

    if success then
        return result
    end

    warn("[BUYER] fetchSellerInfo failed")

    return nil
end

