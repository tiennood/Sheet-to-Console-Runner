local function runScript3(sellerName)
    ---///--- BẮT ĐẦU PASTE 3 (BUYER LOOP) TỪ ĐÂY ---///---



    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local Remotes = ReplicatedStorage:WaitForChild("Remotes")

    -- Hàm mua từ Seller
    local function buyFromSeller(seller, slotIndex)
        pcall(function()
            Remotes:WaitForChild("PurchasePlayerMarketRemote"):FireServer({
                Index = tostring(slotIndex),
                Player = seller
            })
        end)
    end

    -- Đợi Seller trong server (tối đa 120s)
    local seller = Players:FindFirstChild(sellerName)
    if not seller then

        seller = Players:WaitForChild(sellerName, 120)
    end

    if not seller then

        pcall(function()
            ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("WorldTeleportRemote"):InvokeServer(125804922932357)
        end)
        task.wait(15)
        return -- Return bình thường, không kẹt
    end



    -- Buyer loop: Mua liên tục cho đến hết coins
    local running = true

    -- ★ Monitor: Nếu seller rời server → dừng mua ngay
    task.spawn(function()
        while running do
            if not Players:FindFirstChild(seller.Name) then

                running = false
            end
            task.wait(3)
        end
    end)

    task.spawn(function()
        while running do
            local currentCoins = getCoins()
            if currentCoins < TRADE_CONFIG.COIN_THRESHOLD then

                running = false
                break
            end

            -- Spam mua tất cả 5 slot
            for i = 1, 5 do
                task.spawn(function()
                    buyFromSeller(seller, i)
                end)
            end
            task.wait()
        end

        -- Hết coins hoặc seller rời → Tele lại Shinrin để farm tiếp

        task.wait(2)
        pcall(function()
            ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("WorldTeleportRemote"):InvokeServer(125804922932357)
        end)
    end)

    -- Giữ script sống cho đến khi buyer loop xong
    while running do
        task.wait(1)
    end
    task.wait(10)

    ---///--- KẾT THÚC PASTE 3 Ở ĐÂY ---///---
end

