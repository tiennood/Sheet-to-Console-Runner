local function doEggQuestLobby()
    local eggMissionStatus = LP:WaitForChild("Data"):WaitForChild("GameAnalytics"):WaitForChild("PostTutorialAnalyticsPlayer"):WaitForChild("FindOriginsEgg")
    if eggMissionStatus.Value == true then return true end
 
 
    -- [TIMEOUT 15s] Nếu không tìm thấy trứng sau 15s → map hết egg hoặc lỗi → rejoin
    local startWait = tick()
    local activeNodes = nil
    while tick() - startWait < 15 do
        activeNodes = workspace:FindFirstChild("Interactions")
            and workspace.Interactions:FindFirstChild("Nodes")
            and workspace.Interactions.Nodes:FindFirstChild("Eggs")
            and workspace.Interactions.Nodes.Eggs:FindFirstChild("ActiveNodes")
        if activeNodes and #activeNodes:GetChildren() > 0 then break end
        task.wait(1)
    end
 
    if not activeNodes or #activeNodes:GetChildren() == 0 then
        return "REJOIN"
    end
 
    -- Kiểm tra có trứng chưa bị thu hoạch không
    local hasUnharvested = false
    for _, node in ipairs(activeNodes:GetChildren()) do
        local eggModel = node:FindFirstChild("EggModel")
        if eggModel then
            local harvested = eggModel:FindFirstChild("Harvested")
            if harvested and harvested.Value == false then
                hasUnharvested = true
                break
            end
        end
    end
 
    if not hasUnharvested then
        return "REJOIN"
    end
 
    for _, node in ipairs(activeNodes:GetChildren()) do
        local eggModel = node:FindFirstChild("EggModel")
        if eggModel then
            local harvested = eggModel:FindFirstChild("Harvested")
            local eggPart = eggModel:FindFirstChild("Egg") or eggModel:FindFirstChild("Base")
            if harvested and harvested.Value == false and eggPart then
                teleportTo(eggPart.CFrame)
                task.wait(0.2)
                harvested.Value = true
                task.wait(0.5)
                return true
            end
        end
    end
    return false
end
 
local function doRingQuest()
    local missionStatus = LP:WaitForChild("Data"):WaitForChild("WorldMissions"):WaitForChild("Lobby"):WaitForChild("Missions"):WaitForChild("RidingRing")
    if missionStatus.Value == true then return true end
 
 
    for i, targetPos in ipairs(RingWaypoints) do
        if missionStatus.Value == true then return true end
        if i == 1 then
            teleportTo(CFrame.new(targetPos))
            task.wait(0.3)
        else
            if flyTo(targetPos, missionStatus) then return true end
        end
    end
    return missionStatus.Value == true
end
 
