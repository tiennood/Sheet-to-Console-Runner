local function runScript2()
    ---///--- BẮT ĐẦU PASTE 2.txt TỪ ĐÂY ---///---
--// =========================================
--// SMART FAST LOAD GATE V4
--// Ultra Fast + Stable + Fail Safe
--// =========================================
 
local LoadGate = {}
 
-- ========= CONFIG =========
local CONFIG = {
 
CHECK_INTERVAL = 0.4, -- Tần suất kiểm tra
STABLE_REQUIRED = 2, -- Cần ổn định 2s
MAX_DELTA = 60, -- Dao động cho phép
GRACE_DELAY = 1, -- Đợi thêm sau khi ổn định
TIMEOUT = 35, -- Timeout tổng
 
USE_MAP_FOLDER = true, -- Nếu có folder "Map" thì chỉ đếm trong đó
EARLY_RELEASE_RATIO = 0.8, -- 80% peak là đủ
 
AUTO_REJOIN_ON_TIMEOUT = false -- bật true nếu muốn auto teleport
}
 
-- ========= UTIL =========
 
local function engineReady()
if not game:IsLoaded() then
game.Loaded:Wait()
end
end
 
local function playerReady()
local Players = game:GetService("Players")
local player = Players.LocalPlayer
 
while not player.Character or not player.Character.Parent do
player.CharacterAdded:Wait()
end
 
player.Character:WaitForChild("HumanoidRootPart", 10)
end
 
local function getTargetFolder()
if CONFIG.USE_MAP_FOLDER then
local map = workspace:FindFirstChild("Map")
if map then
return map
end
end
return workspace
end
 
-- ========= CORE =========
 
function LoadGate:WaitUntilStable()
 
engineReady()
playerReady()
 
local startTime = tick()
local stableTime = 0
 
local targetFolder = getTargetFolder()
 
local function getCount()
return #targetFolder:GetDescendants()
end
 
local lastCount = getCount()
local peakCount = lastCount
 
while true do
task.wait(CONFIG.CHECK_INTERVAL)
 
local currentCount = getCount()
local delta = math.abs(currentCount - lastCount)
 
-- Cập nhật peak
if currentCount > peakCount then
peakCount = currentCount
end
 
-- Early plateau detection
if currentCount >= peakCount * CONFIG.EARLY_RELEASE_RATIO
and delta <= CONFIG.MAX_DELTA then
 
stableTime += CONFIG.CHECK_INTERVAL
else
stableTime = 0
end
 
-- Đủ ổn định
if stableTime >= CONFIG.STABLE_REQUIRED then
break
end
 
-- Timeout xử lý
if tick() - startTime > CONFIG.TIMEOUT then
 
if CONFIG.AUTO_REJOIN_ON_TIMEOUT then
local TeleportService = game:GetService("TeleportService")
TeleportService:Teleport(game.PlaceId)
end
 
break
end
 
lastCount = currentCount
end
 
task.wait(CONFIG.GRACE_DELAY)
end
 
