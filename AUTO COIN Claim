-- Xử lý ESP khi người chơi xuất hiện
local function SetupESP(player)
    if player == LocalPlayer then return end
    local function onCharacterAdded(character)
        if not character then return end
        local highlight = character:FindFirstChild("NexusHi") or Instance.new("Highlight", character)
        highlight.Name = "NexusHi"
        highlight.FillColor = Color3.fromRGB(0, 150, 255)
        highlight.OutlineColor = Color3.new(1, 1, 0)
        highlight.Enabled = Settings.playerESP
        
        local head = character:WaitForChild("Head", 5)
        if head and not character:FindFirstChild("NexusName") then
            local billboard = Instance.new("BillboardGui", character)
            billboard.Name = "NexusName"
            billboard.Adornee = head
            billboard.Size = UDim2.new(0, 100, 0, 30)
            billboard.StudsOffset = Vector3.new(0, 1.5, 0)
            billboard.AlwaysOnTop = true
            billboard.Enabled = Settings.playerESP
            
            local nameLabel = Instance.new("TextLabel", billboard)
            nameLabel.Size = UDim2.new(1, 0, 1, 0)
            nameLabel.Text = player.Name
            nameLabel.TextColor3 = Color3.new(1, 1, 1)
            nameLabel.TextSize = 14
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.BackgroundTransparency = 1
        end
    end
    player.CharacterAdded:Connect(onCharacterAdded)
    if player.Character then onCharacterAdded(player.Character) end
end

for _, player in ipairs(Players:GetPlayers()) do
    task.spawn(SetupESP, player)
end
Players.PlayerAdded:Connect(SetupESP)

-- Tìm kiếm coin và ring
local function FindClosestRing(rootPart)
    local closest, dist = nil, math.huge
    for _, part in ipairs(workspace:GetDescendants()) do
        if part:IsA("BasePart") and not farmedRings[part] then
            local isRing = (part.Color.R > 0.5 and part.Color.G > 0.5 and part.Color.B < 0.5) or
                           string.find(part.Name:lower(), "ring") or string.find(part.Name:lower(), "target")
            if isRing and part.Transparency < 0.01 and not part.CanCollide then
                local d = (rootPart.Position - part.Position).Magnitude
                if d < dist then
                    dist = d
                    closest = part
                end
            end
        end
    end
    return closest
end

-- Main loop tự động farm
task.spawn(function()
    while task.wait(0.05) do  -- giảm tần suất để ổn định hơn
        local character = LocalPlayer.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        if not rootPart then continue end
        
        if Settings.coinFarm then
            local closestCoin = nil
            local minDist = math.huge
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("BasePart") and string.find(obj.Name, "Coin") and not farmedCoins[obj] then
                    local d = (rootPart.Position - obj.Position).Magnitude
                    if d < minDist then
                        minDist = d
                        closestCoin = obj
                    end
                end
            end
            if closestCoin then
                farmedCoins[closestCoin] = true
                rootPart.Velocity = Vector3.zero
                rootPart.CFrame = closestCoin.CFrame
                task.wait(0.1)
            else
                farmedCoins = {}
            end
        elseif Settings.ringFarm then
            local ring = FindClosestRing(rootPart)
            if ring then
                farmedRings[ring] = true
                rootPart.Velocity = Vector3.zero
                rootPart.CFrame = ring.CFrame
                task.wait(0.2)
            elseif next(farmedRings) then
                task.wait(0.5)
                farmedRings = {}
            end
        end
    end
end)

