-- Hàm cập nhật ESP
local function UpdateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        local char = player.Character
        if char then
            local highlight = char:FindFirstChild("NexusHi")
            if highlight then highlight.Enabled = Settings.playerESP end
            local nameTag = char:FindFirstChild("NexusName")
            if nameTag then nameTag.Enabled = Settings.playerESP end
        end
    end
end

