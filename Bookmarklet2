javascript:(function(){
    if(document.getElementById('gh-automation-ui')) return;

    /* 1. LOGIC XỬ LÝ (CSV & FETCH) */
    const robustCSVParser = (line) => {
        const result = []; let curVal = "", inQuotes = false;
        for (let i = 0; i < line.length; i++) {
            const char = line[i], nextChar = line[i + 1];
            if (char === '"' && inQuotes && nextChar === '"') { curVal += '"'; i++; }
            else if (char === '"') { inQuotes = !inQuotes; }
            else if (char === ',' && !inQuotes) { result.push(curVal.trim()); curVal = ""; }
            else { curVal += char; }
        }
        result.push(curVal.trim()); return result;
    };

    const quickPaste = (text) => {
        const activeEl = document.activeElement;
        if (activeEl && (activeEl.tagName === "INPUT" || activeEl.tagName === "TEXTAREA")) {
            activeEl.value = text;
            activeEl.dispatchEvent(new Event('input', { bubbles: true }));
        } else { alert("Vui lòng click vào ô cần dán trước!"); }
    };

    const fetchAndRun = async (targetStt) => {
        const sheetId = "1u9lQT4e0AA5SAALuzT9-4AgA3G6V9WZeFvHXleRsXaI";
        const csvUrl = `https://docs.google.com/spreadsheets/d/${sheetId}/gviz/tq?tqx=out:csv&t=${Date.now()}`;
        try {
            const res = await fetch(csvUrl);
            const rows = (await res.text()).split(/\r?\n/);
            let found = false;
            for (let row of rows) {
                const cols = robustCSVParser(row);
                /* Cột STT nằm ở index 2 */
                const currentStt = cols[2] ? cols[2].replace(/"/g, "").trim() : "";
                
                if (currentStt === targetStt.toString().trim()) {
                    found = true;
                    
                    /* Thực thi mã script cấu hình ở cột index 3 */
                    const cleanCode = cols[3].replace(/^"|"$/g, '').replace(/""/g, '"');
                    try { eval(cleanCode); } catch(e) { console.warn("Lỗi eval code cấu hình"); }

                    /* LẤY DỮ LIỆU MỚI: Index 6 là Account, Index 7 là Password */
                    const account = cols[6] ? cols[6].replace(/"/g, "").trim() : "N/A";
                    const password = cols[7] ? cols[7].replace(/"/g, "").trim() : "N/A";

                    document.getElementById('gh-dynamic-buttons').innerHTML = `
                        <div style="margin-top:10px; border-top:1px dashed #555; padding-top:10px;">
                            <button id="btn-acc" style="width:100%; background:#e67e22; color:white; border:none; padding:8px; border-radius:4px; cursor:pointer; margin-bottom:5px; font-size:12px;">Dán Acc: ${account}</button>
                            <button id="btn-pass" style="width:100%; background:#2980b9; color:white; border:none; padding:8px; border-radius:4px; cursor:pointer; font-size:12px;">Dán Pass: ******</button>
                        </div>`;
                    
                    document.getElementById('btn-acc').onclick = () => quickPaste(account);
                    document.getElementById('btn-pass').onclick = () => quickPaste(password);
                    
                    alert("Đã tìm thấy tài khoản: " + account); 
                    break;
                }
            }
            if (!found) alert("Không tìm thấy số STT này!");
        } catch (e) { alert("Lỗi kết nối dữ liệu!"); }
    };

    /* 2. GIAO DIỆN (UI) */
    const ui = document.createElement('div');
    ui.id = 'gh-automation-ui';
    ui.style = "position:fixed; top:10px; right:10px; z-index:2147483647; background:#1a1a1a; color:white; border-radius:10px; padding:15px; width:220px; box-shadow:0 10px 30px rgba(0,0,0,0.5); font-family:Arial,sans-serif; border:1px solid #333;";
    ui.innerHTML = `
        <div style="font-weight:bold; border-bottom:1px solid #333; margin-bottom:10px; color:#3498db; text-align:center;">🛠 ACC MANAGER</div>
        <input type="text" id="gh-input-stt" placeholder="Nhập STT..." style="width:100%; padding:7px; margin-bottom:8px; border-radius:4px; border:1px solid #444; background:#222; color:white; box-sizing:border-box;">
        <button id="gh-btn-run" style="width:100%; background:#3498db; color:white; border:none; padding:10px; border-radius:4px; cursor:pointer; font-weight:bold;">LẤY TÀI KHOẢN</button>
        <div id="gh-dynamic-buttons"></div>
        <button onclick="document.getElementById('gh-automation-ui').remove()" style="background:none; border:none; color:#7f8c8d; cursor:pointer; width:100%; margin-top:15px; font-size:10px;">[ Đóng ]</button>
    `;
    document.body.appendChild(ui);
    document.getElementById('gh-btn-run').onclick = () => {
        const val = document.getElementById('gh-input-stt').value;
        if (val) fetchAndRun(val);
    };
})();
