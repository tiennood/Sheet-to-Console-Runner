-- =================================================================================
-- HÀM GỬI REQUEST POST PHƯƠNG THỨC MỚI (JSON BODY)
-- =================================================================================
local function apiCall(data_table)
    local success, res = pcall(function()
        return req({
            Url = SHEETS_URL,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json" -- Khai báo dữ liệu JSON
            },
            Body = HttpService:JSONEncode(data_table) -- Đóng gói data gửi ẩn vào Body
        })
    end)
    if success and res and res.Body then return res.Body end
    return nil
end

local function getQueue()
    local body = apiCall({ action = "getQueue" })
    if body then return HttpService:JSONDecode(body) end
    return nil
end

local function setCoin(user, coin)
    apiCall({ action = "setCoin", user = user, coin = coin })
end

