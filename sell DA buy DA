-- Hàm phụ tìm kiếm sạp quầy hàng (Booth) của người bán trong khu chợ Undercity công cộng
local function findSellerBooth(sellerName)
    local boothsFolder = game:GetService("Workspace"):WaitForChild("Map", 20)
        and game:GetService("Workspace").Map:WaitForChild("Undercity", 10)
        and game:GetService("Workspace").Map.Undercity:WaitForChild("PlayerBooths", 10)
    
    if not boothsFolder then return nil end

    for _, booth in ipairs(boothsFolder:GetChildren()) do
        local ownerVal = booth:FindFirstChild("Owner")
        if ownerVal and ownerVal.Value and ownerVal.Value.Name:lower() == sellerName:lower() then
            return booth
        end
    end
    return nil
end

-- HÀM MUA HÀNG GỐC CỦA SOUR.LUA (BỎ CHỖ CHÈN - ĐÃ HOÀN THÀNH!)
local function runScript3(sellerName)
    print(string.format("[ACTUAL-GAMEPLAY] 💸 Đang định vị vị trí quầy hàng của: %s để mua sỉ...", sellerName))
    
    local targetBooth = findSellerBooth(sellerName)
    if not targetBooth then
        warn(string.format("[ACTUAL-GAMEPLAY] ❌ Không tìm thấy quầy nào của %s đang mở!", sellerName))
        return false
    end

    local boothModel = targetBooth:FindFirstChild("BoothModel")
    if not boothModel or not boothModel:FindFirstChild("HumanoidRootPart") then
        warn("[ACTUAL-GAMEPLAY] ❌ Quầy hàng của đối phương bị lỗi cơ cấu vật lý hình khối!")
        return false
    end

    -- Di chuyển nhân vật đứng sát vào quầy hàng của Seller cần hút coin
    local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = boothModel.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
        task.wait(0.5)
    end

    -- Thực hiện gọi liên tiếp chuỗi lệnh Remote gốc để quét sạch đồ trên kệ
    local buySuccess = false
    pcall(function()
        -- Lệnh 1: Gửi tín hiệu mở tương tác giao dịch với Quầy hàng cụ thể
        CONFIG.MARKET_REMOTE:InvokeServer("Interact", targetBooth)
        task.wait(0.3)

        -- Lệnh 2: Quét qua tất cả danh sách các sản phẩm đang treo trên sạp quầy hàng đó
        local listings = targetBooth:FindFirstChild("Listings")
        if listings then
            for _, item in ipairs(listings:GetChildren()) do
                -- Gọi lệnh sút mua trực tiếp bằng ID của món hàng (Cơ chế Remote gốc trong SOUR.lua)
                CONFIG.MARKET_REMOTE:InvokeServer("BuyItem", targetBooth, item.Name)
                print(string.format("[ACTUAL-GAMEPLAY] ✅ Đã sút mua thành công Item ID: %s từ %s", item.Name, sellerName))
                buySuccess = true
                task.wait(0.1)
            end
        end
    end)

    return buySuccess
end

