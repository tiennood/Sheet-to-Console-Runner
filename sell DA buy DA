-- BỘ NÃO ĐIỀU PHỐI: QUÉT DANH SÁCH POST ĐỂ RA QUYẾT ĐỊNH MUA
task.spawn(function()
    print("[POST-CHAIN] 🚀 Tiến trình quét chuỗi tịnh tiến Index bằng POST đã hoạt động!")
    
    while true do
        local queue = getQueue()
        
        if queue and #queue >= 2 then
            for i = 1, #queue - 1 do
                local accA = queue[i]     -- Acc trước (Cấp tiền)
                local accB = queue[i + 1] -- Acc sau (Nhận tiền)

                -- Nếu tên mình là AccB đứng sau, và quét thấy trên Sheet báo AccA có tiền mặt dư:
                if LP.Name:lower() == accB.user:lower() and accA.coin > 0 then
                    
                    print(string.format("[POST-CHAIN] 🎯 Phát hiện mục tiêu: %s (Index %d) có %d Coins.", accA.user, accA.index, accA.coin))
                    print(string.format("[POST-CHAIN] 🛒 Thực hiện hành động: Tôi (%s) tiến hành mua đồ từ quầy %s", LP.Name, accA.user))
                    
                    local transferValue = accA.coin
                    
                    -- Kích hoạt hành động mua cơ học trong game
                    local successBuy, buyErr = pcall(function()
                        runScript3(accA.user)
                    end)
                    
                    if successBuy then
                        print("[POST-CHAIN] ✅ Đã sút mua xong! Tiến hành cập nhật số liệu lên trang [POST] Webhook...")
                        
                        -- Bước 1: Trừ số coin của acc trước về 0 lập tức để đóng băng chuỗi
                        setCoin(accA.user, 0)
                        task.wait(0.5)
                        
                        -- Bước 2: Cộng dồn tiền mặt vào tài khoản của bản thân
                        local myNewBalance = accB.coin + transferValue
                        setCoin(LP.Name, myNewBalance)
                        
                        print(string.format("[POST-CHAIN] 🎉 Chuyển dịch hoàn tất! Ví của tôi trên Sheet: %d Coins.", myNewBalance))
                    else
                        warn("[POST-CHAIN] ❌ Thao tác mua bị lỗi game: ", buyErr)
                    end
                    
                    task.wait(2)
                end
            end
        end
        
        task.wait(5) -- Định kỳ 5 giây gửi POST quét toàn bộ chuỗi một lần
    end
end)
