local SHEETS_URL = "local SHEETS_URL = "https://script.google.com/macros/s/AKfycbyFa5a5S5BFXMfpQeiJUmc9ANfUMlQPfEU-_xxwTvbO9vf-rs_UL9eYyvgfG9dCk59Q/exec""
local HttpService = game:GetService("HttpService")
local req = (syn and syn.request) or request or http_request
local LP = game:GetService("Players").LocalPlayer

local MAX_COINS = 100000000 -- 100M giới hạn an toàn của Seller
_G.COINS_MAXED = false      

local CONFIG = {
    UNDERCITY_ID = 4601778915,
    MARKET_REMOTE = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("PlayerMarketRemote")
}

-- Đảm bảo Character nhân vật đã tải xong hoàn toàn
while not LP.Character or not LP.Character.Parent do LP.CharacterAdded:Wait() end
LP.Character:WaitForChild("HumanoidRootPart", 30)
task.wait(1)

print("[SYSTEM] ⚙️ Khởi chạy tài khoản: " .. LP.Name)

-- ==========================================
-- CÁC HÀM API KẾT NỐI GOOGLE SHEET
-- ==========================================
local function apiCall(params)
    local success, res = pcall(function()
        return req({ Url = SHEETS_URL .. params, Method = "GET" })
    end)
    if success and res and res.Body then return res.Body end
    return nil
end

local function getQueue()
    local body = apiCall("?action=getQueue")
    if body then return HttpService:JSONDecode(body) end
    return nil
end

local function setCoin(user, coin)
    apiCall("?action=setCoin&user=" .. user .. "&coin=" .. tostring(coin))
end

-- ==========================================
-- LUỒNG ĐỒNG BỘ COIN REALTIME (CỦA CHÍNH MÌNH)
-- ==========================================
task.spawn(function()
    while true do
        pcall(function()
            local dataFolder = LP:ClearCharacterAppearanceBeforeInstance() or LP:WaitForChild("Data", 10)
            local coinsObj = dataFolder:WaitForChild("Currency", 10):WaitForChild("Coins", 10)
            if coinsObj then
                setCoin(LP.Name, coinsObj.Value)
            end
        end)
        task.wait(5)
    end
end)

-- Sau khi chạy, kiểm tra xem acc có chạm mốc tối đa hay không để dừng bán tạm thời
task.spawn(function()
    while true do
        pcall(function()
            local dataFolder = LP:WaitForChild("Data", 10)
            local coinsObj = dataFolder:WaitForChild("Currency", 10):WaitForChild("Coins", 10)
            if coinsObj and coinsObj.Value >= MAX_COINS then
                _G.COINS_MAXED = true
            else
                _G.COINS_MAXED = false
            end
        end)
        task.wait(5)
    end
end)


-- =================================================================================
-- 🏪 VÙNG CHỨA TÍNH NĂNG SELLER V7 (HÀM BÁN ĐỒ & NHẬN TIỀN VẬT LÝ)
-- =================================================================================
local function getInventoryItems()
    local items = {}
    pcall(function()
        local inv = LP:WaitForChild("Data", 10):WaitForChild("Inventory", 10)
        for _, item in ipairs(inv:GetChildren()) do
            if item:IsA("NumberValue") and item.Value > 0 then
                table.insert(items, { Name = item.Name, Amount = item.Value })
            end
        end
    end)
    return items
end

local function sellItem()
    pcall(function()
        local inventory = getInventoryItems()
        if #inventory == 0 then return end
        
        table.sort(inventory, function(a, b) return a.Amount > b.Amount end)
        local target = inventory[1]
        
        local currentPrice = 99999
        if target.Name:lower():find("apple") then currentPrice = 110 end

        local args = {
            [1] = "Publish",
            [2] = { ["Price"] = currentPrice, ["ItemName"] = target.Name, ["Amount"] = 1 }
        }
        CONFIG.MARKET_REMOTE:InvokeServer(unpack(args))
    end)
end

local function claimMarket()
    pcall(function()
        CONFIG.MARKET_REMOTE:InvokeServer(unpack({ [1] = "ClaimAll" }))
    end)
end

-- Khởi động luồng lặp tự động treo Kệ Bán và thu gom tiền của SELLER (chỉ chạy khi ở chợ Chợ Undercity)
task.spawn(function()
    while true do
        if game.PlaceId == CONFIG.UNDERCITY_ID then
            pcall(function()
                claimMarket() -- Thao tác nhận tiền mặt trong game
                task.wait(0.3)
                
                if not _G.COINS_MAXED then
                    for _ = 1, 5 do
                        sellItem() -- Thao tác đăng bán đồ lên quầy chợ
                        task.wait(0.1)
                    end
                end
            end)
        end
        task.wait(2)
    end
end)


