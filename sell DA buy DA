-- =================================================================================
-- HÀM KẾT NỐI API QUA URL GET (TỐI ƯU HOÀN HẢO CHO DELTA)
-- =================================================================================
local function apiCall(queryString)
    local success, res = pcall(function()
        return delta_request({
            Url = SHEETS_URL .. queryString,
            Method = "GET"
        })
    end)
    if success and res and res.Body then return res.Body end
    return nil
end

local function getQueue()
    local body = apiCall("?action=getQueue")
    if body then 
        local success, decoded = pcall(function() return HttpService:JSONDecode(body) end)
        if success then return decoded end
    end
    return nil
end

local function setCoin(user, coin)
    -- Encode khoảng trắng tên nếu có để tránh lỗi URL
    local encodedUser = game:GetService("HttpService"):UrlEncode(user)
    apiCall("?action=setCoin&user=" .. encodedUser .. "&coin=" .. tostring(coin))
end

-- ==========================================
-- LUỒNG TỰ ĐỘNG KHAI BÁO USER VÀ COIN REALTIME LÊN SHEET
-- ==========================================
task.spawn(function()
    while true do
        pcall(function()
            local dataFolder = LP:ClearCharacterAppearanceBeforeInstance() or LP:WaitForChild("Data", 10)
            local coinsObj = dataFolder:WaitForChild("Currency", 10):WaitForChild("Coins", 10)
            if coinsObj then
                -- Tự động gửi tên mình và số coin lên sheet (Sheet sẽ tự điền vào bảng nếu chưa có)
                setCoin(LP.Name, coinsObj.Value)
                
                if coinsObj.Value >= MAX_COINS then
                    _G.COINS_MAXED = true
                else
                    _G.COINS_MAXED = false
                end
            end
        end)
        task.wait(5) -- 5 giây tự đồng bộ một lần
    end
end)

-- =================================================================================
-- LOGIC BÁN VÀ NHẬN TIỀN (SELLER V7)
-- =================================================================================
local function getInventoryItems()
    local items = {}
    pcall(function()
        local inv = LP:WaitForChild("Data", 10):WaitForChild("Inventory", 10)
        for _, item in ipairs(inv:GetChildren()) do
            if item:IsA("NumberValue") and item.Value > 0 then
                table.insert(items, { Name = item.Name, Amount = item.Value })
            end
        end
    end)
    return items
end

local function sellItem()
    pcall(function()
        local inventory = getInventoryItems()
        if #inventory == 0 then return end
        
        table.sort(inventory, function(a, b) return a.Amount > b.Amount end)
        local target = inventory[1]
        
        local currentPrice = 99999
        if target.Name:lower():find("apple") then currentPrice = 110 end

        local args = {
            [1] = "Publish",
            [2] = { ["Price"] = currentPrice, ["ItemName"] = target.Name, ["Amount"] = 1 }
        }
        CONFIG.MARKET_REMOTE:InvokeServer(unpack(args))
    end)
end

local function claimMarket()
    pcall(function()
        CONFIG.MARKET_REMOTE:InvokeServer(unpack({ [1] = "ClaimAll" }))
    end)
end

task.spawn(function()
    while true do
        if game.PlaceId == CONFIG.UNDERCITY_ID then
            pcall(function()
                claimMarket()
                task.wait(0.3)
                if not _G.COINS_MAXED then
                    for _ = 1, 5 do
                        sellItem()
                        task.wait(0.1)
                    end
                end
            end)
        end
        task.wait(2)
    end
end)

-- =================================================================================
-- LOGIC TÌM QUẦY VÀ THỰC THI MUA HÀNG VẬT LÝ GỐC TỪ SOUR.LUA
-- =================================================================================

local function findSellerBooth(sellerName)
    local boothsFolder = game:GetService("Workspace"):FindFirstChild("Map")
        and game:GetService("Workspace").Map:FindFirstChild("Undercity")
        and game:GetService("Workspace").Map.Undercity:FindFirstChild("PlayerBooths")
    
    if not boothsFolder then return nil end

    for _, booth in ipairs(boothsFolder:GetChildren()) do
        local ownerVal = booth:FindFirstChild("Owner")
        if ownerVal and ownerVal.Value and ownerVal.Value.Name:lower() == sellerName:lower() then
            return booth
        end
    end
    return nil
end

local function runScript3(sellerName)
    print(string.format("[⚡ SOUR] Đang dò tìm vị trí quầy hàng của: %s", sellerName))
    
    local targetBooth = findSellerBooth(sellerName)
    if not targetBooth then
        warn(string.format("[⚡ SOUR] ❌ Không tìm thấy quầy nào của %s trong server!", sellerName))
        return false
    end

    local boothModel = targetBooth:FindFirstChild("BoothModel")
    if not boothModel or not boothModel:FindFirstChild("HumanoidRootPart") then
        return false
    end

    -- Di chuyển vật lý nhân vật đến trước quầy hàng
    local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = boothModel.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
        task.wait(0.5)
    end

    local buySuccess = false
    pcall(function()
        -- Gửi tín hiệu tương tác mở quầy (Interact)
        CONFIG.MARKET_REMOTE:InvokeServer("Interact", targetBooth)
        task.wait(0.3)

        -- Quét qua các món đồ đang treo trên kệ để sút mua sạch (BuyItem)
        local listings = targetBooth:FindFirstChild("Listings")
        if listings then
            for _, item in ipairs(listings:GetChildren()) do
                CONFIG.MARKET_REMOTE:InvokeServer("BuyItem", targetBooth, item.Name)
                print(string.format("[⚡ SOUR] ✅ Đã sút mua thành công món hàng ID: %s", item.Name))
                buySuccess = true
                task.wait(0.1)
            end
        end
    end)

    return buySuccess
end

