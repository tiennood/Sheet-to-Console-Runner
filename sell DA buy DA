-- LUỒNG QUẢN TRỊ CHUỖI TIỀN TỆ: TỰ ĐỘNG QUÉT VÀ ĐẨY QUYẾT ĐỊNH MUA CHO TỪNG CẤP INDEX
task.spawn(function()
    print("[CHAIN-BRAIN] 🚀 Luồng quét chuỗi tịnh tiến Index đã sẵn sàng hoạt động!")
    
    while true do
        local queue = getQueue()
        
        if queue and #queue >= 2 then
            for i = 1, #queue - 1 do
                local accA = queue[i]     -- Acc nguồn cấp tiền (Đứng trước)
                local accB = queue[i + 1] -- Acc nhận tiền (Đứng sau)

                -- KIỂM TRA ĐIỀU KIỆN MUA TRONG SERVER:
                -- Nếu TÊN TÀI KHOẢN HIỆN TẠI chính là AccB (Acc sau) và phát hiện AccA (Acc liền trước) đang có tiền mặt dư trên Sheet
                if LP.Name:lower() == accB.user:lower() and accA.coin > 0 then
                    
                    print(string.format("[CHAIN-BRAIN] 🔥 Phát hiện số dư! Index %d (%s) đang giữ %d Coins.", accA.index, accA.user, accA.coin))
                    print(string.format("[CHAIN-BRAIN] 🛒 Hành động: Tôi (%s) tiến hành mua đồ từ %s!", LP.Name, accA.user))
                    
                    local transferValue = accA.coin
                    
                    -- Kích hoạt hành động mua vật lý thực tế trong game
                    local successBuy, buyErr = pcall(function()
                        runScript3(accA.user)
                    end)
                    
                    if successBuy then
                        print(string.format("[CHAIN-BRAIN] ✅ Mua thành công! Tiến hành cập nhật trạng thái số liệu..."))
                        
                        -- Bước 1: Khóa/Trừ số coin của tài khoản trước về 0 trên Sheet ngay lập tức
                        setCoin(accA.user, 0)
                        task.wait(0.5)
                        
                        -- Bước 2: Gom toàn bộ tiền mặt dồn sang tài khoản của mình trên Sheet
                        local myNewBalance = accB.coin + transferValue
                        setCoin(LP.Name, myNewBalance)
                        
                        print(string.format("[CHAIN-BRAIN] 🎉 Dịch chuyển quỹ hoàn tất! Số dư mới trên hệ thống: %d Coins.", myNewBalance))
                    else
                        warn("[CHAIN-BRAIN] ❌ Thao tác mua bị lỗi cơ học trong game: ", buyErr)
                    end
                    
                    task.wait(2) -- Nghỉ giãn cách tránh nghẽn luồng
                end
            end
        end
        
        task.wait(5) -- 5 giây rà soát lại toàn bộ chuỗi hàng dọc một lần
    end
end)
