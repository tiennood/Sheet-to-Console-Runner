if not game:IsLoaded() then game.Loaded:Wait() end
task.wait(3)

-- 🔴 DÁN ĐOẠN LINK WEB APP URL MỚI CỦA BẠN VÀO ĐÂY
local SHEETS_URL = "https://script.google.com/macros/s/AKfycbyribuFmeOwq-G2oQWElqw7PbE1JYj_72vidGmXgX5fsDqeN95-J-K9c42Du2XbMYc_/exec"

local HttpService = game:GetService("HttpService")
local LP = game:GetService("Players").LocalPlayer
local delta_request = (syn and syn.request) or request or http_request or (http and http.request)

local MAX_COINS = 100000000 -- 100M chặn tối đa của Seller
_G.COINS_MAXED = false

local CONFIG = {
    UNDERCITY_ID = 4601778915,
    MARKET_REMOTE = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("PlayerMarketRemote")
}

while not LP.Character or not LP.Character.Parent do LP.CharacterAdded:Wait() end
