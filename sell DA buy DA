local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

-- Cấu hình mặc định hệ thống
local CONFIG = {
    ITEM_NAME = "Apple",
    ITEM_TYPE = "Resources",
    ITEM_AMOUNT = 1, 
    ITEM_PRICE = 0,
    TARGET_BUYER_NAMES = {},
    CLAIM_SPEED = 0.3,
    isChainRunning = false
}

-- =================================================================================
-- LOGIC FUNCTIONS (MARKET CHAIN)
-- =================================================================================
local function sellItem()
    ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("SellPlayerMarketRemote"):InvokeServer({
        Price = CONFIG.ITEM_PRICE,
        ItemType = CONFIG.ITEM_TYPE,
        Name = CONFIG.ITEM_NAME,
        Amount = CONFIG.ITEM_AMOUNT
    })
end

local function claimCoins(slotIndex)
    ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ClaimPlayerMarketRemote"):FireServer(tostring(slotIndex))
end

-- Hàm kích hoạt chạy chuỗi lấy dữ liệu từ TextBox
local function startMarketChain(jsonString)
    if CONFIG.isChainRunning then return end
    
    if jsonString == "" or jsonString == "Dán chuỗi JSON vào đây trước khi chạy..." then
        warn("[HỆ THỐNG] ❌ Vui lòng nhập/dán chuỗi JSON vào ô trống trước!")
        return false
    end

    print("[HỆ THỐNG] Đang tiến hành phân tích cú pháp JSON vừa nhập...")

    -- Phân tích dữ liệu nhập từ TextBox
    local parseSuccess, parsedData = pcall(function() return HttpService:JSONDecode(jsonString) end)
    if parseSuccess and parsedData then
        local matched = false
        for _, item in ipairs(parsedData) do
            if item.user == player.Name then
                CONFIG.ITEM_PRICE = tonumber(item.ITEM_PRICE) or 0
                if item.BUYER_NAMES and item.BUYER_NAMES ~= "" then
                    CONFIG.TARGET_BUYER_NAMES = { item.BUYER_NAMES }
                end
                matched = true break
            end
        end
        if not matched then 
            warn("[HỆ THỐNG] ❌ Tài khoản này (".. player.Name ..") không có tên trong JSON vừa nhập!") 
            return false 
        end
    else
        warn("[HỆ THỐNG] ❌ Chuỗi văn bản nhập vào không đúng cấu trúc định dạng JSON!") 
        return false
    end

    CONFIG.isChainRunning = true
    print(">>> [MARKET] KÍCH HOẠT THÀNH CÔNG CHUỖI CHO: " .. player.Name)

    -- Luồng 1: Tự động gom hàng của acc trước
    task.spawn(function()
        local activePurchases = {}
        while true do
            if CONFIG.TARGET_BUYER_NAMES and #CONFIG.TARGET_BUYER_NAMES > 0 then
                for _, name in ipairs(CONFIG.TARGET_BUYER_NAMES) do
                    if name ~= "" and Players:FindFirstChild(name) and not activePurchases[name] then
                        activePurchases[name] = true
                        task.spawn(function()
                            local pRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("PurchasePlayerMarketRemote", 10)
                            while Players:FindFirstChild(name) do
                                for i = 1, 5 do
                                    pcall(function()
                                        if pRemote:IsA("RemoteFunction") then pRemote:InvokeServer({ Index = tostring(i), Player = Players[name] })
                                        else pRemote:FireServer({ Index = tostring(i), Player = Players[name] }) end
                                        task.wait(CONFIG.CLAIM_SPEED)
                                    end)
                                end
                                task.wait(0.5)
                            end
                            activePurchases[name] = nil
                        end)
                    end
                end
            end
            task.wait(5)
        end
    end)

    -- Luồng 2: Treo bán và tự động claim tiền (Mỗi 2 giây)
    task.spawn(function()
        while true do
            pcall(function()
                local playerMarket = player:WaitForChild("Data"):WaitForChild("PlayerMarket")
                for i = 1, 5 do
                    local slot = playerMarket:FindFirstChild(tostring(i))
                    if slot and slot:FindFirstChild("Purchased") and slot.Purchased.Value == true then
                        claimCoins(i)
                    end
                end
                if CONFIG.ITEM_PRICE > 0 then
                    task.spawn(function() for _ = 1, 5 do sellItem() task.wait(0.1) end end)
                end
            end)
            task.wait(2)
        end
    end)
    return true
end

