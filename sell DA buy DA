-- ===== FORMAT NUMBER =====
local function formatNumber(n)
    local s = tostring(n)
    while true do
        local k
        s, k = s:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
        if k == 0 then
            break
        end
    end
    return s
end

