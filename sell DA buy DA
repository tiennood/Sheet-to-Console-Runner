--[[
================================================================================
A-SC 99% — DYNAMIC MARKET CHAIN (ULTRA CLEAN & OPTIMIZED)
- Cố định vật phẩm: Apple (Số lượng: 1)
- Tự động nhận diện cấu hình theo tên tài khoản từ JSON
- CHỈ GIỮ LUỒNG: MUA CHUỖI, TREO CHỢ VÀ TỰ CLAIM TIỀN (KHÔNG TELEPORT, KHÔNG UI)
- UPDATE: Nếu ITEM_PRICE = 0 -> KHÔNG TREO BÁN ĐỒ
================================================================================
]]
wait(5);

-- 🛑 NHẬP CHUỒI JSON CỦA BẠN TẠI ĐÂY
local JSON_INPUT = [[
[
  {"user":"XWC_KhxI1623","BUYER_NAMES":"DUB_oi6H1148","ITEM_PRICE":"0"},{"user":"DUB_oi6H1148","BUYER_NAMES":"CQX_axki4284","ITEM_PRICE":"216919"},{"user":"CQX_axki4284","BUYER_NAMES":"DBQ_zNTe5938","ITEM_PRICE":"374782"},{"user":"DBQ_zNTe5938","BUYER_NAMES":"LDD_MZFW5606","ITEM_PRICE":"692568"},{"user":"LDD_MZFW5606","BUYER_NAMES":"NCM_y6Ts4612","ITEM_PRICE":"1146391"},{"user":"NCM_y6Ts4612","BUYER_NAMES":"","ITEM_PRICE":"1476981"}
]
]]

-- =================================================================================
-- DYNAMIC CONFIGURATION (TỰ ĐỘNG KHỚP CONFIG TỪ JSON)
-- =================================================================================
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Cấu hình vật phẩm cố định Apple số lượng 1
local CONFIG = {
    ITEM_NAME = "Apple",
    ITEM_TYPE = "Resources",
    ITEM_AMOUNT = 1, 
    ITEM_PRICE = 0,          -- Sẽ nạp từ JSON
    TARGET_BUYER_NAMES = {}, -- Sẽ nạp từ JSON
    CLAIM_SPEED = 0.3,
    SELL_SPEED = 0.3,
}

-- Tiến hành quét thông tin tài khoản từ chuỗi JSON
local parseSuccess, parsedData = pcall(function()
    return HttpService:JSONDecode(JSON_INPUT)
end)

if parseSuccess and parsedData then
    local matched = false
    for _, item in ipairs(parsedData) do
        if item.user == LocalPlayer.Name then
            CONFIG.ITEM_PRICE = tonumber(item.ITEM_PRICE) or 0
            
            -- Thiết lập luồng mua dựa trên BUYER_NAMES
            if item.BUYER_NAMES and item.BUYER_NAMES ~= "" then
                CONFIG.TARGET_BUYER_NAMES = { item.BUYER_NAMES }
                if CONFIG.ITEM_PRICE > 0 then
                    print(("[HỆ THỐNG] Acc: %s | Sẽ đi MUA của: %s | Treo BÁN giá: %d"):format(LocalPlayer.Name, item.BUYER_NAMES, CONFIG.ITEM_PRICE))
                else
                    print(("[HỆ THỐNG] Acc: %s | Sẽ đi MUA của: %s | ❌ KHÔNG TREO BÁN (Giá bằng 0)"):format(LocalPlayer.Name, item.BUYER_NAMES))
                end
            else
                CONFIG.TARGET_BUYER_NAMES = {}
                if CONFIG.ITEM_PRICE > 0 then
                    print(("[HỆ THỐNG] Acc CUỐI CÙNG: %s | Không mua của ai | CHỈ TREO BÁN giá: %d"):format(LocalPlayer.Name, CONFIG.ITEM_PRICE))
                else
                    print(("[HỆ THỐNG] Acc CUỐI CÙNG: %s | ❌ KHÔNG MUA - KHÔNG BÁN (Giá bằng 0)"):format(LocalPlayer.Name))
                end
            end
            matched = true
            break
        end
    end
    if not matched then
        warn("[HỆ THỐNG] ❌ Tên tài khoản này không nằm trong cấu hình JSON!")
    end
else
    warn("[HỆ THỐNG] ❌ Lỗi phân tích cú pháp chuỗi JSON!")
end

-- =================================================================================
-- SERVICES & REMOTES
-- =================================================================================
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function sellItem()
    ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("SellPlayerMarketRemote"):InvokeServer({
        Price = CONFIG.ITEM_PRICE,
        ItemType = CONFIG.ITEM_TYPE,
        Name = CONFIG.ITEM_NAME,
        Amount = CONFIG.ITEM_AMOUNT
    })
end

local function claimCoins(slotIndex)
    ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ClaimPlayerMarketRemote"):FireServer(tostring(slotIndex))
end

-- =================================================================================
-- MAIN LOOP RUNNER
-- =================================================================================
local function runSellerLoop()
    print(">>> [MARKET] Bắt đầu kích hoạt luồng xử lý Chợ cho: " .. LocalPlayer.Name)

    -- LUỒNG 1: TỰ ĐỘNG MUA CỦA USER ĐƯỢC CHỈ ĐỊNH TRONG CHUỖI JSON
    task.spawn(function()
        local activePurchases = {}
        while true do
            if CONFIG.TARGET_BUYER_NAMES and #CONFIG.TARGET_BUYER_NAMES > 0 then
                for _, name in ipairs(CONFIG.TARGET_BUYER_NAMES) do
                    if name ~= "" then
                        local targetPlayer = Players:FindFirstChild(name)
                        if targetPlayer and not activePurchases[name] then
                            activePurchases[name] = true
                            
                            task.spawn(function()
                                print("[CHỢ] 🛒 Đã thấy " .. name .. " vào server! Bắt đầu mua dọn Market...")
                                local purchaseMarketRemote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("PurchasePlayerMarketRemote", 10)
                                
                                if purchaseMarketRemote then
                                    while Players:FindFirstChild(name) do
                                        for i = 1, 5 do
                                            pcall(function()
                                                if purchaseMarketRemote:IsA("RemoteFunction") then
                                                    purchaseMarketRemote:InvokeServer({ Index = tostring(i), Player = targetPlayer })
                                                else
                                                    purchaseMarketRemote:FireServer({ Index = tostring(i), Player = targetPlayer })
                                                end
                                                task.wait(CONFIG.CLAIM_SPEED)
                                            end)
                                        end
                                        task.wait(0.5)
                                    end
                                end
                                print("[CHỢ] ❌ Player " .. name .. " đã rời phòng, dừng luồng mua.")
                                activePurchases[name] = nil
                            end)
                        end
                    end
                end
            end
            task.wait(5)
        end
    end)

    -- LUỒNG 2: LIÊN TỤC QUÉT ĐỂ TREO BÁN SẢN PHẨM VÀ TỰ ĐỘNG CLAIM TIỀN VỀ (MỖI 2 GIÂY)
    task.spawn(function()
        while true do
            local success, err = pcall(function()
                local dataFolder = LocalPlayer:FindFirstChild("Data")
                if not dataFolder then return end

                local playerMarket = dataFolder:FindFirstChild("PlayerMarket")
                if playerMarket then
                    -- Kiểm tra 5 gian hàng của bản thân, nếu có ai mua (Purchased = true) -> Auto Claim
                    for i = 1, 5 do
                        local slot = playerMarket:FindFirstChild(tostring(i))
                        if slot then
                            local purchasedNode = slot:FindFirstChild("Purchased")
                            if purchasedNode and purchasedNode.Value == true then
                                claimCoins(i)
                            end
                        end
                    end

                    -- CHỈ TIẾN HÀNH TREO BÁN NẾU GIÁ ĐỊNH HƯỚNG LỚN HƠN 0
                    if CONFIG.ITEM_PRICE > 0 then
                        task.spawn(function()
                            for _ = 1, 5 do
                                sellItem()
                                task.wait(0.1)
                            end
                        end)
                    end
                end
            end)

            if not success then warn("[CHỢ] Lỗi xử lý vòng lặp treo bán/claim: ", err) end
            task.wait(2)
        end
    end)
end

-- =================================================================================
-- BẮT ĐẦU CHẠY HỆ THỐNG
-- =================================================================================
if not game:IsLoaded() then game.Loaded:Wait() end
while not LocalPlayer.Character or not LocalPlayer.Character.Parent do LocalPlayer.CharacterAdded:Wait() end
LocalPlayer.Character:WaitForChild("HumanoidRootPart", 30)
task.wait(2)

print("[HỆ THỐNG] Nhân vật đã tải xong: " .. LocalPlayer.Name)
print("[HỆ THỐNG] Vận hành chuỗi giao dịch ngay lập tức tại map hiện tại!")
runSellerLoop()

while true do
    task.wait(60)
end
