-- LUỒNG ĐIỀU PHỐI CHUỖI TIỀN TỰ ĐỘNG
-- =================================================================================
task.spawn(function()
    print("[CHAIN] 🚀 Tiến trình rà soát chuỗi Domino bắt đầu chạy!")
    
    while true do
        local queue = getQueue()
        
        if queue and #queue >= 2 then
            for i = 1, #queue - 1 do
                local accA = queue[i]     -- Acc cấp tiền (Index đứng trước)
                local accB = queue[i + 1] -- Acc nhận tiền (Index đứng sau)

                -- Nếu tên mình là AccB (đứng sau) và thấy acc đứng trước mình đang có tiền trên Sheet
                if LP.Name:lower() == accB.user:lower() and accA.coin > 0 then
                    
                    print(string.format("[CHAIN] 🎯 Phát hiện mục tiêu: Acc %s đang giữ %d Coins.", accA.user, accA.coin))
                    
                    local transferValue = accA.coin
                    
                    -- Kích hoạt hàm mua đồ vật lý lấy từ SOUR.lua bên trên
                    local successBuy = runScript3(accA.user)
                    
                    if successBuy then
                        print("[CHAIN] ✅ Mua thành công! Đang đồng bộ số liệu dồn tiền...")
                        
                        -- Bước 1: Trừ coin của acc trước về 0
                        setCoin(accA.user, 0)
                        task.wait(0.5)
                        
                        -- Bước 2: Cộng dồn tiền vào tài khoản của mình
                        local myNewBalance = accB.coin + transferValue
                        setCoin(LP.Name, myNewBalance)
                        
                        print(string.format("[CHAIN] 🎉 Đã dồn toàn bộ tiền sang ví của tôi: %d Coins.", myNewBalance))
                    end
                    task.wait(2)
                end
            end
        end
        task.wait(5)
    end
end)
