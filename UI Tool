             if (isErrorWithNoVM || !res.oldVm) {
                  addLog("👉 Chạy mua máy tự động cho: " + textLogin);
                  await automateLoginAndBuyInParent(acc);
                  await new Promise(r => setTimeout(r, 25000));
             }
        }
        addLog("✅ Đã xử lý mua máy hàng loạt hoàn tất.");
