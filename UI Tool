// ===================== UI TOOL (đã sửa, gọi window.buyUG) =====================
(function() {
    // -------------------- CORE API (xử lý lấy VM, replace, không cần mua) --------------------
    const CoreAPI = {
        async safeFetch(url, options, retries = 3, delay = 1000) {
            for (let i = 0; i < retries; i++) {
                try {
                    const response = await fetch(url, options);
                    if (!response.ok) {
                        if (response.status === 403) throw new Error("HTTP 403: Token hết hạn");
                        throw new Error(`HTTP ${response.status}`);
                    }
                    const contentType = response.headers.get('content-type');
                    if (contentType && contentType.includes('application/json')) return await response.json();
                    const text = await response.text();
                    if (text.includes('<!DOCTYPE')) throw new Error("Server trả về HTML");
                    throw new Error("Response không phải JSON");
                } catch(err) {
                    if (err.message.includes('403')) throw err;
                    if (i === retries - 1) throw err;
                    await new Promise(r => setTimeout(r, delay));
                }
            }
        },

        async fetchVMId(accessToken, loginId, fp, delay) {
            if (delay) await new Promise(r => setTimeout(r, delay));
            const headers = {
                "accept": "application/json", "content-type": "application/json;charset=UTF-8",
                "access-token": accessToken, "login-id": loginId,
                "web-fingerprint": fp || "0742f9ecfe480939f8d215d6db7ebedf",
                "terminal": "web", "lang": "vi", "update-date": Date.now()
            };
            const listData = await this.safeFetch("https://www.ugphone.com/api/apiv1/order/orderRecordList", {
                method: "POST", headers, body: JSON.stringify({ tab: "complete_record", page: 1, limit: 10 }), credentials: "include"
            });
            if (listData.code !== 200) throw new Error("Lỗi list: " + listData.msg);
            if (!listData.data.list.length) throw new Error("Chưa có VM");
            const orderId = listData.data.list[0].order_id;
            const statusData = await this.safeFetch("https://www.ugphone.com/api/apiv1/order/orderStatusProcess", {
                method: "POST", headers, body: JSON.stringify({ order_id: orderId }), credentials: "include"
            });
            if (statusData.code !== 200) throw new Error("Lỗi status: " + statusData.msg);
            const serviceIds = statusData.data.service_ids;
            if (!serviceIds.length) throw new Error("Không có service_ids");
            const snapData = await this.safeFetch("https://www.ugphone.com/api/apiv1/device/deviceSnapshot", {
                method: "POST", headers, body: JSON.stringify({ service_ids: serviceIds }), credentials: "include"
            });
            if (snapData.code !== 200) throw new Error("Lỗi snapshot: " + snapData.msg);
            const vmId = snapData.data.list[0].snapshot.split('/').pop().split('.')[0];
            return { vmId, serviceId: serviceIds[0] };
        },

        async replaceDevice(accessToken, loginId, fp, serviceId, reasonId, delay) {
            if (delay) await new Promise(r => setTimeout(r, delay));
            const headers = {
                "accept": "application/json", "content-type": "application/json;charset=UTF-8",
                "access-token": accessToken, "login-id": loginId,
                "web-fingerprint": fp || "0742f9ecfe480939f8d215d6db7ebedf",
                "terminal": "web", "lang": "vi", "update-date": Date.now()
            };
            const data = await this.safeFetch("https://www.ugphone.com/api/apiv1/replace_device/oneKeyNewDevice", {
                method: "POST", headers, body: JSON.stringify({ service_id: serviceId, replace_reason: reasonId, reason: "" }), credentials: "include"
            });
            if (data.code !== 200) throw new Error("Replace thất bại: " + data.msg);
            return data;
        }
    };

    // -------------------- UI CONTROLLER --------------------
    const UIController = {
        lastAccounts: [],
        lastResults: [],
        blackSet: new Set(),
        reasonId: "3kl5c04c-1nhd-z35e-0bsb-98aa9b13d09a",
        stopRequested: false,
        isRunning: false,

        addLog(msg, isErr) {
            const logDiv = document.getElementById('logArea');
            if (!logDiv) return;
            const p = document.createElement('div');
            p.style.color = isErr ? '#ff9999' : '#aaffaa';
            p.innerText = new Date().toLocaleTimeString() + ' → ' + msg;
            logDiv.appendChild(p);
            p.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            while (logDiv.children.length > 100) logDiv.removeChild(logDiv.firstChild);
        },

        parseBlacklist(input) {
            input = input.trim();
            if (!input) return new Set();
            if (input.startsWith('[') && input.endsWith(']')) {
                try { const arr = JSON.parse(input); if (Array.isArray(arr)) return new Set(arr.map(v=>v.trim())); } catch(e) {}
            }
            return new Set(input.split(/[,\s\n]+/).filter(s=>s.trim()));
        },

        renderResults() {
            const tbody = document.getElementById('resultBody');
            if (!tbody) return;
            tbody.innerHTML = '';
            for (let i = 0; i < this.lastResults.length; i++) {
                const r = this.lastResults[i];
                const row = tbody.insertRow();
                row.insertCell(0).innerText = i+1;
                row.insertCell(1).innerText = r.loginId || '?';
                row.insertCell(2).innerText = r.oldVm || '';
                row.insertCell(3).innerText = r.isBlack ? 'Có' : (r.error ? '-' : 'Không');
                row.insertCell(4).innerText = r.newVm || '';
                row.insertCell(5).innerText = r.error || '';
                
                const actionCell = row.insertCell(6);
                if (r.error) {
                    const retryBtn = document.createElement('button');
                    retryBtn.innerText = '🔄 Retry';
                    retryBtn.style.cssText = 'background:#f59e0b; border:none; color:white; padding:2px 6px; margin-right:4px;';
                    retryBtn.onclick = (async (idx) => {
                        if (this.isRunning) { this.addLog("⚠️ Đang có tác vụ chạy, hãy dừng trước hoặc đợi", true); return; }
                        this.addLog("⏳ Retry " + r.loginId);
                        const acc = this.lastAccounts.find(a => (a['UGPHONE-ID']||a['loginId']) === r.loginId);
                        if (!acc) { this.addLog("❌ Không tìm thấy dữ liệu gốc", true); return; }
                        this.isRunning = true;
                        const newResult = await this.processAccount(acc, idx, true);
                        this.isRunning = false;
                        this.lastResults[idx] = newResult;
                        this.renderResults();
                        this.autoSaveAll();
                        this.addLog("✅ Đã retry " + r.loginId);
                    }).bind(this, i);
                    actionCell.appendChild(retryBtn);
                    
                    const delBtn = document.createElement('button');
                    delBtn.innerText = '🗑️';
                    delBtn.style.cssText = 'background:#ef4444; border:none; color:white; padding:2px 6px;';
                    delBtn.onclick = (() => {
                        this.lastResults.splice(i, 1);
                        this.lastAccounts.splice(i, 1);
                        this.renderResults();
                        this.autoSaveAll();
                        this.addLog("🗑️ Đã xóa dòng " + (i+1));
                    }).bind(this);
                    actionCell.appendChild(delBtn);
                } else {
                    actionCell.innerText = '✓';
                }
                
                const buyCell = row.insertCell(7);
                const buyBtn = document.createElement('button');
                buyBtn.innerText = '🛒 Mua';
                buyBtn.style.cssText = 'background:#3b82f6; border:none; color:white; padding:2px 6px;';
                buyBtn.onclick = (async (idx) => {
                    if (this.isRunning) { this.addLog("⚠️ Đang có tác vụ chạy, hãy dừng trước hoặc đợi", true); return; }
                    const acc = this.lastAccounts[idx];
                    if (!acc) return;
                    this.isRunning = true;
                    this.addLog(`🛒 Gọi mua máy cho ${acc['UGPHONE-ID'] || acc['loginId']}...`);
                    if (typeof window.opener.buyUG === 'function') {
                        try {
                            await window.opener.buyUG();
                            this.addLog("✅ Mua máy hoàn tất, đang cập nhật VM...");
                            const newResult = await this.processAccount(acc, idx, true);
                            this.lastResults[idx] = newResult;
                            this.renderResults();
                            this.autoSaveAll();
                        } catch(err) {
                            this.addLog(`❌ Lỗi mua máy: ${err.message}`, true);
                        }
                    } else {
                        this.addLog("❌ Tab cha chưa load script buy ug hoặc không có hàm buyUG", true);
                    }
                    this.isRunning = false;
                }).bind(this, i);
                buyCell.appendChild(buyBtn);
            }
            this.autoSaveResults();
        },

        async processAccount(account, index, autoBuyIfNoVM) {
            let token = account['UGPHONE-Token'] || account['accessToken'];
            const loginId = account['UGPHONE-ID'] || account['loginId'];
            const fp = account['ugBrowserId'] || account['web-fingerprint'];
            if (!token || !loginId) return { loginId: loginId || ("Acc"+(index+1)), error: "Thiếu token hoặc loginId" };
            try {
                const { vmId, serviceId } = await CoreAPI.fetchVMId(token, loginId, fp, 1000);
                const isBlack = this.blackSet.has(vmId);
                if (isBlack) {
                    this.addLog(`⚫ VM ${vmId} bị black, replace...`);
                    await CoreAPI.replaceDevice(token, loginId, fp, serviceId, this.reasonId, 2000);
                    await new Promise(r=>setTimeout(r, 2000));
                    const { vmId: newVm } = await CoreAPI.fetchVMId(token, loginId, fp, 1000);
                    return { loginId, oldVm: vmId, newVm, isBlack: true, error: null };
                } else {
                    return { loginId, oldVm: vmId, newVm: vmId, isBlack: false, error: null };
                }
            } catch (err) {
                const noVmError = err.message.includes('chưa có VM') || err.message.includes('Chưa có VM');
                if (autoBuyIfNoVM && noVmError) {
                    this.addLog(`🔄 Tài khoản ${loginId} chưa có VM, cần mua máy. Hãy dùng nút Mua máy riêng.`);
                    return { loginId, oldVm: null, newVm: null, isBlack: false, error: "Chưa có VM, cần mua thủ công" };
                }
                return { loginId, oldVm: null, newVm: null, isBlack: false, error: err.message };
            }
        },

        autoSaveConfig() {
            const jsonText = document.getElementById('jsonInput').value.trim();
            const blacklistText = document.getElementById('blacklistInput').value.trim();
            if (jsonText) localStorage.setItem('ugphone_console_json_popup', jsonText);
            localStorage.setItem('ugphone_console_black_popup', blacklistText);
        },

        autoSaveResults() {
            localStorage.setItem('ugphone_last_results_popup', JSON.stringify(this.lastResults));
            localStorage.setItem('ugphone_last_accounts_popup', JSON.stringify(this.lastAccounts));
        },

        autoSaveAll() {
            this.autoSaveConfig();
            this.autoSaveResults();
        },

        async runSmart() {
            if (this.isRunning) { this.addLog("⚠️ Đang có tác vụ chạy, hãy dừng trước", true); return; }
            const jsonText = document.getElementById('jsonInput').value.trim();
            const blacklistText = document.getElementById('blacklistInput').value.trim();
            if (!jsonText) return alert("Nhập JSON");
            let accounts = [];
            try {
                let parsed = JSON.parse(jsonText);
                if (Array.isArray(parsed)) accounts = parsed;
                else accounts = jsonText.split(/\r?\n/).filter(l=>l.trim()).map(l=>JSON.parse(l));
            } catch(e) {
                const lines = jsonText.split(/\r?\n/);
                for (let line of lines) if(line.trim()) accounts.push(JSON.parse(line));
            }
            if (!accounts.length) return alert("Không có tài khoản");
            
            this.stopRequested = false;
            this.isRunning = true;
            this.lastAccounts = accounts;
            this.blackSet = this.parseBlacklist(blacklistText);
            this.lastResults = [];
            this.renderResults();
            this.autoSaveAll();
            
            for (let i = 0; i < accounts.length && !this.stopRequested; i++) {
                this.addLog(`🚀 Xử lý ${i+1}/${accounts.length}: ${accounts[i]['UGPHONE-ID'] || accounts[i]['loginId']}`);
                const result = await this.processAccount(accounts[i], i, true);
                this.lastResults.push(result);
                this.renderResults();
                this.autoSaveResults();
                if (result.error) this.addLog(`⚠️ Lỗi: ${result.error}`, true);
                else this.addLog(`✅ VM: ${result.newVm} ${result.isBlack ? '(đã thay)' : '(giữ nguyên)'}`);
                if (!this.stopRequested) await new Promise(r => setTimeout(r, 2000));
            }
            this.isRunning = false;
            if (this.stopRequested) this.addLog("⏹️ Đã dừng theo yêu cầu");
            else this.addLog("🎉 Hoàn tất xử lý " + accounts.length + " tài khoản.");
            this.autoSaveAll();
        },

        async runReplacer() {
            if (this.isRunning) { this.addLog("⚠️ Đang có tác vụ chạy, hãy dừng trước", true); return; }
            const jsonText = document.getElementById('jsonInput').value.trim();
            const blacklistText = document.getElementById('blacklistInput').value.trim();
            if (!jsonText) return alert("Nhập JSON");
            let accounts = [];
            try {
                let parsed = JSON.parse(jsonText);
                if (Array.isArray(parsed)) accounts = parsed;
                else accounts = jsonText.split(/\r?\n/).filter(l=>l.trim()).map(l=>JSON.parse(l));
            } catch(e) {
                const lines = jsonText.split(/\r?\n/);
                for (let line of lines) if(line.trim()) accounts.push(JSON.parse(line));
            }
            if (!accounts.length) return alert("Không có tài khoản");
            
            this.stopRequested = false;
            this.isRunning = true;
            this.lastAccounts = accounts;
            this.blackSet = this.parseBlacklist(blacklistText);
            this.lastResults = [];
            this.renderResults();
            this.autoSaveAll();
            
            for (let i = 0; i < accounts.length && !this.stopRequested; i++) {
                this.addLog(`🔍 Xử lý ${i+1}/${accounts.length}: ${accounts[i]['UGPHONE-ID'] || accounts[i]['loginId']}`);
                const result = await this.processAccount(accounts[i], i, false);
                this.lastResults.push(result);
                this.renderResults();
                this.autoSaveResults();
                if (!this.stopRequested) await new Promise(r=>setTimeout(r, 2000));
            }
            this.isRunning = false;
            if (this.stopRequested) this.addLog("⏹️ Đã dừng theo yêu cầu");
            else this.addLog("🎉 Hoàn tất kiểm tra.");
            this.autoSaveAll();
        },

        async retryAllErrors() {
            if (this.isRunning) { this.addLog("⚠️ Đang có tác vụ chạy, hãy dừng trước", true); return; }
            const errorIndices = [];
            for (let i=0; i<this.lastResults.length; i++) if (this.lastResults[i].error) errorIndices.push(i);
            if (errorIndices.length === 0) { this.addLog("Không có lỗi để retry"); return; }
            
            this.stopRequested = false;
            this.isRunning = true;
            this.addLog("🔄 Retry " + errorIndices.length + " tài khoản...");
            this.blackSet = this.parseBlacklist(document.getElementById('blacklistInput').value);
            
            for (let idx of errorIndices) {
                if (this.stopRequested) break;
                const acc = this.lastAccounts[idx];
                if (!acc) continue;
                this.addLog("⏳ Retry " + (acc['UGPHONE-ID'] || acc['loginId']));
                const force = this.lastResults[idx].error && (this.lastResults[idx].error.includes('chưa có VM') || this.lastResults[idx].error.includes('Chưa có VM'));
                const newResult = await this.processAccount(acc, idx, force);
                this.lastResults[idx] = newResult;
                this.renderResults();
                this.autoSaveResults();
                if (!this.stopRequested) await new Promise(r=>setTimeout(r, 2000));
            }
            this.isRunning = false;
            if (this.stopRequested) this.addLog("⏹️ Đã dừng retry");
            else this.addLog("✅ Hoàn tất retry.");
            this.autoSaveAll();
        },

        async manualBuy() {
            if (this.isRunning) { this.addLog("⚠️ Đang có tác vụ chạy, hãy dừng trước", true); return; }
            if (!this.lastAccounts.length) { this.addLog("❌ Không có tài khoản nào trong bảng", true); return; }
            if (typeof window.opener.buyUG !== 'function') {
                this.addLog("❌ Tab cha chưa load script buy ug hoặc không có hàm buyUG", true);
                return;
            }
            this.isRunning = true;
            this.addLog("🛒 Gọi mua máy trên tab cha (sẽ mua cho tài khoản đầu tiên)...");
            try {
                await window.opener.buyUG();
                this.addLog("✅ Mua máy hoàn tất, cập nhật VM cho tài khoản đầu tiên...");
                const newResult = await this.processAccount(this.lastAccounts[0], 0, false);
                this.lastResults[0] = newResult;
                this.renderResults();
                this.autoSaveAll();
            } catch(err) {
                this.addLog(`❌ Lỗi mua máy: ${err.message}`, true);
            }
            this.isRunning = false;
        },

        exportCSV() {
            let csv = "STT,Login ID,VM cũ,Blacklist?,VM mới,Lỗi\n";
            for (let i=0; i<this.lastResults.length; i++) {
                const r = this.lastResults[i];
                csv += `${i+1},${r.loginId||''},${r.oldVm||''},${r.isBlack?'Có':'Không'},${r.newVm||''},${r.error||''}\n`;
            }
            const blob = new Blob([csv], {type:"text/csv"});
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = "ugphone_" + Date.now() + ".csv";
            a.click();
            URL.revokeObjectURL(a.href);
        },

        clearTable() { 
            this.lastResults = []; 
            this.lastAccounts = []; 
            this.renderResults(); 
            this.autoSaveAll();
            this.addLog("Đã xóa bảng"); 
        },
        
        saveJson() { this.autoSaveConfig(); this.addLog("✅ Đã lưu cấu hình"); },
        saveResults() { this.autoSaveResults(); this.addLog("💾 Đã lưu kết quả"); },
        
        loadStored() {
            const json = localStorage.getItem('ugphone_console_json_popup');
            if (json) document.getElementById('jsonInput').value = json;
            const black = localStorage.getItem('ugphone_console_black_popup');
            if (black) document.getElementById('blacklistInput').value = black;
            const savedResults = localStorage.getItem('ugphone_last_results_popup');
            if (savedResults) {
                try {
                    this.lastResults = JSON.parse(savedResults);
                    this.lastAccounts = JSON.parse(localStorage.getItem('ugphone_last_accounts_popup') || '[]');
                    this.renderResults();
                    this.addLog("📂 Đã tải lại " + this.lastResults.length + " kết quả cũ");
                } catch(e) {}
            }
        },

        stop() {
            if (this.isRunning) {
                this.stopRequested = true;
                this.addLog("⏹️ Đang yêu cầu dừng...");
            } else {
                this.addLog("⚠️ Không có tiến trình nào đang chạy");
            }
        }
    };

    // -------------------- HTML POPUP (đã gắn nút gọi manualBuy) --------------------
    const popupHtml = `
<!DOCTYPE html>
<html>
<head><title>UGphone Tool Pro - Integrated Buy</title>
<style>
