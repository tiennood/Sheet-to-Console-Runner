// ===================== UI TOOL (đã sửa lỗi CoreAPI) =====================
(function() {
    // Định nghĩa CoreAPI ngay trong popup (dựa trên code gốc của bạn)
    const CoreAPI = {
        async safeFetch(url, options, retries = 3, delay = 1000) {
            for (let i = 0; i < retries; i++) {
                try {
                    const response = await fetch(url, options);
                    if (!response.ok) {
                        if (response.status === 403) throw new Error("HTTP 403: Token hết hạn");
                        throw new Error(`HTTP ${response.status}`);
                    }
                    const contentType = response.headers.get('content-type');
                    if (contentType && contentType.includes('application/json')) return await response.json();
                    const text = await response.text();
                    if (text.includes('<!DOCTYPE')) throw new Error("Server trả về HTML");
                    throw new Error("Response không phải JSON");
                } catch(err) {
                    if (err.message.includes('403')) throw err;
                    if (i === retries - 1) throw err;
                    await new Promise(r => setTimeout(r, delay));
                }
            }
        },

        async fetchVMId(accessToken, loginId, fp, delay) {
            if (delay) await new Promise(r => setTimeout(r, delay));
            const headers = {
                "accept": "application/json", "content-type": "application/json;charset=UTF-8",
                "access-token": accessToken, "login-id": loginId,
                "web-fingerprint": fp || "0742f9ecfe480939f8d215d6db7ebedf",
                "terminal": "web", "lang": "vi", "update-date": Date.now()
            };
            const listData = await this.safeFetch("https://www.ugphone.com/api/apiv1/order/orderRecordList", {
                method: "POST", headers, body: JSON.stringify({ tab: "complete_record", page: 1, limit: 10 }), credentials: "include"
            });
            if (listData.code !== 200) throw new Error("Lỗi list: " + listData.msg);
            if (!listData.data.list.length) throw new Error("Chưa có VM");
            const orderId = listData.data.list[0].order_id;
            const statusData = await this.safeFetch("https://www.ugphone.com/api/apiv1/order/orderStatusProcess", {
                method: "POST", headers, body: JSON.stringify({ order_id: orderId }), credentials: "include"
            });
            if (statusData.code !== 200) throw new Error("Lỗi status: " + statusData.msg);
            const serviceIds = statusData.data.service_ids;
            if (!serviceIds.length) throw new Error("Không có service_ids");
            const snapData = await this.safeFetch("https://www.ugphone.com/api/apiv1/device/deviceSnapshot", {
                method: "POST", headers, body: JSON.stringify({ service_ids: serviceIds }), credentials: "include"
            });
            if (snapData.code !== 200) throw new Error("Lỗi snapshot: " + snapData.msg);
            const vmId = snapData.data.list[0].snapshot.split('/').pop().split('.')[0];
            return { vmId, serviceId: serviceIds[0] };
        },

        async replaceDevice(accessToken, loginId, fp, serviceId, reasonId, delay) {
            if (delay) await new Promise(r => setTimeout(r, delay));
            const headers = {
                "accept": "application/json", "content-type": "application/json;charset=UTF-8",
                "access-token": accessToken, "login-id": loginId,
                "web-fingerprint": fp || "0742f9ecfe480939f8d215d6db7ebedf",
                "terminal": "web", "lang": "vi", "update-date": Date.now()
            };
            const data = await this.safeFetch("https://www.ugphone.com/api/apiv1/replace_device/oneKeyNewDevice", {
                method: "POST", headers, body: JSON.stringify({ service_id: serviceId, replace_reason: reasonId, reason: "" }), credentials: "include"
            });
            if (data.code !== 200) throw new Error("Replace thất bại: " + data.msg);
            return data;
        },

        getBuyScript() {
            return `
                (async function() {
                    const CONFIG = { REGION: 'Hong Kong', AUTO_PAY: true, TIMEOUT: 30000 };
                    const stepLog = [];
                    function addStep(step, status, detail) { 
                        const msg = step + " - " + status + (detail ? ": " + detail : "");
                        console.log("[UGphoneBuy] " + msg);
                        stepLog.push({ Step: step, Status: status, Detail: detail || '' });
                    }
                    function isElementClickable(el) {
                        if (!el) return false;
                        if (el.disabled === true) return false;
                        const ariaDisabled = el.getAttribute('aria-disabled');
                        if (ariaDisabled === 'true') return false;
                        if (el.classList && (el.classList.contains('disabled') || el.classList.contains('btn-disabled'))) return false;
                        const style = window.getComputedStyle(el);
                        if (style.display === 'none' || style.visibility === 'hidden' || style.opacity === '0') return false;
                        if (style.pointerEvents === 'none') return false;
                        const rect = el.getBoundingClientRect();
                        if (rect.width === 0 || rect.height === 0) return false;
                        if (el.offsetParent === null && style.position !== 'fixed') return false;
                        const centerX = rect.left + rect.width / 2;
                        const centerY = rect.top + rect.height / 2;
                        const elemAtCenter = document.elementsFromPoint(centerX, centerY)[0];
                        if (elemAtCenter !== el && !el.contains(elemAtCenter)) {
                            console.warn("[UGphoneBuy] Nút Pay bị che bởi:", elemAtCenter);
                            return false;
                        }
                        return true;
                    }
                    function findPayButton() {
                        let btn = document.querySelector('#buy-btn');
                        if (btn && isElementClickable(btn) && btn.textContent.trim().toLowerCase() === 'pay') return btn;
                        const payDiv = document.querySelector('.pay-btn');
                        if (payDiv) {
                            const innerBtn = payDiv.querySelector('button');
                            if (innerBtn && isElementClickable(innerBtn) && innerBtn.textContent.trim().toLowerCase() === 'pay') return innerBtn;
                        }
                        const xpath = "//button[@id='buy-btn' and translate(normalize-space(text()), 'PAY', 'pay') = 'pay']";
                        const xresult = document.evaluate(xpath, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null);
                        const xbtn = xresult.singleNodeValue;
                        if (xbtn && isElementClickable(xbtn)) return xbtn;
                        const allBtns = Array.from(document.querySelectorAll('button'));
                        return allBtns.find(b => b.textContent.trim().toLowerCase() === 'pay' && isElementClickable(b));
                    }
                    async function waitForPayButton(timeout = 30000) {
                        let observer = null, timeoutId = null, intervalId = null;
                        return new Promise((resolve, reject) => {
                            const cleanup = () => {
                                if (observer) observer.disconnect();
                                if (timeoutId) clearTimeout(timeoutId);
                                if (intervalId) clearInterval(intervalId);
                            };
                            const check = () => {
                                const btn = findPayButton();
                                if (btn) {
                                    addStep("Tìm thấy nút Pay", "THÀNH CÔNG", "clickable");
                                    cleanup();
                                    resolve(btn);
                                    return true;
                                }
                                return false;
                            };
                            if (check()) return;
                            observer = new MutationObserver(() => requestAnimationFrame(() => check()));
                            observer.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['class', 'disabled', 'style'] });
                            intervalId = setInterval(() => { if (check()) clearInterval(intervalId); }, 200);
                            timeoutId = setTimeout(() => { cleanup(); reject(new Error("Không tìm thấy nút Pay có thể click sau " + timeout + "ms")); }, timeout);
                        });
                    }
                    function waitForElement(selector, timeout) {
                        return new Promise((resolve, reject) => {
                            const start = Date.now();
                            const check = () => {
                                const el = document.querySelector(selector);
                                if (el) return resolve(el);
                                if (Date.now() - start >= timeout) reject(new Error("Timeout: " + selector));
                                requestAnimationFrame(check);
                            };
                            check();
                        });
                    }
                    function waitForHash(target, timeout) {
                        return new Promise((resolve, reject) => {
                            if (window.location.hash.includes(target)) return resolve(window.location.hash);
                            const onHashChange = () => {
                                if (window.location.hash.includes(target)) {
                                    window.removeEventListener('hashchange', onHashChange);
                                    clearTimeout(timer);
                                    resolve(window.location.hash);
                                }
                            };
                            window.addEventListener('hashchange', onHashChange);
                            const timer = setTimeout(() => {
                                window.removeEventListener('hashchange', onHashChange);
                                reject(new Error("Timeout waiting for hash: " + target));
                            }, timeout);
                        });
                    }
                    function findOrderButton() {
                        const btns = Array.from(document.querySelectorAll('#buy-btn, button'));
                        return btns.find(btn => {
                            const text = btn.textContent.trim().toLowerCase();
                            return (text.includes('đặt mua') || text.includes('buy')) && btn.offsetParent !== null && !btn.disabled;
                        });
                    }
                    function isFreeTrial(cardElement) {
                        const text = cardElement.textContent.toLowerCase();
                        return text.includes('free trial') || text.includes('hour') || text.includes('4-hour');
                    }
                    try {
                        addStep("Bắt đầu", "INFO", "Chuẩn bị mua máy");
                        if (!window.location.hash.includes('/dashboard')) {
                            window.location.hash = '#/dashboard/index';
                            await waitForHash('/dashboard', 10000);
                            await new Promise(r => setTimeout(r, 1000));
                        }
                        try {
                            const getBtn = await waitForElement('.get-btn', 5000);
                            if (getBtn) { getBtn.click(); await new Promise(r => setTimeout(r, 1000)); }
                        } catch(e) { addStep("Get máy", "BỎ QUA", "Không có nút Get"); }
                        if (!window.location.hash.includes('/purchaseDevice')) {
                            window.location.hash = '#/purchaseDevice';
                            await waitForHash('/purchaseDevice', 15000);
                        }
                        await waitForElement('.room-item', 15000);
                        const allRooms = Array.from(document.querySelectorAll('.room-item'));
                        const targetRoom = allRooms.find(r => r.textContent.includes(CONFIG.REGION));
                        if (!targetRoom) throw new Error("Không tìm thấy vùng " + CONFIG.REGION);
                        targetRoom.click();
                        addStep("Chọn vùng", "THÀNH CÔNG", CONFIG.REGION);
                        await new Promise(r => setTimeout(r, 500));
                        await waitForElement('#active-card', 15000);
                        const cards = Array.from(document.querySelectorAll('#active-card'));
                        let targetCard = null;
                        const vipCards = cards.filter(card => card.textContent.toLowerCase().includes('vip') && !isFreeTrial(card));
                        if (vipCards.length > 0) {
                            const getDays = (text) => {
                                const match = text.match(/(\\d+)\\s*[Nn]gày|[Dd]ays?/);
                                if (match) return parseInt(match[1]);
                                const numMatch = text.match(/\\b(250|365|180|90|30)\\b/);
                                return numMatch ? parseInt(numMatch[1]) : 0;
                            };
                            vipCards.sort((a,b) => getDays(b.textContent) - getDays(a.textContent));
                            targetCard = vipCards[0];
                            addStep("Chọn gói VIP", "THÀNH CÔNG", targetCard.textContent.trim());
                        } else {
                            const trialCards = cards.filter(isFreeTrial);
                            if (trialCards.length) {
                                targetCard = trialCards[0];
                                addStep("Chọn gói dùng thử", "THÀNH CÔNG", targetCard.textContent.trim());
                            } else {
                                targetCard = cards[0];
                                addStep("Chọn gói (fallback)", "THÀNH CÔNG", targetCard.textContent.trim());
                            }
                        }
                        if (!targetCard) throw new Error("Không có gói nào");
                        const isTrial = isFreeTrial(targetCard);
                        targetCard.click();
                        await new Promise(r => setTimeout(r, 1500));
                        await waitForElement('#buy-btn', 15000);
                        const orderBtn = findOrderButton();
                        if (orderBtn) orderBtn.click();
                        else throw new Error("Không tìm thấy nút Đặt mua");
                        addStep("Đặt mua", "THÀNH CÔNG");
                        if (isTrial) {
                            addStep("Gói dùng thử", "INFO", "Không cần thanh toán, chờ chuyển trang...");
                            try {
                                await Promise.race([waitForHash('/waiting', 30000), waitForHash('/dashboard', 60000)]);
                                addStep("Hoàn tất (trial)", "THÀNH CÔNG", "Đã chuyển trang");
                            } catch(e) {
                                addStep("Hoàn tất (trial)", "WARN", "Không thấy hash, thử reload dashboard");
                                window.location.hash = '#/dashboard/index';
                                await waitForHash('/dashboard', 15000);
                            }
                            await new Promise(r => setTimeout(r, 3000));
                        } else {
                            addStep("Chờ nút Pay", "INFO", "Đang tìm nút thanh toán...");
                            const payBtn = await waitForPayButton(30000);
                            await new Promise(r => setTimeout(r, 300));
                            addStep("Click nút Pay", "THÀNH CÔNG");
                            payBtn.click();
                            addStep("Nhấn thanh toán", "THÀNH CÔNG");
                            try {
                                await waitForHash('/waiting', 30000);
                                addStep("Chờ xử lý", "THÀNH CÔNG");
                            } catch(e) { addStep("Chờ waiting", "WARN", "Không thấy hash waiting"); }
                            try {
                                await waitForHash('/dashboard', 120000);
                                addStep("Hoàn tất", "THÀNH CÔNG");
                            } catch(e) { addStep("Hoàn tất", "WARN", "Không thấy dashboard nhưng có thể thành công"); }
                        }
                        addStep("MUA MÁY", "THÀNH CÔNG", "Đã mua/kích hoạt máy");
                        return { success: true, stepLog };
                    } catch(err) {
                        addStep("MUA MÁY", "THẤT BẠI", err.message);
                        return { success: false, error: err.message, stepLog };
                    }
                })();
            `;
        },

        async buyOnParent(account, accountIndex, onLog) {
            if (!window.opener) {
                if (onLog) onLog("❌ Không có tab mẹ", true);
                return false;
            }
            const token = account['UGPHONE-Token'] || account['accessToken'];
            const loginId = account['UGPHONE-ID'] || account['loginId'];
            if (!token || !loginId) {
                if (onLog) onLog("❌ Thiếu token/loginId", true);
                return false;
            }
            if (onLog) onLog(`🛒 Đăng nhập ${loginId} và mua máy...`);
            window.opener.focus();
            try {
                window.opener.localStorage.setItem('UGPHONE-Token', token);
                window.opener.localStorage.setItem('UGPHONE-ID', loginId);
                if (onLog) onLog("✅ Đã cập nhật token, chạy script mua máy...");
                const script = this.getBuyScript();
                const buyPromise = window.opener.eval(script);
                const timeoutPromise = new Promise((_, reject) => setTimeout(() => reject(new Error("Timeout 120s khi mua máy")), 120000));
                const result = await Promise.race([buyPromise, timeoutPromise]);
                if (result && result.success) {
                    if (onLog) onLog(`✅ Mua máy thành công cho ${loginId}`);
                    return true;
                } else {
                    if (onLog) onLog(`❌ Mua máy thất bại: ${result?.error || 'Lỗi không xác định'}`, true);
                    return false;
                }
            } catch(err) {
                if (onLog) onLog(`❌ Lỗi mua máy: ${err.message}`, true);
                return false;
            }
        }
    };

    // -------------------- UI Controller (giống gốc nhưng dùng CoreAPI đã định nghĩa sẵn) --------------------
    const UIController = {
        lastAccounts: [],
        lastResults: [],
        blackSet: new Set(),
        reasonId: "3kl5c04c-1nhd-z35e-0bsb-98aa9b13d09a",
        stopRequested: false,
        isRunning: false,

        addLog(msg, isErr) {
            const logDiv = document.getElementById('logArea');
            if (!logDiv) return;
            const p = document.createElement('div');
            p.style.color = isErr ? '#ff9999' : '#aaffaa';
            p.innerText = new Date().toLocaleTimeString() + ' → ' + msg;
            logDiv.appendChild(p);
            p.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            while (logDiv.children.length > 100) logDiv.removeChild(logDiv.firstChild);
        },

        parseBlacklist(input) {
            input = input.trim();
            if (!input) return new Set();
            if (input.startsWith('[') && input.endsWith(']')) {
                try { const arr = JSON.parse(input); if (Array.isArray(arr)) return new Set(arr.map(v=>v.trim())); } catch(e) {}
            }
            return new Set(input.split(/[,\s\n]+/).filter(s=>s.trim()));
        },

        renderResults() {
            const tbody = document.getElementById('resultBody');
            if (!tbody) return;
            tbody.innerHTML = '';
            for (let i = 0; i < this.lastResults.length; i++) {
                const r = this.lastResults[i];
                const row = tbody.insertRow();
                row.insertCell(0).innerText = i+1;
                row.insertCell(1).innerText = r.loginId || '?';
                row.insertCell(2).innerText = r.oldVm || '';
                row.insertCell(3).innerText = r.isBlack ? 'Có' : (r.error ? '-' : 'Không');
                row.insertCell(4).innerText = r.newVm || '';
                row.insertCell(5).innerText = r.error || '';
                
                const actionCell = row.insertCell(6);
                if (r.error) {
                    const retryBtn = document.createElement('button');
                    retryBtn.innerText = '🔄 Retry';
                    retryBtn.style.cssText = 'background:#f59e0b; border:none; color:white; padding:2px 6px; margin-right:4px;';
                    retryBtn.onclick = (async (idx) => {
                        if (this.isRunning) { this.addLog("⚠️ Đang có tác vụ chạy, hãy dừng trước hoặc đợi", true); return; }
                        this.addLog("⏳ Retry " + r.loginId);
                        const acc = this.lastAccounts.find(a => (a['UGPHONE-ID']||a['loginId']) === r.loginId);
                        if (!acc) { this.addLog("❌ Không tìm thấy dữ liệu gốc", true); return; }
                        this.isRunning = true;
                        const newResult = await this.processAccount(acc, idx, true);
                        this.isRunning = false;
                        this.lastResults[idx] = newResult;
                        this.renderResults();
                        this.autoSaveAll();
                        this.addLog("✅ Đã retry " + r.loginId);
                    }).bind(this, i);
                    actionCell.appendChild(retryBtn);
                    
                    const delBtn = document.createElement('button');
                    delBtn.innerText = '🗑️';
                    delBtn.style.cssText = 'background:#ef4444; border:none; color:white; padding:2px 6px;';
                    delBtn.onclick = (() => {
                        this.lastResults.splice(i, 1);
                        this.lastAccounts.splice(i, 1);
                        this.renderResults();
                        this.autoSaveAll();
                        this.addLog("🗑️ Đã xóa dòng " + (i+1));
                    }).bind(this);
                    actionCell.appendChild(delBtn);
                } else {
                    actionCell.innerText = '✓';
                }
                
                const buyCell = row.insertCell(7);
                const buyBtn = document.createElement('button');
                buyBtn.innerText = '🛒 Mua';
                buyBtn.style.cssText = 'background:#3b82f6; border:none; color:white; padding:2px 6px;';
                buyBtn.onclick = (async (idx) => {
                    if (this.isRunning) { this.addLog("⚠️ Đang có tác vụ chạy, hãy dừng trước hoặc đợi", true); return; }
                    const acc = this.lastAccounts[idx];
                    if (!acc) return;
                    this.isRunning = true;
                    const success = await CoreAPI.buyOnParent(acc, idx, this.addLog.bind(this));
                    if (success) {
                        const newResult = await this.processAccount(acc, idx, true);
                        this.lastResults[idx] = newResult;
                        this.renderResults();
                        this.autoSaveAll();
                    }
                    this.isRunning = false;
                }).bind(this, i);
                buyCell.appendChild(buyBtn);
            }
            this.autoSaveResults();
        },

        async processAccount(account, index, autoBuyIfNoVM) {
            let token = account['UGPHONE-Token'] || account['accessToken'];
            const loginId = account['UGPHONE-ID'] || account['loginId'];
            const fp = account['ugBrowserId'] || account['web-fingerprint'];
            if (!token || !loginId) return { loginId: loginId || ("Acc"+(index+1)), error: "Thiếu token hoặc loginId" };
            try {
                const { vmId, serviceId } = await CoreAPI.fetchVMId(token, loginId, fp, 1000);
                const isBlack = this.blackSet.has(vmId);
                if (isBlack) {
                    this.addLog(`⚫ VM ${vmId} bị black, replace...`);
                    await CoreAPI.replaceDevice(token, loginId, fp, serviceId, this.reasonId, 2000);
                    await new Promise(r=>setTimeout(r, 2000));
                    const { vmId: newVm } = await CoreAPI.fetchVMId(token, loginId, fp, 1000);
                    return { loginId, oldVm: vmId, newVm, isBlack: true, error: null };
                } else {
                    return { loginId, oldVm: vmId, newVm: vmId, isBlack: false, error: null };
                }
            } catch (err) {
                const noVmError = err.message.includes('chưa có VM') || err.message.includes('Chưa có VM');
                if (autoBuyIfNoVM && noVmError) {
                    this.addLog(`🔄 Tài khoản ${loginId} chưa có VM, tiến hành mua...`);
                    const buySuccess = await CoreAPI.buyOnParent(account, index, this.addLog.bind(this));
                    if (buySuccess) {
                        try {
                            // Retry lấy VM mới
                            for (let i=0; i<20; i++) {
                                try {
                                    const { vmId: newVm } = await CoreAPI.fetchVMId(token, loginId, fp, 1000);
                                    this.addLog(`✅ Lấy được VM mới: ${newVm} cho ${loginId}`);
                                    return { loginId, oldVm: null, newVm, isBlack: false, error: null };
                                } catch(e) { await new Promise(r=>setTimeout(r, 5000)); }
                            }
                            return { loginId, oldVm: null, newVm: null, isBlack: false, error: "Đã mua máy nhưng không lấy được VM" };
                        } catch (fetchErr) {
                            this.addLog(`❌ Không lấy được VM sau khi mua: ${fetchErr.message}`, true);
                            return { loginId, oldVm: null, newVm: null, isBlack: false, error: "Đã mua máy nhưng không lấy được VM" };
                        }
                    } else {
                        return { loginId, oldVm: null, newVm: null, isBlack: false, error: "Mua máy tự động thất bại" };
                    }
                }
                return { loginId, oldVm: null, newVm: null, isBlack: false, error: err.message };
            }
        },

        autoSaveConfig() {
            const jsonText = document.getElementById('jsonInput').value.trim();
            const blacklistText = document.getElementById('blacklistInput').value.trim();
            if (jsonText) localStorage.setItem('ugphone_console_json_popup', jsonText);
            localStorage.setItem('ugphone_console_black_popup', blacklistText);
        },

        autoSaveResults() {
            localStorage.setItem('ugphone_last_results_popup', JSON.stringify(this.lastResults));
            localStorage.setItem('ugphone_last_accounts_popup', JSON.stringify(this.lastAccounts));
        },

        autoSaveAll() {
            this.autoSaveConfig();
            this.autoSaveResults();
        },

        async runSmart() {
            if (this.isRunning) { this.addLog("⚠️ Đang có tác vụ chạy, hãy dừng trước hoặc đợi", true); return; }
            const jsonText = document.getElementById('jsonInput').value.trim();
            const blacklistText = document.getElementById('blacklistInput').value.trim();
            if (!jsonText) return alert("Nhập JSON");
            let accounts = [];
            try {
                let parsed = JSON.parse(jsonText);
                if (Array.isArray(parsed)) accounts = parsed;
                else accounts = jsonText.split(/\r?\n/).filter(l=>l.trim()).map(l=>JSON.parse(l));
            } catch(e) {
                const lines = jsonText.split(/\r?\n/);
                for (let line of lines) if(line.trim()) accounts.push(JSON.parse(line));
            }
            if (!accounts.length) return alert("Không có tài khoản");
            
            this.stopRequested = false;
            this.isRunning = true;
            this.lastAccounts = accounts;
            this.blackSet = this.parseBlacklist(blacklistText);
            this.lastResults = [];
            this.renderResults();
            this.autoSaveAll();
            
            for (let i = 0; i < accounts.length && !this.stopRequested; i++) {
                this.addLog(`🚀 Xử lý ${i+1}/${accounts.length}: ${accounts[i]['UGPHONE-ID'] || accounts[i]['loginId']}`);
                const result = await this.processAccount(accounts[i], i, true);
                this.lastResults.push(result);
                this.renderResults();
                this.autoSaveResults();
                if (result.error) this.addLog(`⚠️ Lỗi: ${result.error}`, true);
                else this.addLog(`✅ VM: ${result.newVm} ${result.isBlack ? '(đã thay)' : '(giữ nguyên)'}`);
                if (!this.stopRequested) await new Promise(r => setTimeout(r, 2000));
            }
            this.isRunning = false;
            if (this.stopRequested) this.addLog("⏹️ Đã dừng theo yêu cầu");
            else this.addLog("🎉 Hoàn tất xử lý " + accounts.length + " tài khoản.");
            this.autoSaveAll();
        },

        async runReplacer() {
            if (this.isRunning) { this.addLog("⚠️ Đang có tác vụ chạy, hãy dừng trước hoặc đợi", true); return; }
            const jsonText = document.getElementById('jsonInput').value.trim();
            const blacklistText = document.getElementById('blacklistInput').value.trim();
            if (!jsonText) return alert("Nhập JSON");
            let accounts = [];
            try {
                let parsed = JSON.parse(jsonText);
                if (Array.isArray(parsed)) accounts = parsed;
                else accounts = jsonText.split(/\r?\n/).filter(l=>l.trim()).map(l=>JSON.parse(l));
            } catch(e) {
                const lines = jsonText.split(/\r?\n/);
                for (let line of lines) if(line.trim()) accounts.push(JSON.parse(line));
            }
            if (!accounts.length) return alert("Không có tài khoản");
            
            this.stopRequested = false;
            this.isRunning = true;
            this.lastAccounts = accounts;
            this.blackSet = this.parseBlacklist(blacklistText);
            this.lastResults = [];
            this.renderResults();
            this.autoSaveAll();
            
            for (let i = 0; i < accounts.length && !this.stopRequested; i++) {
                this.addLog("🔍 Xử lý " + (i+1) + "/" + accounts.length + ": " + (accounts[i]['UGPHONE-ID'] || accounts[i]['loginId']));
                const result = await this.processAccount(accounts[i], i, false);
                this.lastResults.push(result);
                this.renderResults();
                this.autoSaveResults();
                if (!this.stopRequested) await new Promise(r=>setTimeout(r, 2000));
            }
            this.isRunning = false;
            if (this.stopRequested) this.addLog("⏹️ Đã dừng theo yêu cầu");
            else this.addLog("🎉 Hoàn tất kiểm tra.");
            this.autoSaveAll();
        },

        async retryAllErrors() {
            if (this.isRunning) { this.addLog("⚠️ Đang có tác vụ chạy, hãy dừng trước hoặc đợi", true); return; }
            const errorIndices = [];
            for (let i=0; i<this.lastResults.length; i++) if (this.lastResults[i].error) errorIndices.push(i);
            if (errorIndices.length === 0) { this.addLog("Không có lỗi để retry"); return; }
            
            this.stopRequested = false;
            this.isRunning = true;
            this.addLog("🔄 Retry " + errorIndices.length + " tài khoản...");
            this.blackSet = this.parseBlacklist(document.getElementById('blacklistInput').value);
            
            for (let idx of errorIndices) {
                if (this.stopRequested) break;
                const acc = this.lastAccounts[idx];
                if (!acc) continue;
                this.addLog("⏳ Retry " + (acc['UGPHONE-ID'] || acc['loginId']));
                const force = this.lastResults[idx].error && (this.lastResults[idx].error.includes('chưa có VM') || this.lastResults[idx].error.includes('Chưa có VM'));
                const newResult = await this.processAccount(acc, idx, force);
                this.lastResults[idx] = newResult;
                this.renderResults();
                this.autoSaveResults();
                if (!this.stopRequested) await new Promise(r=>setTimeout(r, 2000));
            }
            this.isRunning = false;
            if (this.stopRequested) this.addLog("⏹️ Đã dừng retry");
            else this.addLog("✅ Hoàn tất retry.");
            this.autoSaveAll();
        },

        async manualBuy() {
            if (this.isRunning) { this.addLog("⚠️ Đang có tác vụ chạy, hãy dừng trước hoặc đợi", true); return; }
            if (!this.lastAccounts.length) { this.addLog("❌ Không có tài khoản", true); return; }
            this.isRunning = true;
            await CoreAPI.buyOnParent(this.lastAccounts[0], 0, this.addLog.bind(this));
            this.blackSet = this.parseBlacklist(document.getElementById('blacklistInput').value);
            const newResult = await this.processAccount(this.lastAccounts[0], 0, false);
            this.lastResults[0] = newResult;
            this.renderResults();
            this.autoSaveAll();
            this.isRunning = false;
        },

        exportCSV() {
            let csv = "STT,Login ID,VM cũ,Blacklist?,VM mới,Lỗi\n";
            for (let i=0; i<this.lastResults.length; i++) {
                const r = this.lastResults[i];
                csv += `${i+1},${r.loginId||''},${r.oldVm||''},${r.isBlack?'Có':'Không'},${r.newVm||''},${r.error||''}\n`;
            }
            const blob = new Blob([csv], {type:"text/csv"});
            const a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = "ugphone_" + Date.now() + ".csv";
            a.click();
            URL.revokeObjectURL(a.href);
        },

        clearTable() { 
            this.lastResults = []; 
            this.lastAccounts = []; 
            this.renderResults(); 
            this.autoSaveAll();
            this.addLog("Đã xóa bảng"); 
        },
        
        saveJson() { this.autoSaveConfig(); this.addLog("✅ Đã lưu cấu hình"); },
        saveResults() { this.autoSaveResults(); this.addLog("💾 Đã lưu kết quả"); },
        
        loadStored() {
            const json = localStorage.getItem('ugphone_console_json_popup');
            if (json) document.getElementById('jsonInput').value = json;
            const black = localStorage.getItem('ugphone_console_black_popup');
            if (black) document.getElementById('blacklistInput').value = black;
            const savedResults = localStorage.getItem('ugphone_last_results_popup');
            if (savedResults) {
                try {
                    this.lastResults = JSON.parse(savedResults);
                    this.lastAccounts = JSON.parse(localStorage.getItem('ugphone_last_accounts_popup') || '[]');
                    this.renderResults();
                    this.addLog("📂 Đã tải lại " + this.lastResults.length + " kết quả cũ");
                } catch(e) {}
            }
        },

        stop() {
            if (this.isRunning) {
                this.stopRequested = true;
                this.addLog("⏹️ Đang yêu cầu dừng...");
            } else {
                this.addLog("⚠️ Không có tiến trình nào đang chạy");
            }
        }
    };

    // -------------------- HTML POPUP --------------------
