    .flex { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
</style>
</head>
<body>
<div class="container">
    <div class="row">
        <textarea id="jsonInput" rows="3" placeholder='Danh sách tài khoản JSON - Ví dụ:\n[{"UGPHONE-Token":"xxx","UGPHONE-ID":"user1"}]'></textarea>
        <textarea id="blacklistInput" rows="3" placeholder='Blacklist VM ID - Ví dụ:\n["VM123456", "VM789012"]'></textarea>
    </div>
    <div class="flex">
        <button id="runSmartBtn" class="btn-primary">🚀 Chạy thông minh (tự mua nếu thiếu VM)</button>
        <button id="runReplacerBtn" class="btn-success">▶ Kiểm tra & thay VM</button>
        <button id="buyCurrentBtn" class="btn-warning">🛒 Mua máy mới (auto-click)</button>
        <button id="retryAllErrorsBtn" class="btn-warning">🔄 Retry lỗi</button>
        <button id="stopBtn" class="btn-stop">⏹️ Dừng</button>
        <button id="exportCsvBtn">📎 Xuất CSV</button>
        <button id="clearTableBtn">🗑 Xóa bảng</button>
        <button id="saveConfigBtn">💾 Lưu cấu hình</button>
