</div>
<script>
    // Khởi tạo controller và gán sự kiện
    const controllerDef = ${JSON.stringify(UIController, (k,v) => typeof v === 'function' ? v.toString() : v)};
    const controller = {};
    for (let key in controllerDef) {
        if (typeof controllerDef[key] === 'string' && (controllerDef[key].includes('function') || controllerDef[key].includes('async'))) {
            controller[key] = eval('(' + controllerDef[key] + ')');
        } else {
            controller[key] = controllerDef[key];
        }
    }
    // Bind methods
    for (let key in controller) {
        if (typeof controller[key] === 'function') controller[key] = controller[key].bind(controller);
    }
    window.uiController = controller;
    // Gán CoreAPI
    window.CoreAPI = ${JSON.stringify(CoreAPI, (k,v) => typeof v === 'function' ? v.toString() : v)};
    const coreObj = {};
    for (let key in window.CoreAPI) {
        if (typeof window.CoreAPI[key] === 'string' && (window.CoreAPI[key].includes('async') || window.CoreAPI[key].includes('function'))) {
            coreObj[key] = eval('(' + window.CoreAPI[key] + ')');
        } else {
            coreObj[key] = window.CoreAPI[key];
        }
    }
    window.CoreAPI = coreObj;
    
    // Gán sự kiện
