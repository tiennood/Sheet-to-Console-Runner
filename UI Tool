                if (!accounts) accounts = localStorage.getItem('ugphone_last_accounts_popup');
                if (accounts) lastAccounts = JSON.parse(accounts);
                renderResults();
                addLog("📂 Đã tải " + lastResults.length + " kết quả cũ");
            } catch(e) {}
        }
