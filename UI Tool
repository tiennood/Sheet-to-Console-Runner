    async function runReplacer() {
        if (isRunning) { addLog("Đang chạy, hãy dừng trước", true); return; }
        const jsonText = document.getElementById('jsonInput').value.trim();
        const blackText = document.getElementById('blacklistInput').value.trim();
        if (!jsonText) return alert("Nhập JSON tài khoản");
        let accounts = [];
        try {
            let parsed = JSON.parse(jsonText);
            if (Array.isArray(parsed)) accounts = parsed;
            else accounts = jsonText.split(/\r?\n/).filter(l=>l.trim()).map(l=>JSON.parse(l));
        } catch(e) {
            const lines = jsonText.split(/\r?\n/);
            for (let l of lines) if(l.trim()) accounts.push(JSON.parse(l));
        }
        if (!accounts.length) return alert("Không có tài khoản");
        stopRequested = false;
        isRunning = true;
        lastAccounts = accounts;
        blackSet = parseBlacklist(blackText);
        lastResults = [];
        renderResults();
        saveConfig();
        for (let i = 0; i < accounts.length && !stopRequested; i++) {
            addLog('🔍 Xử lý ' + (i+1) + '/' + accounts.length + ': ' + (accounts[i]['UGPHONE-ID'] || accounts[i].loginId));
            const result = await processAccount(accounts[i], i, false);
            lastResults.push(result);
            renderResults();
            if (!stopRequested && i < accounts.length-1) await new Promise(r=>setTimeout(r, 2000));
        }
        isRunning = false;
        if (stopRequested) addLog("⏹️ Đã dừng theo yêu cầu");
        else addLog('🎉 Hoàn tất kiểm tra ' + accounts.length + ' tài khoản.');
        syncAccountsToTextarea();
        saveResults();
    }

    async function retryErrors() {
        if (isRunning) { addLog("Đang chạy, hãy dừng trước", true); return; }
        const errIdx = [];
        for (let i=0; i<lastResults.length; i++) if (lastResults[i].error) errIdx.push(i);
        if (errIdx.length === 0) { addLog("Không có lỗi để retry"); return; }
        stopRequested = false;
        isRunning = true;
        addLog("🔄 Retry " + errIdx.length + " tài khoản...");
        blackSet = parseBlacklist(document.getElementById('blacklistInput').value);
        for (let idx of errIdx) {
            if (stopRequested) break;
            const acc = lastAccounts[idx];
            if (!acc) continue;
            addLog("⏳ Retry " + (acc['UGPHONE-ID'] || acc.loginId));
            const auto = lastResults[idx].error && (lastResults[idx].error.includes('chưa có VM') || lastResults[idx].error.includes('chưa kích hoạt') || lastResults[idx].error.includes('đơn hàng VM'));
            const newRes = await processAccount(acc, idx, auto);
            lastResults[idx] = newRes;
            renderResults();
            if (newRes.waitBuy) {
                 await new Promise(r=>setTimeout(r, 25000));
            } else {
                 if (!stopRequested) await new Promise(r=>setTimeout(r, 2000));
            }
        }
        isRunning = false;
        if (stopRequested) addLog("⏹️ Dừng retry");
        else addLog("✅ Hoàn tất retry.");
        syncAccountsToTextarea();
        saveResults();
    }

