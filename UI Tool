// ===================== UI TOOL - DÙNG COREAPI NỘI BỘ =====================
(function() {
    // CoreAPI nhúng sẵn (tự chứa, không cần từ tab cha)
    const CoreAPI = {
        async safeFetch(url, options, retries = 3, delay = 1000) {
            for (let i = 0; i < retries; i++) {
                try {
                    const res = await fetch(url, options);
                    if (!res.ok) throw new Error(`HTTP ${res.status}`);
                    const contentType = res.headers.get('content-type');
                    if (contentType && contentType.includes('application/json')) return await res.json();
                    throw new Error("Response không phải JSON");
                } catch(err) {
                    if (i === retries - 1) throw err;
                    await new Promise(r => setTimeout(r, delay));
                }
            }
        },
        async fetchVMId(accessToken, loginId, fp, delay) {
            if (delay) await new Promise(r => setTimeout(r, delay));
            const headers = {
                "accept": "application/json", "content-type": "application/json;charset=UTF-8",
                "access-token": accessToken, "login-id": loginId,
                "web-fingerprint": fp || "0742f9ecfe480939f8d215d6db7ebedf",
                "terminal": "web", "lang": "vi", "update-date": Date.now()
            };
            const listData = await this.safeFetch("https://www.ugphone.com/api/apiv1/order/orderRecordList", {
                method: "POST", headers, body: JSON.stringify({ tab: "complete_record", page: 1, limit: 10 }), credentials: "include"
            });
            if (listData.code !== 200) throw new Error("Lỗi list: " + listData.msg);
            if (!listData.data.list.length) throw new Error("Chưa có VM");
            const orderId = listData.data.list[0].order_id;
            const statusData = await this.safeFetch("https://www.ugphone.com/api/apiv1/order/orderStatusProcess", {
                method: "POST", headers, body: JSON.stringify({ order_id: orderId }), credentials: "include"
            });
            if (statusData.code !== 200) throw new Error("Lỗi status: " + statusData.msg);
            const serviceIds = statusData.data.service_ids;
            if (!serviceIds.length) throw new Error("Không có service_ids");
            const snapData = await this.safeFetch("https://www.ugphone.com/api/apiv1/device/deviceSnapshot", {
                method: "POST", headers, body: JSON.stringify({ service_ids: serviceIds }), credentials: "include"
            });
            if (snapData.code !== 200) throw new Error("Lỗi snapshot: " + snapData.msg);
            const vmId = snapData.data.list[0].snapshot.split('/').pop().split('.')[0];
            return { vmId, serviceId: serviceIds[0] };
        },
        async replaceDevice(accessToken, loginId, fp, serviceId, reasonId, delay) {
            if (delay) await new Promise(r => setTimeout(r, delay));
            const headers = {
                "accept": "application/json", "content-type": "application/json;charset=UTF-8",
                "access-token": accessToken, "login-id": loginId,
                "web-fingerprint": fp || "0742f9ecfe480939f8d215d6db7ebedf",
                "terminal": "web", "lang": "vi", "update-date": Date.now()
            };
            const data = await this.safeFetch("https://www.ugphone.com/api/apiv1/replace_device/oneKeyNewDevice", {
                method: "POST", headers, body: JSON.stringify({ service_id: serviceId, replace_reason: reasonId, reason: "" }), credentials: "include"
            });
            if (data.code !== 200) throw new Error("Replace thất bại: " + data.msg);
            return data;
        }
    };

    // Tạo popup
    const popup = window.open("", "UGphoneTool", "width=900,height=650,resizable=yes,scrollbars=yes");
    if (!popup) { alert("Vui lòng cho phép popup!"); return; }

    const html = `<!DOCTYPE html>
<html>
<head><title>UGphone Tool</title>
<style>
    *{box-sizing:border-box}body{margin:0;background:#1a1a1a;color:#eee;font-family:Segoe UI,sans-serif;font-size:12px;height:100vh;overflow:hidden}
    .container{display:flex;flex-direction:column;height:100%;padding:15px;gap:10px}
    textarea,button{font-family:monospace;font-size:11px}
    textarea{background:#1e1e2f;color:#eee;border:1px solid #444;border-radius:6px;padding:8px;width:100%}
    button{background:#2c2c3e;border:none;color:#fff;padding:6px 12px;border-radius:6px;cursor:pointer}
    .btn-success{background:#10b981}.btn-primary{background:#3b82f6}.btn-warning{background:#f59e0b}.btn-danger{background:#ef4444}
    .table-wrapper{flex:1;overflow:auto;background:#0f0f1a;border-radius:8px;border:1px solid #2a2a3a}
    table{width:100%;border-collapse:collapse;font-size:11px}th,td{padding:6px 8px;border-bottom:1px solid #2a2a3a}
    th{background:#22223b;position:sticky;top:0}.log-area{background:#0a0a12;border-radius:8px;padding:6px;height:120px;overflow:auto;font-family:monospace;font-size:10px}
    .flex{display:flex;gap:8px;flex-wrap:wrap}
</style>
</head>
<body>
<div class="container">
    <textarea id="jsonInput" rows="3" placeholder='Danh sách tài khoản JSON, mỗi dòng một object hoặc mảng:\n[{"UGPHONE-Token":"xxx","UGPHONE-ID":"user1"}]'></textarea>
    <textarea id="blacklistInput" rows="2" placeholder='Blacklist VM ID (cách nhau dấu phẩy hoặc xuống dòng)'></textarea>
    <div class="flex">
        <button id="runBtn" class="btn-success">▶ Kiểm tra & thay VM</button>
        <button id="buyBtn" class="btn-primary">🛒 Mua máy mới (gửi lệnh)</button>
        <button id="retryBtn" class="btn-warning">🔄 Retry lỗi</button>
        <button id="stopBtn" class="btn-danger">⏹️ Dừng</button>
        <button id="exportBtn">📎 Xuất CSV</button>
        <button id="clearBtn">🗑 Xóa bảng</button>
        <button id="saveBtn">💾 Lưu cấu hình</button>
    </div>
    <div class="table-wrapper">
        <table id="resultTable"><thead><tr><th>#</th><th>Login ID</th><th>VM cũ</th><th>Black?</th><th>VM mới</th><th>Lỗi</th><th>Mua máy</th></tr></thead><tbody id="resultBody"></tbody></table>
    </div>
    <div class="log-area" id="logArea"></div>
</div>
<script>
    // ---------- Biến ----------
    let lastAccounts = [], lastResults = [], blackSet = new Set();
    let stopRequested = false, isRunning = false;
    const reasonId = "3kl5c04c-1nhd-z35e-0bsb-98aa9b13d09a";
    // Dùng CoreAPI đã được nhúng sẵn (từ biến toàn cục của popup)
    const core = window.CoreAPI;

    function addLog(msg, isErr) {
        const logDiv = document.getElementById('logArea');
        if (!logDiv) return;
        const p = document.createElement('div');
        p.style.color = isErr ? '#ff9999' : '#aaffaa';
        p.innerText = new Date().toLocaleTimeString() + ' → ' + msg;
        logDiv.appendChild(p);
        p.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        while (logDiv.children.length > 100) logDiv.removeChild(logDiv.firstChild);
    }

    function parseBlacklist(input) {
        input = (input || "").trim();
        if (!input) return new Set();
        if (input.startsWith('[') && input.endsWith(']')) {
            try { const arr = JSON.parse(input); if (Array.isArray(arr)) return new Set(arr.map(v=>v.trim())); } catch(e) {}
        }
        return new Set(input.split(/[,\\s\\n]+/).filter(s=>s.trim()));
    }

    async function processAccount(acc, idx, autoBuy) {
        const token = acc['UGPHONE-Token'] || acc['accessToken'];
        const loginId = acc['UGPHONE-ID'] || acc['loginId'];
        const fp = acc['ugBrowserId'] || acc['web-fingerprint'];
        if (!token || !loginId) return { loginId: loginId || ("Acc"+(idx+1)), error: "Thiếu token hoặc loginId" };
        try {
            const { vmId, serviceId } = await core.fetchVMId(token, loginId, fp, 1000);
            const isBlack = blackSet.has(vmId);
            if (isBlack) {
                addLog(\`⚫ VM \${vmId} bị black, replace...\`);
                await core.replaceDevice(token, loginId, fp, serviceId, reasonId, 2000);
                await new Promise(r=>setTimeout(r, 2000));
                const { vmId: newVm } = await core.fetchVMId(token, loginId, fp, 1000);
                return { loginId, oldVm: vmId, newVm, isBlack: true, error: null };
            } else {
                return { loginId, oldVm: vmId, newVm: vmId, isBlack: false, error: null };
            }
        } catch (err) {
            const noVm = err.message.includes('chưa có VM');
            if (autoBuy && noVm && window.opener) {
                addLog(\`🔄 Chưa có VM, gửi lệnh mua cho \${loginId}\`);
                window.opener.postMessage({ type: 'RUN_BUY_UG', account: acc }, '*');
                return { loginId, error: "Đã gửi yêu cầu mua, hãy thử lại sau 30s" };
            }
            return { loginId, error: err.message };
        }
    }

    function renderResults() {
        const tbody = document.getElementById('resultBody');
        if (!tbody) return;
        tbody.innerHTML = '';
        for (let i = 0; i < lastResults.length; i++) {
            const r = lastResults[i];
            const row = tbody.insertRow();
            row.insertCell(0).innerText = i+1;
            row.insertCell(1).innerText = r.loginId || '?';
            row.insertCell(2).innerText = r.oldVm || '';
            row.insertCell(3).innerText = r.isBlack ? 'Có' : (r.error ? '-' : 'Không');
            row.insertCell(4).innerText = r.newVm || '';
            row.insertCell(5).innerText = r.error || '';
            const buyCell = row.insertCell(6);
            const btn = document.createElement('button');
            btn.innerText = '🛒 Mua';
            btn.onclick = (async (idx) => {
                if (isRunning) { addLog("Đang chạy, hãy dừng trước", true); return; }
                const acc = lastAccounts[idx];
                if (!acc) return;
                if (window.opener) {
                    window.opener.postMessage({ type: 'RUN_BUY_UG', account: acc }, '*');
                    addLog(\`Đã gửi lệnh mua cho \${acc['UGPHONE-ID'] || acc.loginId}\`);
                } else {
                    addLog("Không có tab cha", true);
                }
            }).bind(null, i);
            buyCell.appendChild(btn);
        }
        saveResults();
    }

    function saveConfig() {
        const json = document.getElementById('jsonInput').value;
        const black = document.getElementById('blacklistInput').value;
        if (json) localStorage.setItem('ug_tool_json', json);
        localStorage.setItem('ug_tool_black', black);
        addLog("Đã lưu cấu hình");
    }
    function saveResults() {
        localStorage.setItem('ug_tool_results', JSON.stringify(lastResults));
        localStorage.setItem('ug_tool_accounts', JSON.stringify(lastAccounts));
    }
    function loadLocal() {
        const json = localStorage.getItem('ug_tool_json');
        if (json) document.getElementById('jsonInput').value = json;
        const black = localStorage.getItem('ug_tool_black');
        if (black) document.getElementById('blacklistInput').value = black;
        const res = localStorage.getItem('ug_tool_results');
        if (res) {
            try {
                lastResults = JSON.parse(res);
                lastAccounts = JSON.parse(localStorage.getItem('ug_tool_accounts') || '[]');
                renderResults();
                addLog("Đã tải " + lastResults.length + " kết quả");
            } catch(e) {}
        }
    }

    async function runReplacer() {
        if (isRunning) { addLog("Đang chạy, hãy dừng trước", true); return; }
        const jsonText = document.getElementById('jsonInput').value.trim();
        const blackText = document.getElementById('blacklistInput').value.trim();
        if (!jsonText) return alert("Nhập JSON");
        let accounts = [];
        try {
            let parsed = JSON.parse(jsonText);
            if (Array.isArray(parsed)) accounts = parsed;
            else accounts = jsonText.split(/\\r?\\n/).filter(l=>l.trim()).map(l=>JSON.parse(l));
        } catch(e) {
            const lines = jsonText.split(/\\r?\\n/);
            for (let l of lines) if(l.trim()) accounts.push(JSON.parse(l));
        }
        if (!accounts.length) return alert("Không có tài khoản");
        stopRequested = false;
        isRunning = true;
        lastAccounts = accounts;
        blackSet = parseBlacklist(blackText);
        lastResults = [];
        renderResults();
        saveConfig();
        for (let i = 0; i < accounts.length && !stopRequested; i++) {
            addLog(\`🔍 Xử lý \${i+1}/\${accounts.length}: \${accounts[i]['UGPHONE-ID'] || accounts[i].loginId}\`);
            const result = await processAccount(accounts[i], i, false);
            lastResults.push(result);
            renderResults();
            if (!stopRequested && i < accounts.length-1) await new Promise(r=>setTimeout(r, 2000));
        }
        isRunning = false;
        if (stopRequested) addLog("Đã dừng");
        else addLog(\`✅ Hoàn tất kiểm tra \${accounts.length} tài khoản.\`);
        saveResults();
    }

    async function retryErrors() {
        if (isRunning) { addLog("Đang chạy, hãy dừng trước", true); return; }
        const errIdx = [];
        for (let i=0; i<lastResults.length; i++) if (lastResults[i].error) errIdx.push(i);
        if (!errIdx.length) { addLog("Không có lỗi để retry"); return; }
        stopRequested = false;
        isRunning = true;
        addLog("🔄 Retry " + errIdx.length + " tài khoản...");
        blackSet = parseBlacklist(document.getElementById('blacklistInput').value);
        for (let idx of errIdx) {
            if (stopRequested) break;
            const acc = lastAccounts[idx];
            if (!acc) continue;
            addLog("⏳ Retry " + (acc['UGPHONE-ID'] || acc.loginId));
            const auto = lastResults[idx].error && lastResults[idx].error.includes('chưa có VM');
            const newRes = await processAccount(acc, idx, auto);
            lastResults[idx] = newRes;
            renderResults();
            if (!stopRequested) await new Promise(r=>setTimeout(r, 2000));
        }
        isRunning = false;
        if (stopRequested) addLog("Dừng retry");
        else addLog("✅ Hoàn tất retry.");
        saveResults();
    }

    function manualBuy() {
        if (isRunning) { addLog("Đang chạy, hãy dừng trước", true); return; }
        if (!lastAccounts.length) { addLog("Không có tài khoản", true); return; }
        if (window.opener) {
            window.opener.postMessage({ type: 'RUN_BUY_UG' }, '*');
            addLog("✅ Đã gửi yêu cầu mua máy đến tab cha.");
        } else {
            addLog("❌ Không có tab cha để gửi yêu cầu", true);
        }
    }

    function exportCSV() {
        let csv = "STT,Login ID,VM cũ,Blacklist?,VM mới,Lỗi\\n";
        for (let i=0; i<lastResults.length; i++) {
            const r = lastResults[i];
            csv += \`\${i+1},\${r.loginId||''},\${r.oldVm||''},\${r.isBlack?'Có':'Không'},\${r.newVm||''},\${r.error||''}\\n\`;
        }
        const blob = new Blob([csv], {type:"text/csv"});
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = "ugphone_result.csv";
        a.click();
        URL.revokeObjectURL(a.href);
    }

    function clearTable() {
        lastResults = [];
        lastAccounts = [];
        renderResults();
        addLog("Đã xóa bảng");
        saveResults();
    }

    function stopRun() {
        if (isRunning) { stopRequested = true; addLog("Đang dừng..."); }
        else addLog("Không có tiến trình");
    }

    // Gán sự kiện
    document.getElementById('runBtn').onclick = runReplacer;
    document.getElementById('buyBtn').onclick = manualBuy;
    document.getElementById('retryBtn').onclick = retryErrors;
    document.getElementById('stopBtn').onclick = stopRun;
    document.getElementById('exportBtn').onclick = exportCSV;
    document.getElementById('clearBtn').onclick = clearTable;
    document.getElementById('saveBtn').onclick = saveConfig;

    loadLocal();
    addLog("UI Tool sẵn sàng.");
    addLog("CoreAPI đã sẵn sàng (nội bộ).");
    if (window.opener) {
        addLog("Có tab cha, sẽ gửi postMessage khi mua máy.");
    } else {
        addLog("⚠️ Không có tab cha, chức năng mua máy sẽ không hoạt động.", true);
    }
</script>
</body>
</html>`;
    popup.document.write(html);
    popup.document.close();
})();