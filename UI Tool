        <table id="resultTable">
            <thead><tr><th>#</th><th>Login ID</th><th>VM cũ</th><th>Black?</th><th>VM mới</th><th>Lỗi</th><th>Hành động</th><th>Mua máy</th></tr></thead>
            <tbody id="resultBody"></tbody>
        </table>
