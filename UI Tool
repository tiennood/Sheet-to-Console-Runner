    async function processAccount(acc, idx, autoBuy) {
        const token = acc['UGPHONE-Token'] || acc['accessToken'];
        const loginId = acc['UGPHONE-ID'] || acc['loginId'];
        const fp = acc['ugBrowserId'] || acc['web-fingerprint'];
        if (!token || !loginId) return { loginId: loginId || ("Acc"+(idx+1)), error: "Thiếu token hoặc loginId" };
        try {
            const { vmId, serviceId } = await CoreAPI.fetchVMId(token, loginId, fp, 1000);
            const isBlack = blackSet.has(vmId);
            if (isBlack) {
                addLog('⚫ VM ' + vmId + ' bị black, replace...');
                await CoreAPI.replaceDevice(token, loginId, fp, serviceId, reasonId, 2000);
                await new Promise(r=>setTimeout(r, 2000));
                const { vmId: newVm } = await CoreAPI.fetchVMId(token, loginId, fp, 1000);
                return { loginId, oldVm: vmId, newVm, isBlack: true, error: null };
            } else {
                return { loginId, oldVm: vmId, newVm: vmId, isBlack: false, error: null };
            }
        } catch (err) {
            const noVm = err.message.includes('chưa có VM') || err.message.includes('chưa kích hoạt máy') || err.message.includes('Đơn hàng');
            if (autoBuy && noVm) {
                addLog('🔄 [Auto Mua] Chưa có VM, kích hoạt trình tự mua cho ' + loginId);
                await automateLoginAndBuyInParent(acc);
                return { loginId, error: "Đang tự động thực hiện Mua... Chờ 25s", waitBuy: true };
            }
            return { loginId, error: err.message };
        }
    }

    function renderResults() {
        const tbody = document.getElementById('resultBody');
        if (!tbody) return;
        tbody.innerHTML = '';
        for (let i = 0; i < lastResults.length; i++) {
            const r = lastResults[i];
            const row = tbody.insertRow();
            row.insertCell(0).innerText = i+1;
            row.insertCell(1).innerText = r.loginId || '?';
            row.insertCell(2).innerText = r.oldVm || '';
            row.insertCell(3).innerText = r.isBlack ? 'Có' : (r.error ? '-' : 'Không');
            row.insertCell(4).innerText = r.newVm || '';
            row.insertCell(5).innerText = r.error || '';
            const actionCell = row.insertCell(6);
            actionCell.className = "flex";
            actionCell.style.cssText = "display:flex; gap:4px; align-items:center;";

            // Nút "Cập nhật" riêng lẻ
            const updateBtn = document.createElement('button');
            updateBtn.innerHTML = '🔄 Cập nhật';
            updateBtn.style.cssText = 'background:#10b981; border:none; color:white; padding:2px 6px; font-size:10px; border-radius:4px; margin-right:2px;';
            updateBtn.onclick = (async (idx) => {
                if (isRunning) { addLog("Đang chạy hàng loạt, hãy dừng trước", true); return; }
                const acc = lastAccounts[idx];
                if (!acc) return;
                updateBtn.innerText = '🔄 Chờ...';
                updateBtn.disabled = true;
                addLog(`⏳ Đang cập nhật riêng lẻ cho: ` + (acc['UGPHONE-ID'] || acc.loginId));
                blackSet = parseBlacklist(document.getElementById('blacklistInput').value);
                try {
                    const res = await processAccount(acc, idx, false);
                    lastResults[idx] = res;
                    addLog(`✅ Cập nhật riêng lẻ thành công cho: ` + (acc['UGPHONE-ID'] || acc.loginId));
                } catch(e) {
                    lastResults[idx] = { loginId: acc['UGPHONE-ID'] || acc.loginId, error: e.message };
                    addLog(`❌ Lỗi cập nhật cho ` + (acc['UGPHONE-ID'] || acc.loginId) + `: ` + e.message, true);
                }
                renderResults();
            }).bind(null, i);

            // Nút "Mua máy" riêng lẻ
            const buyBtn = document.createElement('button');
            buyBtn.innerHTML = '🛒 Mua';
            buyBtn.style.cssText = 'background:#3b82f6; border:none; color:white; padding:2px 6px; font-size:10px; border-radius:4px; margin-right:2px;';
            buyBtn.onclick = (async (idx) => {
                if (isRunning) { addLog("Đang chạy hàng loạt, hãy dừng trước", true); return; }
                const acc = lastAccounts[idx];
                if (!acc) return;
                addLog(`🛒 Kích hoạt tiến trình Mua máy cho: ` + (acc['UGPHONE-ID'] || acc.loginId));
                await automateLoginAndBuyInParent(acc);
            }).bind(null, i);

            // Nút "Xóa" riêng lẻ
            const deleteBtn = document.createElement('button');
            deleteBtn.innerHTML = '❌ Xóa';
            deleteBtn.style.cssText = 'background:#ef4444; border:none; color:white; padding:2px 6px; font-size:10px; border-radius:4px;';
            deleteBtn.onclick = ((idx) => {
                const targetId = lastAccounts[idx] ? (lastAccounts[idx]['UGPHONE-ID'] || lastAccounts[idx].loginId) : '?';
                if (confirm(`Bạn có chắc muốn xóa tài khoản "${targetId}" khỏi bảng danh sách này không?`)) {
                    lastAccounts.splice(idx, 1);
                    lastResults.splice(idx, 1);
                    renderResults();
                    addLog(`❌ Đã xóa dòng tài khoản: ` + targetId);
                }
            }).bind(null, i);

            actionCell.appendChild(updateBtn);
            actionCell.appendChild(buyBtn);
            actionCell.appendChild(deleteBtn);
        }
        saveResults();
    }

