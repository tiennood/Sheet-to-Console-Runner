// ===================== REPLACE VM =====================
(function() {
    async function safeFetch(url, options, retries = 3, delay = 1000) {
        for (let i = 0; i < retries; i++) {
            try {
                const response = await fetch(url, options);
                if (!response.ok) {
                    if (response.status === 403) throw new Error("HTTP 403: Token hết hạn");
                    throw new Error(`HTTP ${response.status}`);
                }
                const contentType = response.headers.get('content-type');
                if (contentType && contentType.includes('application/json')) return await response.json();
                const text = await response.text();
                if (text.includes('<!DOCTYPE')) throw new Error("Server trả về HTML");
                throw new Error("Response không phải JSON");
            } catch(err) {
                if (err.message.includes('403')) throw err;
                if (i === retries - 1) throw err;
                await new Promise(r => setTimeout(r, delay));
            }
        }
    }

    async function fetchVMId(accessToken, loginId, webFingerprint, delayMs) {
        if (delayMs) await new Promise(r => setTimeout(r, delayMs));
        const headers = {
            "accept": "application/json, text/plain, */*",
            "content-type": "application/json;charset=UTF-8",
            "access-token": accessToken,
            "login-id": loginId,
            "web-fingerprint": webFingerprint || "0742f9ecfe480939f8d215d6db7ebedf",
            "terminal": "web",
            "lang": "vi",
            "update-date": Date.now().toString()
        };
        const listData = await safeFetch("https://www.ugphone.com/api/apiv1/order/orderRecordList", {
            method: "POST", headers, body: JSON.stringify({ tab: "complete_record", page: 1, limit: 10 }), credentials: "include"
        });
        if (listData.code !== 200) throw new Error(`Lỗi list: ${listData.msg}`);
        if (!listData.data.list.length) throw new Error("Không có đơn hàng");
        const orderId = listData.data.list[0].order_id;
        const statusData = await safeFetch("https://www.ugphone.com/api/apiv1/order/orderStatusProcess", {
            method: "POST", headers, body: JSON.stringify({ order_id: orderId }), credentials: "include"
        });
        if (statusData.code !== 200) throw new Error(`Lỗi status: ${statusData.msg}`);
        const serviceIds = statusData.data.service_ids;
        if (!serviceIds || !serviceIds.length) throw new Error("Không có service_ids");
        const snapData = await safeFetch("https://www.ugphone.com/api/apiv1/device/deviceSnapshot", {
            method: "POST", headers, body: JSON.stringify({ service_ids: serviceIds }), credentials: "include"
        });
        if (snapData.code !== 200) throw new Error(`Lỗi snapshot: ${snapData.msg}`);
        if (!snapData.data?.list || !snapData.data.list.length) {
            throw new Error("Không tìm thấy snapshot thiết bị. Có thể tài khoản chưa kích hoạt máy.");
        }
        const snapshotUrl = snapData.data.list[0].snapshot;
        if (!snapshotUrl) {
            throw new Error("Device snapshot URL rỗng.");
        }
        const fileName = snapshotUrl.split('/').pop() || "";
        const vmId = fileName.split('.')[0] || "Unknown";
        return { vmId, serviceId: serviceIds[0] };
    }

    async function replaceDevice(accessToken, loginId, webFingerprint, serviceId, reasonId, delayMs) {
        if (delayMs) await new Promise(r => setTimeout(r, delayMs));
        const headers = {
            "accept": "application/json, text/plain, */*",
            "content-type": "application/json;charset=UTF-8",
            "access-token": accessToken,
            "login-id": loginId,
            "web-fingerprint": webFingerprint || "0742f9ecfe480939f8d215d6db7ebedf",
            "terminal": "web",
            "lang": "vi",
            "update-date": Date.now().toString()
        };
        const body = JSON.stringify({ service_id: serviceId, replace_reason: reasonId, reason: "" });
        const data = await safeFetch("https://www.ugphone.com/api/apiv1/replace_device/oneKeyNewDevice", {
            method: "POST", headers, body, credentials: "include"
        });
        if (data.code !== 200) throw new Error(`Replace thất bại: ${data.msg}`);
        return data;
    }

    function parseBlacklist(input) {
        input = (input || "").trim();
        if (!input) return new Set();
        if (input.startsWith('[') && input.endsWith(']')) {
            try {
                const arr = JSON.parse(input);
                if (Array.isArray(arr)) return new Set(arr.map(v => String(v).trim()));
            } catch(e) {}
        }
        const items = input.split(/[,\s\n]+/).filter(s => s.trim().length > 0);
        return new Set(items);
    }

    async function processAccount(accountJson, blacklistSet, reasonId, delayMs, index, resultsArray) {
        try {
            const jsonObj = typeof accountJson === 'string' ? JSON.parse(accountJson) : accountJson;
            const accessToken = jsonObj['UGPHONE-Token'] || jsonObj['accessToken'];
            const loginId = jsonObj['UGPHONE-ID'] || jsonObj['loginId'];
            const webFingerprint = jsonObj['ugBrowserId'] || jsonObj['web-fingerprint'];
            if (!accessToken || !loginId) throw new Error("Thiếu token/login-id");

            const { vmId: oldVm, serviceId } = await fetchVMId(accessToken, loginId, webFingerprint, delayMs);
            const isBlacklisted = blacklistSet.has(oldVm);
            let newVm = oldVm;
            let action = isBlacklisted ? "Thay thế" : "Bỏ qua";
            let error = "";

            if (isBlacklisted) {
                await replaceDevice(accessToken, loginId, webFingerprint, serviceId, reasonId, delayMs);
                await new Promise(r => setTimeout(r, 2000));
                const { vmId: freshVm } = await fetchVMId(accessToken, loginId, webFingerprint, delayMs);
                newVm = freshVm;
            }
            resultsArray.push({ index, oldVm, isBlacklisted, action, newVm, error, success: true });
        } catch (err) {
            resultsArray.push({ index, oldVm: "Lỗi", isBlacklisted: false, action: "Thất bại", newVm: "", error: err.message, success: false });
        }
    }

    async function runReplacer(accounts, blacklistInput, delayMs = 3000, reasonId = "3kl5c04c-1nhd-z35e-0bsb-98aa9b13d09a") {
        if (!accounts || !accounts.length) throw new Error("Danh sách accounts trống");
        const blacklistSet = parseBlacklist(blacklistInput);
        const results = [];
        for (let i = 0; i < accounts.length; i++) {
            await processAccount(accounts[i], blacklistSet, reasonId, delayMs, i, results);
        }
        return results;
    }

    function exportToCSV(results) {
        let csv = "STT,VM cũ,Blacklist?,Hành động,VM mới,Lỗi\n";
        for (const r of results) {
            csv += `${r.index+1},${r.oldVm},${r.isBlacklisted ? "Có" : "Không"},${r.action},${r.newVm},${r.error}\n`;
        }
        const blob = new Blob([csv], {type: "text/csv;charset=utf-8;"});
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = "ugphone_results.csv";
        a.click();
        URL.revokeObjectURL(a.href);
    }

    window.UGPhoneReplacer = {
        run: runReplacer,
        parseBlacklist,
        exportToCSV
    };
    console.log("✅ UGPhoneReplacer ready. Dùng: await UGPhoneReplacer.run(accounts, blacklist, delay, reasonId)");
})();
