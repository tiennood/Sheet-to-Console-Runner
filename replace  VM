(function() {
    const container = document.createElement('div');
    container.style.cssText = `
        position: fixed;
        top: 10px;
        right: 10px;
        width: 500px;
        max-height: 780px;
        background: #1e1e2f;
        color: #eee;
        border-radius: 12px;
        z-index: 99999;
        box-shadow: 0 8px 20px rgba(0,0,0,0.5);
        display: flex;
        flex-direction: column;
        font-family: monospace;
        font-size: 11px;
        overflow: auto;
        padding: 10px;
    `;
    container.innerHTML = `
        <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
            <strong>🔧 UGphone Replacer</strong>
            <button id="closeBtn" style="background:#ef4444; border:none; color:white; border-radius:4px; padding:2px 6px;">✖</button>
        </div>
        <div style="margin-bottom: 8px;">
            <label>📦 JSON (mỗi dòng 1 object):</label>
            <textarea id="jsonListInput" rows="4" style="width:100%; background:#2d2d3f; color:white; border:1px solid #555; font-size:10px;" placeholder='{"UGPHONE-Token":"...","UGPHONE-ID":"..."}'></textarea>
        </div>
        <div style="margin-bottom: 8px;">
            <label>🚫 Blacklist VM (cách nhau dấu phẩy):</label>
            <textarea id="blacklistInput" rows="2" style="width:100%; background:#2d2d3f; color:white; border:1px solid #555; font-size:10px;" placeholder="VM010050015200, VM123456789012"></textarea>
        </div>
        <div style="margin-bottom: 8px;">
            <label>⏱️ Delay trước mỗi API (ms):</label>
            <input id="delayInput" type="number" style="width:100%; background:#2d2d3f; color:white; border:1px solid #555; font-size:10px;" value="3000">
        </div>
        <div style="margin-bottom: 8px;">
            <label>🔄 Replace reason ID:</label>
            <input id="reasonIdInput" type="text" style="width:100%; background:#2d2d3f; color:white; border:1px solid #555; font-size:10px;" value="3kl5c04c-1nhd-z35e-0bsb-98aa9b13d09a">
        </div>
        <div style="display: flex; gap: 6px; margin-bottom: 8px;">
            <button id="processBtn" style="background:#10b981; border:none; color:white; border-radius:4px; padding:4px 8px;">▶ Xử lý</button>
            <button id="exportBtn" style="background:#6b7280; border:none; color:white; border-radius:4px; padding:4px 8px;">📎 CSV</button>
            <button id="clearTableBtn" style="background:#f59e0b; border:none; color:white; border-radius:4px; padding:4px 8px;">🗑 Xóa</button>
        </div>
        <div style="overflow: auto; max-height: 500px;">
            <table id="resultTable" style="width:100%; border-collapse: collapse; font-size:10px;">
                <thead>
                    <tr style="background:#333;">
                        <th style="border:1px solid #444; padding:2px;">#</th>
                        <th style="border:1px solid #444; padding:2px;">VM cũ</th>
                        <th style="border:1px solid #444; padding:2px;">Black?</th>
                        <th style="border:1px solid #444; padding:2px;">Hành động</th>
                        <th style="border:1px solid #444; padding:2px;">VM mới</th>
                        <th style="border:1px solid #444; padding:2px;">Lỗi</th>
                    </tr>
                </thead>
                <tbody id="resultBody"></tbody>
            </table>
        </div>
    `;
    document.body.appendChild(container);

    // Hàm fetch có delay (tham số delayMs)
    async function fetchVMId(accessToken, loginId, webFingerprint, delayMs) {
        // Đợi delay trước khi gọi API đầu tiên
        if (delayMs > 0) await new Promise(r => setTimeout(r, delayMs));
        
        const headers = {
            "accept": "application/json, text/plain, */*",
            "content-type": "application/json;charset=UTF-8",
            "access-token": accessToken,
            "login-id": loginId,
            "web-fingerprint": webFingerprint || "0742f9ecfe480939f8d215d6db7ebedf",
            "terminal": "web",
            "lang": "vi",
            "update-date": Date.now().toString()
        };
        try {
            const listRes = await fetch("https://www.ugphone.com/api/apiv1/order/orderRecordList", {
                method: "POST", headers, body: JSON.stringify({ tab: "complete_record", page: 1, limit: 10 }), credentials: "include"
            });
            const listData = await listRes.json();
            if (listData.code !== 200) throw new Error(`Lỗi list: ${listData.msg}`);
            if (!listData.data.list.length) throw new Error("Không có đơn hàng");
            const orderId = listData.data.list[0].order_id;
            const statusRes = await fetch("https://www.ugphone.com/api/apiv1/order/orderStatusProcess", {
                method: "POST", headers, body: JSON.stringify({ order_id: orderId }), credentials: "include"
            });
            const statusData = await statusRes.json();
            if (statusData.code !== 200) throw new Error(`Lỗi status: ${statusData.msg}`);
            const serviceIds = statusData.data.service_ids;
            if (!serviceIds || !serviceIds.length) throw new Error("Không có service_ids");
            const snapRes = await fetch("https://www.ugphone.com/api/apiv1/device/deviceSnapshot", {
                method: "POST", headers, body: JSON.stringify({ service_ids: serviceIds }), credentials: "include"
            });
            const snapData = await snapRes.json();
            if (snapData.code !== 200) throw new Error(`Lỗi snapshot: ${snapData.msg}`);
            const snapshotUrl = snapData.data.list[0].snapshot;
            const vmId = snapshotUrl.split('/').pop().split('.')[0];
            return { vmId, serviceId: serviceIds[0] };
        } catch (err) {
            throw new Error(err.message);
        }
    }

    async function replaceDevice(accessToken, loginId, webFingerprint, serviceId, reasonId, delayMs) {
        if (delayMs > 0) await new Promise(r => setTimeout(r, delayMs));
        const headers = {
            "accept": "application/json, text/plain, */*",
            "content-type": "application/json;charset=UTF-8",
            "access-token": accessToken,
            "login-id": loginId,
            "web-fingerprint": webFingerprint || "0742f9ecfe480939f8d215d6db7ebedf",
            "terminal": "web",
            "lang": "vi",
            "update-date": Date.now().toString()
        };
        const body = JSON.stringify({ service_id: serviceId, replace_reason: reasonId, reason: "" });
        const res = await fetch("https://www.ugphone.com/api/apiv1/replace_device/oneKeyNewDevice", {
            method: "POST", headers, body, credentials: "include"
        });
        const data = await res.json();
        if (data.code !== 200) throw new Error(`Replace thất bại: ${data.msg}`);
        return data;
    }

    async function processAccount(accountJson, blacklistSet, reasonId, delayMs, index) {
        const row = document.getElementById(`row-${index}`);
        const oldVmCell = row.cells[1];
        const inBlacklistCell = row.cells[2];
        const actionCell = row.cells[3];
        const newVmCell = row.cells[4];
        const errorCell = row.cells[5];
        
        try {
            let jsonObj = typeof accountJson === 'string' ? JSON.parse(accountJson) : accountJson;
            const accessToken = jsonObj['UGPHONE-Token'] || jsonObj['accessToken'];
            const loginId = jsonObj['UGPHONE-ID'] || jsonObj['loginId'];
            const webFingerprint = jsonObj['ugBrowserId'] || jsonObj['web-fingerprint'];
            if (!accessToken || !loginId) throw new Error("Thiếu token/login-id");

            // Gọi API lấy VM hiện tại (có delay)
            const { vmId: oldVm, serviceId } = await fetchVMId(accessToken, loginId, webFingerprint, delayMs);
            oldVmCell.innerText = oldVm;
            const isBlacklisted = blacklistSet.has(oldVm);
            inBlacklistCell.innerText = isBlacklisted ? "Có" : "Không";
            actionCell.innerText = isBlacklisted ? "Thay thế" : "Bỏ qua";
            
            if (isBlacklisted) {
                // Replace device (cũng có delay trước khi gọi)
                await replaceDevice(accessToken, loginId, webFingerprint, serviceId, reasonId, delayMs);
                // Chờ 2 giây cho đơn hàng mới tạo
                await new Promise(r => setTimeout(r, 2000));
                // Lấy VM mới (có delay)
                const { vmId: newVm } = await fetchVMId(accessToken, loginId, webFingerprint, delayMs);
                newVmCell.innerText = newVm;
                errorCell.innerText = "";
                row.style.backgroundColor = "#2a5a2a";
            } else {
                newVmCell.innerText = oldVm;
                errorCell.innerText = "";
                row.style.backgroundColor = "#2a5a2a";
            }
        } catch (err) {
            errorCell.innerText = err.message;
            row.style.backgroundColor = "#7a2a2a";
        }
    }

    async function run() {
        const jsonText = document.getElementById('jsonListInput').value.trim();
        const blacklistText = document.getElementById('blacklistInput').value.trim();
        const delayMs = parseInt(document.getElementById('delayInput').value) || 0;
        const reasonId = document.getElementById('reasonIdInput').value.trim() || "3kl5c04c-1nhd-z35e-0bsb-98aa9b13d09a";
        if (!jsonText) return alert("Nhập JSON");
        let accounts = [];
        try {
            let parsed = JSON.parse(jsonText);
            if (Array.isArray(parsed)) accounts = parsed;
            else accounts = jsonText.split(/\r?\n/).filter(l=>l.trim()).map(l=>JSON.parse(l));
        } catch(e) {
            const lines = jsonText.split(/\r?\n/);
            for (let line of lines) {
                if (line.trim()) accounts.push(JSON.parse(line));
            }
        }
        if (!accounts.length) return alert("Không có JSON");
        const blacklistSet = new Set(blacklistText.split(/[,\s\n]+/).filter(s=>s.trim()));
        const tbody = document.getElementById('resultBody');
        tbody.innerHTML = '';
        for (let i = 0; i < accounts.length; i++) {
            const row = tbody.insertRow();
            row.id = `row-${i}`;
            row.innerHTML = `<tr>${i+1}</td><td>⏳</td><td>⏳</td><td>⏳</td><td>⏳</td><td></td>`;
        }
        for (let i = 0; i < accounts.length; i++) {
            await processAccount(accounts[i], blacklistSet, reasonId, delayMs, i);
        }
    }

    function exportCSV() {
        let csv = "STT,VM cũ,Blacklist?,Hành động,VM mới,Lỗi\n";
        document.querySelectorAll('#resultBody tr').forEach(row => {
            const cells = row.cells;
            csv += `${cells[0].innerText},${cells[1].innerText},${cells[2].innerText},${cells[3].innerText},${cells[4].innerText},${cells[5].innerText}\n`;
        });
        const blob = new Blob([csv], {type: "text/csv"});
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = "ugphone_results.csv";
        a.click();
        URL.revokeObjectURL(a.href);
    }

    function clearTable() { document.getElementById('resultBody').innerHTML = ''; }
    document.getElementById('processBtn').onclick = run;
    document.getElementById('exportBtn').onclick = exportCSV;
    document.getElementById('clearTableBtn').onclick = clearTable;
    document.getElementById('closeBtn').onclick = () => container.remove();
})();
