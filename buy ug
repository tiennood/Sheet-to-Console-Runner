// ===================== BUY UG =====================
(function() {
    console.log('🚀 Script auto click mua máy (đã cải tiến - dùng text-matching & auto-wait-clickable)');

    let activeIntervals = [];
    function trackInterval(intervalId) {
        activeIntervals.push(intervalId);
        return intervalId;
    }
    function clearIntervalTracked(intervalId) {
        clearInterval(intervalId);
        activeIntervals = activeIntervals.filter(i => i !== intervalId);
    }
    function clearAllIntervals() {
        activeIntervals.forEach(clearInterval);
        activeIntervals = [];
    }

    async function waitForElement(options, timeout = 15000) {
        return new Promise((resolve) => {
            const { selector, text, tag = 'div', contains = true } = options;
            const start = Date.now();
            const interval = setInterval(() => {
                let el = null;
                if (selector) {
                    el = document.querySelector(selector);
                } else if (text) {
                    const elements = document.querySelectorAll(tag);
                    for (let e of elements) {
                        const match = contains ? e.innerText.includes(text) : e.innerText.trim() === text;
                        if (match) { el = e; break; }
                    }
                }
                if (el) {
                    clearIntervalTracked(interval);
                    resolve(el);
                } else if (Date.now() - start > timeout) {
                    clearIntervalTracked(interval);
                    resolve(null);
                }
            }, 200);
            trackInterval(interval);
        });
    }

    async function waitForClickable(options, timeout = 15000) {
        const start = Date.now();
        while (Date.now() - start < timeout) {
            const el = await waitForElement(options, 2000);
            if (el) {
                const isDisabled = el.disabled || 
                                   el.classList?.contains('van-button--disabled') || 
                                   el.classList?.contains('van-button--loading') || 
                                   el.getAttribute('aria-disabled') === 'true';
                if (!isDisabled) {
                    return el;
                }
            }
            await new Promise(r => setTimeout(r, 200));
        }
        return null;
    }

    async function clickByTexts(listOfTexts, tagList = ['span', 'div', 'button', 'a', 'p'], timeout = 15000) {
        const start = Date.now();
        while (Date.now() - start < timeout) {
            for (const tag of tagList) {
                const elements = document.querySelectorAll(tag);
                for (const el of elements) {
                    if (!(el.offsetWidth > 0 || el.offsetHeight > 0)) continue;
                    const textContent = (el.innerText || el.textContent || "").trim();
                    for (const targetText of listOfTexts) {
                        if (textContent === targetText || textContent.includes(targetText)) {
                            const isDisabled = el.disabled || 
                                               el.classList?.contains('van-button--disabled') || 
                                               el.classList?.contains('van-button--loading');
                            if (!isDisabled) {
                                el.click();
                                console.log(`✅ Đã click: "${targetText}" (Tag: ${tag})`);
                                return true;
                            }
                        }
                    }
                }
            }
            await new Promise(r => setTimeout(r, 300));
        }
        return false;
    }

    async function ensureDashboardPage() {
        const targetUrl = 'https://www.ugphone.com/toc-portal/#/dashboard/index';
        const currentUrl = window.location.href;
        if (currentUrl === targetUrl || currentUrl.includes('/dashboard/index')) {
            console.log('✅ Đã đúng trang dashboard');
            return true;
        }
        console.log(`🧭 Đang tự động chuyển hướng đến trang dashboard: ${targetUrl}...`);
        window.location.href = targetUrl;
        throw new Error("Đang chuyển hướng trang web... Vui lòng chạy lại kịch bản sau khi trang load xong.");
    }

    async function waitForPurchaseDevicePage(timeout = 15000) {
        console.log('⏳ Chờ chuyển đến trang /purchaseDevice...');
        const start = Date.now();
        while (Date.now() - start < timeout) {
            if (window.location.hash.includes('purchaseDevice') || 
                window.location.pathname.includes('purchaseDevice')) {
                console.log('✅ Đã vào đúng trang purchaseDevice');
                await new Promise(r => setTimeout(r, 1000));
                return true;
            }
            await new Promise(r => setTimeout(r, 500));
        }
        console.error('❌ Không chuyển được sang purchaseDevice');
        return false;
    }

    async function run() {
        const overallTimeout = 60000;
        const timeoutPromise = new Promise((_, reject) => {
            setTimeout(() => {
                clearAllIntervals();
                reject(new Error("Overall timeout 60s"));
            }, overallTimeout);
        });
        
        const mainPromise = (async () => {
            try {
                await ensureDashboardPage();
                
                console.log('⏳ Bước 1: Ấn nút "Get" (hoặc "Get Now") để vào trang mua máy...');
                const pressedGet = await clickByTexts(['Get', 'Get Now', 'Get now', 'Nhận ngay', 'Nhận'], ['span', 'div', 'button', 'p']);
                if (!pressedGet) {
                    const fallbackGet = document.querySelector('.get-btn, [class*="get-btn"], [id*="get-btn"]');
                    if (fallbackGet) { fallbackGet.click(); console.log('✅ Click Get fallback selector'); }
                    else throw new Error("Không tìm thấy nút Get trên dashboard");
                }

                const isOnPurchasePage = await waitForPurchaseDevicePage();
                if (!isOnPurchasePage) throw new Error("Không thể chuyển tới trang purchaseDevice");

                console.log('⏳ Bước 2: Chọn Booking items (ví dụ UVIP hoặc UVIP-HK)...');
                await new Promise(r => setTimeout(r, 1000));
                await clickByTexts(['UVIP HK', 'UVIP-HK', 'UVIP_HK', 'UVIP'], ['span', 'div', 'p', 'h3']);

                console.log('⏳ Bước 3: Chọn Server / Area (Hong Kong, Hongkong)...');
                await new Promise(r => setTimeout(r, 1000));
                await clickByTexts(['Hong Kong', 'HongKong', 'HK', 'HongKong-UVIP'], ['span', 'div', 'p']);

                console.log('⏳ Bước 4: Chọn gói package (Ví dụ: 250 Diamond)...');
                await new Promise(r => setTimeout(r, 1000));
                const activeCard = await clickByTexts(['250Diamond', '250 Kim Cương', '1 Day', '1 Ngày', '250'], ['span', 'div', 'p', 'h3', 'h4']);
                if (!activeCard) {
                    const fallbackCard = document.querySelector('.room-item, .card-item, .item-card');
                    if (fallbackCard) { fallbackCard.click(); console.log('✅ Click fallback card'); }
                }

                console.log('⏳ Bước 5: Ấn nút Buy hoặc Buy Now...');
                await new Promise(r => setTimeout(r, 1000));
                const buyBtnClicked = await clickByTexts(['Buy', 'Buy Now', 'Mua', 'Mua ngay'], ['span', 'button', 'div', 'p']);
                if (!buyBtnClicked) {
                    const fallbackBuy = document.querySelector('#buy-btn, .buy-btn, [class*="buy-btn"]');
                    if (fallbackBuy) { fallbackBuy.click(); console.log('✅ Click fallback button Buy'); }
                    else throw new Error("Không thấy nút bấm Mua");
                }

                console.log('⏳ Bước 6: Chờ màn thanh toán, chọn thanh toán bằng Diamond...');
                await new Promise(r => setTimeout(r, 2000));
                await clickByTexts(['Use 250Diamond Payment', '250Diamond', 'Diamond Payment', 'Diamond'], ['span', 'div', 'p', 'label']);

                console.log('⏳ Bước 7: Xác nhận thanh toán (Pay button)...');
                await new Promise(r => setTimeout(r, 1000));
                
                // Wait for the button to be clickable, non-disabled (safely bypasses van-button--disabled/loading)
                const payBtnEl = await waitForClickable({ text: 'Pay', tag: 'button' }, 10000) || 
                                 await waitForClickable({ text: 'Thanh toán', tag: 'button' }, 5000) ||
                                 await waitForClickable({ text: 'Xác nhận', tag: 'button' }, 5000);
                                 
                if (payBtnEl) {
                    payBtnEl.click();
                    console.log('💰 ĐÃ KÍCH HOẠT THANH TOÁN THÀNH CÔNG!');
                } else {
                    const finalPay = await clickByTexts(['Pay', 'Thanh toán', 'Confirm', 'Xác nhận', 'Pay Now'], ['span', 'button', 'div']);
                    if (finalPay) console.log('💰 Đã click thanh toán!');
                    else console.warn('⚠️ Không tìm được nút Pay khả dụng');
                }
                
                console.log('🏁 Kết thúc thành công');
            } finally {
                clearAllIntervals();
            }
        })();

        await Promise.race([mainPromise, timeoutPromise]);
    }

    window.addEventListener('message', function(event) {
        if (event.data && event.data.type === 'RUN_BUY_UG') {
            console.log('📩 Nhận lệnh mua máy từ popup');
            run().catch(console.error);
        }
    });

    window.buyUG = run;
    console.log("✅ Buy UG script loaded. Dùng await buyUG() để chạy mua máy.");
})();
