// ==UserScript==
// @name         UGPhone Auto Purchase Full
// @namespace    http://tampermonkey.net/
// @version      1.0
// @description  Tự động click "Đi nhận" -> "Đặt mua" -> "Thanh toán" trên UGPhone
// @author       You
// @match        https://www.ugphone.com/toc-portal/*
// @icon         https://www.google.com/s2/favicons?sz=64&domain=ugphone.com
// @grant        none
// ==/UserScript==

(async function() {
    'use strict';

    // Selectors
    const selectorGetBtn = 'div.get-btn';                     // Nút "Đi nhận"
    const selectorOrderBtn = 'button#buy-btn';                // Nút "Đặt mua" (trang purchaseDevice)
    const selectorPayBtn = 'button#buy-btn';                  // Nút "Thanh toán" (trang thanh toán)

    // Hàm chờ phần tử xuất hiện
    function waitForElement(selector, timeout = 10000) {
        return new Promise((resolve, reject) => {
            const el = document.querySelector(selector);
            if (el) return resolve(el);
            const observer = new MutationObserver(() => {
                const el = document.querySelector(selector);
                if (el) {
                    observer.disconnect();
                    resolve(el);
                }
            });
            observer.observe(document.body, { childList: true, subtree: true });
            setTimeout(() => {
                observer.disconnect();
                reject(new Error(`Timeout: không tìm thấy ${selector}`));
            }, timeout);
        });
    }

    // Hàm chuyển hướng trang (chờ 3 giây)
    function navigateTo(url) {
        return new Promise((resolve) => {
            window.location.href = url;
            setTimeout(() => resolve(), 3000);
        });
    }

    // Hàm click và log
    async function clickWithLog(selector, stepName) {
        try {
            console.log(`\n🔍 [${stepName}] Đang tìm phần tử...`);
            const btn = await waitForElement(selector);
            console.log(`✅ [${stepName}] Đã tìm thấy (${btn.tagName}, class: ${btn.className})`);
            console.log(`📍 URL trước click: ${window.location.href}`);
            btn.click();
            console.log(`🖱️ Đã click thành công.`);
            await new Promise(r => setTimeout(r, 2000));
            console.log(`📍 URL sau click: ${window.location.href}`);
        } catch (err) {
            console.error(`❌ [${stepName}] Lỗi: ${err.message}`);
        }
    }

    // ---------- BẮT ĐẦU QUY TRÌNH ----------
    console.log('🚀 Bắt đầu tự động hóa UGPhone...');

    // Bước 1: Điều hướng đến Dashboard
    console.log('\n📌 Bước 1: Điều hướng đến Dashboard');
    await navigateTo('https://www.ugphone.com/toc-portal/#/dashboard/index');

    // Bước 2: Click "Đi nhận"
    await clickWithLog(selectorGetBtn, 'Đi nhận');

    // Bước 3: Đảm bảo đang ở trang purchaseDevice
    if (!window.location.href.includes('purchaseDevice')) {
        console.log('⚠️ Chưa ở trang purchaseDevice, điều hướng thủ công...');
        await navigateTo('https://www.ugphone.com/toc-portal/#/purchaseDevice');
    } else {
        console.log('✅ Đã ở trang purchaseDevice');
    }

    // Bước 4: Click "Đặt mua"
    await clickWithLog(selectorOrderBtn, 'Đặt mua');

    // Bước 5: Chờ trang thanh toán load và click "Thanh toán"
    // Lưu ý: Sau khi click "Đặt mua", trang sẽ chuyển hướng đến thanh toán (có thể chứa "freeTest").
    // Ta chỉ cần chờ nút "Thanh toán" xuất hiện (cùng selector #buy-btn nhưng ở trang khác).
    console.log('\n📌 Bước 5: Chờ nút thanh toán xuất hiện...');
    await waitForElement(selectorPayBtn, 15000); // chờ tối đa 15 giây
    await clickWithLog(selectorPayBtn, 'Thanh toán');

    console.log('\n✅ Hoàn thành toàn bộ quy trình!');
})();
