// ===================== BUY UG =====================
(function() {
    console.log('🚀 Script auto click mua máy (đã sửa - chờ gọi buyUG())');

    function waitForElement(options, timeout = 15000) {
        return new Promise((resolve) => {
            const { selector, text, tag = 'div', contains = true } = options;
            const start = Date.now();
            const interval = setInterval(() => {
                let el = null;
                if (selector) {
                    el = document.querySelector(selector);
                } else if (text) {
                    const elements = document.querySelectorAll(tag);
                    for (let e of elements) {
                        const match = contains ? e.innerText.includes(text) : e.innerText.trim() === text;
                        if (match) { el = e; break; }
                    }
                }
                if (el) {
                    clearInterval(interval);
                    resolve(el);
                } else if (Date.now() - start > timeout) {
                    clearInterval(interval);
                    resolve(null);
                }
            }, 200);
        });
    }

    async function safeClick(options, timeout = 15000) {
        const el = await waitForElement(options, timeout);
        if (!el) {
            console.log(`❌ Không tìm thấy: ${options.text || options.selector}`);
            return false;
        }
        if (el.disabled || el.classList?.contains('van-button--disabled')) {
            console.log(`⚠️ Phần tử bị disabled: ${options.text || options.selector}`);
            return false;
        }
        el.click();
        console.log(`✅ Click: ${options.text || options.selector}`);
        return true;
    }

    async function ensureDashboardPage() {
        const targetUrl = 'https://www.ugphone.com/toc-portal/#/dashboard/index';
        const currentUrl = window.location.href;
        if (currentUrl === targetUrl) {
            console.log('✅ Đã đúng trang dashboard');
            return true;
        }
        console.log(`⚠️ Đang ở ${currentUrl}, chuyển sang dashboard...`);
        window.location.href = targetUrl;
        return new Promise((resolve) => {
            const checkInterval = setInterval(() => {
                if (window.location.href === targetUrl) {
                    clearInterval(checkInterval);
                    console.log('✅ Đã chuyển xong sang dashboard');
                    setTimeout(() => resolve(true), 1500);
                }
            }, 500);
        });
    }

    async function waitForPurchaseDevicePage(timeout = 15000) {
        console.log('⏳ Chờ chuyển đến trang /purchaseDevice...');
        const start = Date.now();
        while (Date.now() - start < timeout) {
            if (window.location.hash.includes('purchaseDevice') || 
                window.location.pathname.includes('purchaseDevice')) {
                console.log('✅ Đã vào đúng trang purchaseDevice');
                await new Promise(r => setTimeout(r, 1000));
                return true;
            }
            await new Promise(r => setTimeout(r, 500));
        }
        console.error('❌ Không chuyển được sang purchaseDevice');
        return false;
    }

    async function waitForHongKong(timeout = 30000) {
        const start = Date.now();
        while (Date.now() - start < timeout) {
            const items = document.querySelectorAll('.room-item');
            let hkItem = null;
            for (let item of items) {
                if (item.innerText.includes('Hong Kong')) {
                    hkItem = item;
                    break;
                }
            }
            if (hkItem) {
                const needClick = !hkItem.classList.contains('active-btn');
                return { element: hkItem, needClick };
            }
            await new Promise(r => setTimeout(r, 1000));
        }
        throw new Error("Timeout tìm Hong Kong");
    }

    async function waitForGetButton(timeout = 30000) {
        const start = Date.now();
        while (Date.now() - start < timeout) {
            const getBtn = await waitForElement({ text: 'Get', tag: 'span', contains: false }, 2000);
            if (getBtn) return getBtn;
            await new Promise(r => setTimeout(r, 1000));
        }
        throw new Error("Timeout tìm nút Get");
    }

    async function run() {
        const overallTimeout = 60000;
        const timeoutPromise = new Promise((_, reject) => setTimeout(() => reject(new Error("Overall timeout 60s")), overallTimeout));
        
        const mainPromise = (async () => {
            await ensureDashboardPage();
            const getButton = await waitForGetButton();
            if (getButton.disabled) console.warn('⚠️ Nút Get đang disabled, vẫn thử click');
            getButton.click();
            console.log('✅ Click Get');

            const isOnPurchasePage = await waitForPurchaseDevicePage();
            if (!isOnPurchasePage) throw new Error("Không thể vào trang purchaseDevice");

            const { element: hkEl, needClick } = await waitForHongKong();
            if (needClick) {
                hkEl.click();
                console.log('✅ Đã click Hong Kong');
            }

            const cardClicked = await safeClick({ selector: '#active-card' }, 10000);
            if (!cardClicked) throw new Error("Không click được card");

            const buyClicked = await safeClick({ selector: '#buy-btn:not(.van-button--disabled):not(.van-button--loading)' }, 15000);
            if (!buyClicked) throw new Error("Không click được Buy");

            console.log('Đã click Buy, chờ màn thanh toán...');
            const payFree = await waitForElement({ selector: '#pay-free-sel' }, 20000);
            if (payFree && payFree.innerText.includes('Use 250Diamond Payment')) {
                console.log('✅ #pay-free-sel đã xuất hiện');
                const payClicked = await safeClick({ text: 'Pay', tag: 'button' }, 10000);
                if (payClicked) console.log('💰 Đã thanh toán!');
                else console.warn('⚠️ Không click được Pay');
            } else {
                console.warn('⚠️ Không tìm thấy #pay-free-sel hoặc text sai, thử click Pay bằng selector khác');
                await safeClick({ selector: 'button:contains("Pay")' }, 5000);
            }
            console.log('🏁 Kết thúc thành công');
        })();

        await Promise.race([mainPromise, timeoutPromise]);
    }

    window.buyUG = run;
    console.log("✅ Buy UG script loaded. Dùng await buyUG() để chạy mua máy.");
})();