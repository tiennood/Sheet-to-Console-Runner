// ==UserScript==
// @name         UGPhone Auto Click 3 Buttons (Custom Selector)
// @namespace    http://tampermonkey.net/
// @version      10.0
// @description  Kiểm tra 3 nút: "Đi nhận" (XPath), "Đặt mua" (XPath), "Thanh toán" (CSS: #buy-btn > div > span)
// @match        https://www.ugphone.com/toc-portal/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(async function() {
    'use strict';

    // Định nghĩa các nút: mỗi nút có một hàm tìm riêng (selector hoặc XPath)
    const buttons = [
        {
            name: 'Đi nhận',
            find: () => document.evaluate(
                "//div[contains(@class, 'get-btn') and contains(., 'Đi nhận')]",
                document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null
            ).singleNodeValue
        },
        {
            name: 'Đặt mua',
            find: () => document.evaluate(
                "//*[contains(text(), 'Đặt mua')]",
                document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null
            ).singleNodeValue
        },
        {
            name: 'Thanh toán',
            find: () => document.querySelector('#buy-btn > div > span') // CSS selector theo yêu cầu
        }
    ];

    // Hàm tìm nút đầu tiên xuất hiện
    function findAnyButton() {
        for (let btn of buttons) {
            const el = btn.find();
            if (el) return { el, name: btn.name };
        }
        return null;
    }

    async function clickButton(el, name) {
        try {
            el.click();
            console.log(`[UGPhone] ✅ Đã click: "${name}"`);
            await new Promise(r => setTimeout(r, 1000));
            return true;
        } catch (err) {
            console.error(`[UGPhone] ❌ Lỗi click "${name}":`, err);
            return false;
        }
    }

    async function run() {
        while (true) {
            const found = findAnyButton();
            if (found) {
                await clickButton(found.el, found.name);
                // Sau khi click, tiếp tục vòng lặp ngay (trang có thể đã chuyển)
            } else {
                console.log(`[UGPhone] ⏳ Không thấy nút nào, chờ 5 giây...`);
                await new Promise(r => setTimeout(r, 5000));
            }
        }
    }

    run();
})();
