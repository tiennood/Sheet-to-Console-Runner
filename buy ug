(function autoClickFixed() {
    console.log('🚀 Script auto click (sửa lỗi tìm Hong Kong, chỉ kiểm tra #pay-free-sel)');

    // Helper: chờ phần tử xuất hiện (không loop vô hạn, có timeout)
    function waitForElement(options) {
        return new Promise((resolve) => {
            const { selector, text, tag = 'div', timeout = 15000, contains = true, interval = 200 } = options;
            const start = Date.now();
            const checkInterval = setInterval(() => {
                let el = null;
                if (selector) {
                    el = document.querySelector(selector);
                } else if (text) {
                    const elements = document.querySelectorAll(tag);
                    for (let e of elements) {
                        const match = contains ? e.innerText.includes(text) : e.innerText.trim() === text;
                        if (match) {
                            el = e;
                            break;
                        }
                    }
                }
                if (el) {
                    clearInterval(checkInterval);
                    resolve(el);
                } else if (Date.now() - start > timeout) {
                    clearInterval(checkInterval);
                    resolve(null);
                }
            }, interval);
        });
    }

    async function safeClick(options) {
        const el = await waitForElement(options);
        if (!el) {
            console.log(`❌ Không tìm thấy: ${options.text || options.selector}`);
            return false;
        }
        if (el.disabled || el.classList?.contains('van-button--disabled')) {
            console.log(`⚠️ Phần tử bị disabled: ${options.text || options.selector}`);
            return false;
        }
        el.click();
        console.log(`✅ Click: ${options.text || options.selector}`);
        return true;
    }

    // Đảm bảo đang ở trang dashboard, nếu không thì chuyển hướng
    async function ensureDashboardPage() {
        const targetUrl = 'https://www.ugphone.com/toc-portal/#/dashboard/index';
        const currentUrl = window.location.href;
        if (currentUrl === targetUrl) {
            console.log('✅ Đã đúng trang dashboard');
            return true;
        }
        console.log(`⚠️ Đang ở ${currentUrl}, chuyển sang dashboard...`);
        window.location.href = targetUrl;
        // Chờ trang mới load và DOM sẵn sàng
        return new Promise((resolve) => {
            const checkInterval = setInterval(() => {
                if (window.location.href === targetUrl) {
                    clearInterval(checkInterval);
                    console.log('✅ Đã chuyển xong sang dashboard');
                    // Chờ thêm 1.5s để React render
                    setTimeout(() => resolve(true), 1500);
                }
            }, 500);
        });
    }

    // Chờ URL hoặc DOM của trang purchaseDevice
    async function waitForPurchaseDevicePage() {
        console.log('⏳ Chờ chuyển đến trang /purchaseDevice...');
        const start = Date.now();
        while (Date.now() - start < 15000) {
            if (window.location.hash.includes('purchaseDevice') || 
                window.location.pathname.includes('purchaseDevice')) {
                console.log('✅ Đã vào đúng trang purchaseDevice');
                await new Promise(r => setTimeout(r, 1000));
                return true;
            }
            await new Promise(r => setTimeout(r, 500));
        }
        console.error('❌ Không chuyển được sang purchaseDevice');
        return false;
    }

    // Loop mỗi 2s để tìm nút Hong Kong
    async function waitForHongKong() {
        console.log('⏳ Đợi nút Hong Kong xuất hiện (kiểm tra mỗi 2s)...');
        while (true) {
            const items = document.querySelectorAll('.room-item');
            let hkItem = null;
            for (let item of items) {
                if (item.innerText.includes('Hong Kong')) {
                    hkItem = item;
                    break;
                }
            }
            if (hkItem) {
                if (!hkItem.classList.contains('active-btn')) {
                    console.log('✅ Tìm thấy Hong Kong (chưa active)');
                    return { element: hkItem, needClick: true };
                } else {
                    console.log('✅ Hong Kong đã active, không cần click');
                    return { element: hkItem, needClick: false };
                }
            }
            await new Promise(r => setTimeout(r, 2000));
        }
    }

    // Chờ nút Get xuất hiện (kiểm tra mỗi 2s)
    async function waitForGetButton() {
        console.log('⏳ Đợi nút Get xuất hiện (kiểm tra mỗi 2s)...');
        while (true) {
            const getBtn = await waitForElement({ text: 'Get', tag: 'span', contains: false, timeout: 0 }); // timeout 0 nghĩa là không giới hạn trong lần gọi này, nhưng trong vòng lặp sẽ tự retry
            if (getBtn) {
                console.log('✅ Tìm thấy nút Get');
                return getBtn;
            }
            await new Promise(r => setTimeout(r, 2000));
        }
    }

    async function run() {
        // 0. Đảm bảo đang ở dashboard
        await ensureDashboardPage();

        // 1. Chờ và click Get (lặp mỗi 2s cho đến khi xuất hiện)
        const getButton = await waitForGetButton();
        if (getButton.disabled || getButton.classList?.contains('van-button--disabled')) {
            console.log('⚠️ Nút Get đang bị disabled, vẫn thử click');
        }
        getButton.click();
        console.log('✅ Click Get');

        // 2. Đợi trang purchaseDevice load
        const isOnPurchasePage = await waitForPurchaseDevicePage();
        if (!isOnPurchasePage) {
            console.error('❌ Không thể vào trang purchaseDevice, dừng script');
            return;
        }

        // 3. Xử lý Hong Kong
        const { element: hkEl, needClick } = await waitForHongKong();
        if (needClick) {
            hkEl.click();
            console.log('✅ Đã click Hong Kong');
        }

        // 4. Click UVIP card
        await safeClick({ selector: '#active-card', timeout: 10000 });

        // 5. Click Buy
        const buyClicked = await safeClick({ selector: '#buy-btn:not(.van-button--disabled):not(.van-button--loading)', timeout: 15000 });
        if (!buyClicked) {
            console.error('❌ Không thể click Buy, dừng lại');
            return;
        }
        console.log('Đã click Buy, chờ màn thanh toán...');

        // 6. Chờ #pay-free-sel
        const payFree = await waitForElement({ selector: '#pay-free-sel', timeout: 20000 });
        if (payFree && payFree.innerText.includes('Use 250Diamond Payment')) {
            console.log('✅ #pay-free-sel đã xuất hiện với text đúng');
            await safeClick({ text: 'Pay', tag: 'button', timeout: 10000 });
            console.log('💰 Đã thanh toán!');
        } else {
            console.error('❌ Không tìm thấy #pay-free-sel hoặc text sai, không click Pay');
        }

        console.log('🏁 Kết thúc.');
    }

    run();
})();